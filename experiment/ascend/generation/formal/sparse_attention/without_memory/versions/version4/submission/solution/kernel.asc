// Supplied-index sparse MLA prefill for Ascend 910B3 -- AscendC cube + vector (MIX).
// Q[8192,128,576] bf16, KV[8192,1,576] bf16 (first 512 = V), indices[8192,1,2048] int32.
// Outputs: O[8192,128,512] bf16, max_logits[8192,128] f32, lse[8192,128] f32.
// Q*K^T and P*K run on the cube; gather and softmax run on the vector unit.
// The cube tiling is produced at compile time by GetMatmulApiTiling (static tiling).
#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include <acl/acl.h>
#include <cstdint>

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "adv_api/matmul/constant_tiling.h"

namespace sa {

using namespace AscendC;

constexpr int32_t TOKENS = 8192;
constexpr int32_t HEADS  = 128;
constexpr int32_t QKDIM  = 576;
constexpr int32_t VW     = 512;
constexpr int32_t TOPK   = 2048;
constexpr int32_t GRID   = 20;
constexpr float   SCALE  = 0.1352337788608801f;

constexpr int32_t  BM = 128;
constexpr int32_t  BN = 128;
constexpr int32_t  BK = 64;
constexpr int32_t  CHUNK = 16;
constexpr uint32_t SYS_WS = 64u << 20;

typedef MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, false> A_T;
typedef MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, true>  BT_T;
typedef MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, false> B_T;
typedef MatmulType<TPosition::GM, CubeFormat::ND, float>             F_T;
typedef MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>        BF_T;

__aicore__ constexpr MatmulConfig mk_cfg(int32_t m, int32_t n, int32_t k)
{
    MatmulConfig c = GetNormalConfig();
    c.singleCoreM = m;
    c.singleCoreN = n;
    c.singleCoreK = k;
    c.basicM = BM;
    c.basicN = BN;
    c.basicK = BK;
    return c;
}

constexpr MatmulConfig CFG1 = mk_cfg(HEADS, TOPK, QKDIM);
constexpr MatmulConfig CFG2 = mk_cfg(HEADS, QKDIM, TOPK);

constexpr MatmulApiStaticTiling ST1 = GetMatmulApiTiling<A_T, BT_T, F_T, F_T>(CFG1);
constexpr MatmulApiStaticTiling ST2 = GetMatmulApiTiling<A_T, B_T, BF_T, F_T>(CFG2);

__aicore__ inline int32_t nz(int32_t v, int32_t d)
{
    return (v == -1) ? d : v;
}

// Mirror the static tiling into a runtime TCubeTiling: the Matmul reads any
// field the static tiling leaves at -1 from this fallback object.
__aicore__ inline void fill_tiling(TCubeTiling &t, const MatmulApiStaticTiling &s)
{
    t.usedCoreNum = nz(s.usedCoreNum, 1);
    t.M  = nz(s.M, 1);
    t.N  = nz(s.N, 1);
    t.Ka = nz(s.Ka, 1);
    t.Kb = nz(s.Kb, 1);
    t.singleCoreM = nz(s.singleCoreM, BM);
    t.singleCoreN = nz(s.singleCoreN, BN);
    t.singleCoreK = nz(s.singleCoreK, BK);
    t.baseM = nz(s.baseM, BM);
    t.baseN = nz(s.baseN, BN);
    t.baseK = nz(s.baseK, BK);
    t.depthA1 = nz(s.depthA1, 4);
    t.depthB1 = nz(s.depthB1, 4);
    t.stepM = nz(s.stepM, 1);
    t.stepN = nz(s.stepN, 1);
    t.isBias = nz(s.isBias, 0);
    t.transLength = nz(s.transLength, 0);
    t.iterateOrder = nz(s.iterateOrder, 0);
    t.shareMode = nz(s.shareMode, 0);
    t.shareL1Size = nz(s.shareL1Size, 0);
    t.shareL0CSize = nz(s.shareL0CSize, 0);
    t.shareUbSize = nz(s.shareUbSize, 0);
    t.batchM = 1;
    t.batchN = 1;
    t.singleBatchM = 1;
    t.singleBatchN = 1;
    t.stepKa = nz(s.stepKa, 2);
    t.stepKb = nz(s.stepKb, 2);
    t.depthAL1CacheUB = 0;
    t.depthBL1CacheUB = 0;
    t.dbL0A = nz(s.dbL0A, 2);
    t.dbL0B = nz(s.dbL0B, 2);
    t.dbL0C = nz(s.dbL0C, 1);
    t.ALayoutInfoB = 0; t.ALayoutInfoS = 0; t.ALayoutInfoN = 0;
    t.ALayoutInfoG = 0; t.ALayoutInfoD = 0;
    t.BLayoutInfoB = 0; t.BLayoutInfoS = 0; t.BLayoutInfoN = 0;
    t.BLayoutInfoG = 0; t.BLayoutInfoD = 0;
    t.CLayoutInfoB = 0; t.CLayoutInfoS1 = 0; t.CLayoutInfoN = 0;
    t.CLayoutInfoG = 0; t.CLayoutInfoS2 = 0;
    t.BatchNum = 1;
    t.mxTypePara = 0;
}

constexpr uint32_t KB_BYTES  = (uint32_t)(TOPK * QKDIM) * 2u;
constexpr uint32_t SC_BYTES  = (uint32_t)(HEADS * TOPK) * 4u;
constexpr uint32_t PB_BYTES  = (uint32_t)(HEADS * TOPK) * 2u;
constexpr uint32_t OB_BYTES  = (uint32_t)(HEADS * QKDIM) * 2u;
constexpr uint32_t BLK_BYTES = KB_BYTES + SC_BYTES + PB_BYTES + OB_BYTES;
constexpr uint64_t WS_TOTAL  = (uint64_t)SYS_WS + (uint64_t)BLK_BYTES * (uint64_t)GRID;

extern "C" __global__ __aicore__ void sa_kernel(
    GM_ADDR q, GM_ADDR kv, GM_ADDR indices, GM_ADDR out,
    GM_ADDR mlog, GM_ADDR lse, GM_ADDR ws)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    SetSysWorkspaceForce(ws);

    int64_t blk  = GetBlockIdx();
    int64_t nblk = GetBlockNum();
    if (nblk <= 0) { nblk = 1; }

    __gm__ uint8_t *base = ws + (uint64_t)SYS_WS + (uint64_t)blk * (uint64_t)BLK_BYTES;
    __gm__ bfloat16_t *kbGm = (__gm__ bfloat16_t *)base;
    __gm__ float      *scGm = (__gm__ float *)(base + KB_BYTES);
    __gm__ bfloat16_t *pGm  = (__gm__ bfloat16_t *)(base + KB_BYTES + SC_BYTES);
    __gm__ bfloat16_t *oGm  = (__gm__ bfloat16_t *)(base + KB_BYTES + SC_BYTES + PB_BYTES);

    TPipe pipe;

    TBuf<TPosition::VECCALC> bIdx, bRows, bZero, bSc, bP, bO, bRed, bWork, bStat, bLL, bT1;
    pipe.InitBuffer(bIdx,  TOPK * 4);
    pipe.InitBuffer(bRows, CHUNK * QKDIM * 2);
    pipe.InitBuffer(bZero, QKDIM * 4);
    pipe.InitBuffer(bSc,   2048 * 4);
    pipe.InitBuffer(bP,    2048 * 2);
    pipe.InitBuffer(bO,    16 * VW * 2);
    pipe.InitBuffer(bRed,  64 * 4);
    pipe.InitBuffer(bWork, 2048 * 4);
    pipe.InitBuffer(bStat, HEADS * 4);
    pipe.InitBuffer(bLL,   HEADS * 4);
    pipe.InitBuffer(bT1,   HEADS * 4);

    Matmul<A_T, BT_T, F_T, F_T, ST1> mm1;
    Matmul<A_T, B_T, BF_T, F_T, ST2> mm2;
    TCubeTiling t1, t2;
    fill_tiling(t1, ST1);
    fill_tiling(t2, ST2);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm1, &t1, mm2, &t2);

    LocalTensor<int32_t>    idxL  = bIdx.Get<int32_t>();
    LocalTensor<bfloat16_t> rowsL = bRows.Get<bfloat16_t>();
    LocalTensor<float>      zeroF = bZero.Get<float>();
    LocalTensor<float>      scL   = bSc.Get<float>();
    LocalTensor<bfloat16_t> pL    = bP.Get<bfloat16_t>();
    LocalTensor<bfloat16_t> oL    = bO.Get<bfloat16_t>();
    LocalTensor<float>      redL  = bRed.Get<float>();
    LocalTensor<float>      workL = bWork.Get<float>();
    LocalTensor<float>      statL = bStat.Get<float>();
    LocalTensor<float>      llL   = bLL.Get<float>();
    LocalTensor<float>      lseL  = bT1.Get<float>();

    GlobalTensor<bfloat16_t> qG, kbG, pG, oG, outG;
    GlobalTensor<float>      scG, mlG, lseG;
    GlobalTensor<int32_t>    idxG;

    qG.SetGlobalBuffer((__gm__ bfloat16_t *)q, (int64_t)TOKENS * HEADS * QKDIM);
    kbG.SetGlobalBuffer(kbGm, (int64_t)TOPK * QKDIM);
    pG.SetGlobalBuffer(pGm, (int64_t)HEADS * TOPK);
    oG.SetGlobalBuffer(oGm, (int64_t)HEADS * QKDIM);
    scG.SetGlobalBuffer(scGm, (int64_t)HEADS * TOPK);
    outG.SetGlobalBuffer((__gm__ bfloat16_t *)out, (int64_t)TOKENS * HEADS * VW);
    mlG.SetGlobalBuffer((__gm__ float *)mlog, (int64_t)TOKENS * HEADS);
    lseG.SetGlobalBuffer((__gm__ float *)lse, (int64_t)TOKENS * HEADS);
    idxG.SetGlobalBuffer((__gm__ int32_t *)indices, (int64_t)TOKENS * TOPK);

    for (int64_t t = blk; t < (int64_t)TOKENS; t += nblk) {
        int32_t nvalid = (t + 1 < (int64_t)TOPK) ? (int32_t)(t + 1) : TOPK;
        int32_t nv16   = (nvalid + 15) & ~15;
        if (nv16 < 16) { nv16 = 16; }

        DataCopy(idxL, idxG[t * TOPK], TOPK);
        PipeBarrier<PIPE_ALL>();

        // ---------------- phase 1: gather key rows into the scratch buffer ----------------
        for (int32_t j0 = 0; j0 < nv16; j0 += CHUNK) {
            int32_t cnt = nv16 - j0;
            if (cnt > CHUNK) { cnt = CHUNK; }
            for (int32_t r = 0; r < cnt; ++r) {
                int32_t j  = j0 + r;
                int32_t id = (j < nvalid) ? idxL.GetValue(j) : -1;
                if (id < 0 || id > (int32_t)TOKENS - 1) { id = 0; }
                GlobalTensor<bfloat16_t> src;
                src.SetGlobalBuffer((__gm__ bfloat16_t *)kv + (int64_t)id * QKDIM, QKDIM);
                DataCopy(rowsL[r * QKDIM], src, QKDIM);
            }
            PipeBarrier<PIPE_ALL>();
            DataCopy(kbG[(int64_t)j0 * QKDIM], rowsL, cnt * QKDIM);
            PipeBarrier<PIPE_ALL>();
        }

        // Zero the rounded tail rows: their probability columns are zero, so
        // they cannot contribute to either matmul.
        if (nv16 > nvalid) {
            Duplicate(zeroF, 0.0f, QKDIM);
            PipeBarrier<PIPE_ALL>();
            Cast(rowsL, zeroF, RoundMode::CAST_RINT, QKDIM);
            PipeBarrier<PIPE_ALL>();
            for (int32_t r = nvalid; r < nv16; ++r) {
                DataCopy(kbG[(int64_t)r * QKDIM], rowsL, QKDIM);
            }
            PipeBarrier<PIPE_ALL>();
        }

        // ---------------- phase 2: scores = Q * K^T (cube) ----------------
        mm1.SetTensorA(qG[t * HEADS * QKDIM]);
        mm1.SetTensorB(kbG);
        mm1.SetSingleShape(HEADS, nv16, QKDIM);
        mm1.IterateAll(scG);

        // ---------------- phase 3: softmax -> probabilities (vector) ----------------
        for (int32_t h = 0; h < HEADS; ++h) {
            DataCopy(scL, scG[(int64_t)h * TOPK], nv16);
            PipeBarrier<PIPE_ALL>();
            ReduceMax(redL, scL, workL, nvalid);
            PipeBarrier<PIPE_ALL>();
            float m = redL.GetValue(0) * SCALE;
            Muls(scL, scL, SCALE, nvalid);
            Adds(scL, scL, -m, nvalid);
            Exp(scL, scL, nvalid);
            ReduceSum(redL[8], scL, workL, nvalid);
            PipeBarrier<PIPE_ALL>();
            float l = redL.GetValue(8);
            Muls(scL, scL, (l > 0.0f) ? (1.0f / l) : 0.0f, nvalid);
            Cast(pL, scL, RoundMode::CAST_RINT, nv16);
            PipeBarrier<PIPE_ALL>();
            DataCopy(pG[(int64_t)h * TOPK], pL, nv16);
            statL.SetValue(h, m);
            llL.SetValue(h, l);
            PipeBarrier<PIPE_ALL>();
        }

        // ---------------- phase 4: O = P * K (cube) ----------------
        mm2.SetTensorA(pG);
        mm2.SetTensorB(kbG);
        mm2.SetSingleShape(HEADS, QKDIM, nv16);
        mm2.IterateAll(oG);

        // ---------------- phase 5: emit bf16 output ----------------
        for (int32_t hb = 0; hb < HEADS / 16; ++hb) {
            DataCopyParams cp;
            cp.blockCount = 16;
            cp.blockLen   = (uint16_t)(VW * 2 / 32);
            cp.srcStride  = (uint16_t)((QKDIM - VW) * 2 / 32);
            cp.dstStride  = 0;
            DataCopy(oL, oG[(int64_t)hb * 16 * QKDIM], cp);
            PipeBarrier<PIPE_ALL>();
            DataCopy(outG[((int64_t)t * HEADS + hb * 16) * VW], oL, 16 * VW);
            PipeBarrier<PIPE_ALL>();
        }

        // ---------------- phase 6: statistics ----------------
        Ln(lseL, llL, HEADS);
        PipeBarrier<PIPE_ALL>();
        Add(lseL, statL, lseL, HEADS);
        PipeBarrier<PIPE_ALL>();
        DataCopy(mlG[t * HEADS], statL, HEADS);
        DataCopy(lseG[t * HEADS], lseL, HEADS);
        PipeBarrier<PIPE_ALL>();
    }

    mm1.End();
    mm2.End();
}

}  // namespace sa

static void sa_forward(torch::Tensor q, torch::Tensor kv, torch::Tensor indices,
                       torch::Tensor out, torch::Tensor mlog, torch::Tensor lse) {
    TORCH_CHECK(q.device().type() == c10::DeviceType::PrivateUse1, "q must be an NPU tensor");
    TORCH_CHECK(q.scalar_type() == torch::kBFloat16, "q must be bf16");
    TORCH_CHECK(kv.scalar_type() == torch::kBFloat16, "kv must be bf16");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(q.is_contiguous() && kv.is_contiguous() && indices.is_contiguous(),
                "inputs must be contiguous");
    TORCH_CHECK(out.is_contiguous() && mlog.is_contiguous() && lse.is_contiguous(),
                "outputs must be contiguous");
    TORCH_CHECK(q.numel() == (int64_t)sa::TOKENS * sa::HEADS * sa::QKDIM, "q shape");
    TORCH_CHECK(kv.numel() == (int64_t)sa::TOKENS * sa::QKDIM, "kv shape");
    TORCH_CHECK(indices.numel() == (int64_t)sa::TOKENS * sa::TOPK, "idx shape");
    TORCH_CHECK(out.numel() == (int64_t)sa::TOKENS * sa::HEADS * sa::VW, "out shape");
    TORCH_CHECK(mlog.numel() == (int64_t)sa::TOKENS * sa::HEADS, "max_logits shape");
    TORCH_CHECK(lse.numel() == (int64_t)sa::TOKENS * sa::HEADS, "lse shape");

    c10::DeviceGuard guard(q.device());
    aclrtStream stream =
        (aclrtStream)c10_npu::getCurrentNPUStream(q.get_device()).stream(true);

    auto opts = torch::TensorOptions().dtype(torch::kUInt8).device(q.device());
    torch::Tensor wsT = torch::zeros({(int64_t)sa::WS_TOTAL}, opts);

    sa::sa_kernel<<<sa::GRID, nullptr, stream>>>(
        (GM_ADDR)q.data_ptr(), (GM_ADDR)kv.data_ptr(), (GM_ADDR)indices.data_ptr(),
        (GM_ADDR)out.data_ptr(), (GM_ADDR)mlog.data_ptr(), (GM_ADDR)lse.data_ptr(),
        (GM_ADDR)wsT.data_ptr());
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &sa_forward);
}
