// Supplied-index sparse MLA prefill for Ascend 910B3 -- AscendC vector implementation.
// Q[8192,128,576] bf16, KV[8192,1,576] bf16 (first 512 = V), indices[8192,1,2048] int32.
// Outputs: O[8192,128,512] bf16, max_logits[8192,128] f32, lse[8192,128] f32.
// All device math is FP32; only O is cast back to BF16.
#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include <acl/acl.h>
#include <cstdint>
#include <vector>

#include "kernel_operator.h"

namespace sa {

constexpr int32_t TOKENS = 8192;
constexpr int32_t HEADS  = 128;
constexpr int32_t QKDIM  = 576;
constexpr int32_t VW     = 512;
constexpr int32_t TOPK   = 2048;
constexpr int32_t GRID   = 40;
constexpr int32_t HB     = 16;                 // heads per QK block
constexpr int32_t NB     = HEADS / HB;         // 8
constexpr int32_t RTP    = 8;                  // keys per score tile
constexpr int32_t RTV    = 16;                 // keys per PV tile
constexpr int32_t HBP    = 16;                 // heads per PV block
constexpr int32_t NVB    = HEADS / HBP;        // 8
constexpr float   SCALE  = 0.1352337788608801f;

constexpr uint32_t WS_SC   = (uint32_t)(HEADS * TOPK) * 4u;
constexpr uint32_t WS_PR   = (uint32_t)(HEADS * TOPK) * 2u;
constexpr uint32_t WS_CORE = WS_SC + WS_PR;
constexpr uint32_t WS_TOTAL = WS_CORE * (uint32_t)GRID;

extern "C" __global__ __aicore__ void sa_kernel(
    GM_ADDR q, GM_ADDR kv, GM_ADDR indices, GM_ADDR out,
    GM_ADDR mlog, GM_ADDR lse, GM_ADDR ws)
{
    using namespace AscendC;
    int64_t blk  = GetBlockIdx();
    int64_t nblk = GetBlockNum();

    TPipe pipe;
    TBuf<TPosition::VECCALC> bIdx, bQB, bQF, bKTB, bKTF, bProd, bRed, bWork;
    TBuf<TPosition::VECCALC> bScT, bRaw, bPB, bStat, bLL, bInv, bVB, bVF;
    TBuf<TPosition::VECCALC> bPt, bPf, bOut, bTV, bTmpS;
    pipe.InitBuffer(bIdx,  TOPK * 4);
    pipe.InitBuffer(bQB,   HB * QKDIM * 2);
    pipe.InitBuffer(bQF,   HB * QKDIM * 4);
    pipe.InitBuffer(bKTB, RTP * QKDIM * 2);
    pipe.InitBuffer(bKTF, RTP * QKDIM * 4);
    pipe.InitBuffer(bProd, QKDIM * 4);
    pipe.InitBuffer(bRed,  RTP * HB * 8 * 4);
    pipe.InitBuffer(bWork, 2048 * 4);
    pipe.InitBuffer(bScT,  HB * RTP * 4);
    pipe.InitBuffer(bRaw,  TOPK * 4);
    pipe.InitBuffer(bPB,   TOPK * 2);
    pipe.InitBuffer(bStat, HEADS * 4);
    pipe.InitBuffer(bLL,   HEADS * 4);
    pipe.InitBuffer(bInv,  HEADS * 4);
    pipe.InitBuffer(bVB,   RTV * VW * 2);
    pipe.InitBuffer(bVF,   VW * 4);
    pipe.InitBuffer(bPt,   HBP * RTV * 2);
    pipe.InitBuffer(bPf,   HBP * RTV * 4);
    pipe.InitBuffer(bOut,  HBP * VW * 4);
    pipe.InitBuffer(bTV,   VW * 4);
    pipe.InitBuffer(bTmpS, 256 * 4);

    LocalTensor<int32_t>    idxL  = bIdx.Get<int32_t>();
    LocalTensor<bfloat16_t> qbL   = bQB.Get<bfloat16_t>();
    LocalTensor<float>      qfL   = bQF.Get<float>();
    LocalTensor<bfloat16_t> ktbL  = bKTB.Get<bfloat16_t>();
    LocalTensor<float>      ktfL  = bKTF.Get<float>();
    LocalTensor<float>      prodL = bProd.Get<float>();
    LocalTensor<float>      redL  = bRed.Get<float>();
    LocalTensor<float>      workL = bWork.Get<float>();
    LocalTensor<float>      scTL  = bScT.Get<float>();
    LocalTensor<float>      rawL  = bRaw.Get<float>();
    LocalTensor<bfloat16_t> pbL   = bPB.Get<bfloat16_t>();
    LocalTensor<float>      statL = bStat.Get<float>();
    LocalTensor<float>      llL   = bLL.Get<float>();
    LocalTensor<float>      invL  = bInv.Get<float>();
    LocalTensor<bfloat16_t> vBL   = bVB.Get<bfloat16_t>();
    LocalTensor<float>      vFL   = bVF.Get<float>();
    LocalTensor<bfloat16_t> ptL   = bPt.Get<bfloat16_t>();
    LocalTensor<float>      pfL   = bPf.Get<float>();
    LocalTensor<float>      outL  = bOut.Get<float>();
    LocalTensor<float>      tvL   = bTV.Get<float>();
    LocalTensor<float>      tpL   = bTmpS.Get<float>();

    __gm__ uint8_t *scBase = ws + (uint64_t)blk * (uint64_t)WS_CORE;
    __gm__ uint8_t *prBase = scBase + WS_SC;

    GlobalTensor<float>      scG, mlG, lseG;
    GlobalTensor<bfloat16_t> pG, outG, qG, kvG;
    GlobalTensor<int32_t>    idxG;
    scG.SetGlobalBuffer((__gm__ float *)scBase, (int64_t)HEADS * TOPK);
    pG.SetGlobalBuffer((__gm__ bfloat16_t *)prBase, (int64_t)HEADS * TOPK);
    kvG.SetGlobalBuffer((__gm__ bfloat16_t *)kv, (int64_t)TOKENS * QKDIM);

    for (int64_t t = blk; t < (int64_t)TOKENS; t += nblk) {
        int32_t nvalid = (t + 1 < (int64_t)TOPK) ? (int32_t)(t + 1) : TOPK;
        int32_t nvrd   = (nvalid + 15) & ~15;
        if (nvrd < 16) { nvrd = 16; }

        idxG.SetGlobalBuffer((__gm__ int32_t *)indices + t * TOPK, TOPK);
        DataCopy(idxL, idxG, TOPK);
        PipeBarrier<PIPE_ALL>();

        // ---------------- phase 1: QK^T scores into scratch (batched tiles) ----------------
        for (int32_t hb = 0; hb < NB; ++hb) {
            qG.SetGlobalBuffer((__gm__ bfloat16_t *)q +
                               (t * HEADS + hb * HB) * QKDIM, (int64_t)HB * QKDIM);
            DataCopy(qbL, qG, HB * QKDIM);
            PipeBarrier<PIPE_ALL>();
            Cast(qfL, qbL, RoundMode::CAST_NONE, HB * QKDIM);
            PipeBarrier<PIPE_ALL>();

            int32_t nt = (nvalid + RTP - 1) / RTP;
            for (int32_t jt = 0; jt < nt; ++jt) {
                int32_t j0 = jt * RTP;
                for (int32_t r = 0; r < RTP; ++r) {
                    int32_t j = j0 + r;
                    if (j >= nvalid) { continue; }
                    int32_t id = idxL.GetValue(j);
                    if (id < 0) { continue; }
                    GlobalTensor<bfloat16_t> ksrc;
                    ksrc.SetGlobalBuffer((__gm__ bfloat16_t *)kv + (int64_t)id * QKDIM, QKDIM);
                    DataCopy(ktbL[r * QKDIM], ksrc, QKDIM);
                }
                PipeBarrier<PIPE_ALL>();
                Cast(ktfL, ktbL, RoundMode::CAST_NONE, RTP * QKDIM);
                for (int32_t r = 0; r < RTP; ++r) {
                    for (int32_t h = 0; h < HB; ++h) {
                        Mul(prodL, qfL[h * QKDIM], ktfL[r * QKDIM], QKDIM);
                        ReduceSum(redL[(r * HB + h) * 8], prodL, workL, QKDIM);
                    }
                }
                PipeBarrier<PIPE_ALL>();
                for (int32_t r = 0; r < RTP; ++r) {
                    for (int32_t h = 0; h < HB; ++h) {
                        scTL.SetValue(h * RTP + r, redL.GetValue((r * HB + h) * 8));
                    }
                }
                PipeBarrier<PIPE_ALL>();
                DataCopyParams cp;
                cp.blockCount = (uint16_t)HB;
                cp.blockLen   = (uint16_t)(RTP * 4 / 32);
                cp.srcStride  = 0;
                cp.dstStride  = (uint16_t)((TOPK * 4 - RTP * 4) / 32);
                DataCopy(scG[(int64_t)hb * HB * TOPK + j0], scTL, cp);
                PipeBarrier<PIPE_ALL>();
            }
        }

        // ---------------- phase 2: softmax per head, probabilities to scratch ----------------
        for (int32_t h = 0; h < HEADS; ++h) {
            DataCopy(rawL, scG[(int64_t)h * TOPK], nvrd);
            PipeBarrier<PIPE_ALL>();
            ReduceMax(redL, rawL, workL, nvalid);
            PipeBarrier<PIPE_ALL>();
            float m = redL.GetValue(0) * SCALE;
            Muls(rawL, rawL, SCALE, nvalid);
            Adds(rawL, rawL, -m, nvalid);
            Exp(rawL, rawL, nvalid);
            ReduceSum(redL[8], rawL, workL, nvalid);
            PipeBarrier<PIPE_ALL>();
            float l = redL.GetValue(8);
            statL.SetValue(h, m);
            llL.SetValue(h, l);
            invL.SetValue(h, (l > 0.0f) ? (1.0f / l) : 0.0f);
            Cast(pbL, rawL, RoundMode::CAST_RINT, nvrd);
            PipeBarrier<PIPE_ALL>();
            DataCopy(pG[(int64_t)h * TOPK], pbL, nvrd);
            PipeBarrier<PIPE_ALL>();
        }

        // ---------------- phase 3: probabilities x values ----------------
        for (int32_t hb = 0; hb < NVB; ++hb) {
            Duplicate(outL, 0.0f, HBP * VW);
            PipeBarrier<PIPE_ALL>();
            int32_t nt = (nvalid + RTV - 1) / RTV;
            for (int32_t jt = 0; jt < nt; ++jt) {
                int32_t j0 = jt * RTV;
                for (int32_t r = 0; r < RTV; ++r) {
                    int32_t j = j0 + r;
                    if (j >= nvalid) { continue; }
                    int32_t id = idxL.GetValue(j);
                    if (id < 0) { continue; }
                    GlobalTensor<bfloat16_t> vsrc;
                    vsrc.SetGlobalBuffer((__gm__ bfloat16_t *)kv + (int64_t)id * QKDIM, VW);
                    DataCopy(vBL[r * VW], vsrc, VW);
                }
                for (int32_t h = 0; h < HBP; ++h) {
                    DataCopy(ptL[h * RTV], pG[((int64_t)hb * HBP + h) * TOPK + j0], RTV);
                }
                PipeBarrier<PIPE_ALL>();
                Cast(pfL, ptL, RoundMode::CAST_NONE, HBP * RTV);
                PipeBarrier<PIPE_ALL>();
                for (int32_t r = 0; r < RTV; ++r) {
                    if (j0 + r >= nvalid) { continue; }
                    Cast(vFL, vBL[r * VW], RoundMode::CAST_NONE, VW);
                    for (int32_t h = 0; h < HBP; ++h) {
                        float pv = pfL.GetValue(h * RTV + r);
                        Axpy(outL[h * VW], vFL, pv, VW);
                    }
                }
            }
            PipeBarrier<PIPE_ALL>();
            for (int32_t h = 0; h < HBP; ++h) {
                float iv = invL.GetValue(hb * HBP + h);
                Muls(tvL, outL[h * VW], iv, VW);
                PipeBarrier<PIPE_ALL>();
                Cast(pbL, tvL, RoundMode::CAST_RINT, VW);
                PipeBarrier<PIPE_ALL>();
                outG.SetGlobalBuffer((__gm__ bfloat16_t *)out +
                                     ((int64_t)t * HEADS + hb * HBP + h) * VW, VW);
                DataCopy(outG, pbL, VW);
            }
            PipeBarrier<PIPE_ALL>();
        }

        // ---------------- phase 4: statistics ----------------
        Ln(tpL, llL, HEADS);
        Add(tpL, statL, tpL, HEADS);
        PipeBarrier<PIPE_ALL>();
        mlG.SetGlobalBuffer((__gm__ float *)mlog + t * HEADS, HEADS);
        lseG.SetGlobalBuffer((__gm__ float *)lse + t * HEADS, HEADS);
        DataCopy(mlG, statL, HEADS);
        DataCopy(lseG, tpL, HEADS);
        PipeBarrier<PIPE_ALL>();
    }
}

}  // namespace sa

static void sa_forward(torch::Tensor q, torch::Tensor kv, torch::Tensor indices,
                       torch::Tensor out, torch::Tensor mlog, torch::Tensor lse) {
    TORCH_CHECK(q.device().type() == c10::DeviceType::PrivateUse1, "q must be an NPU tensor");
    TORCH_CHECK(q.scalar_type() == torch::kBFloat16, "q must be bf16");
    TORCH_CHECK(kv.scalar_type() == torch::kBFloat16, "kv must be bf16");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(q.is_contiguous() && kv.is_contiguous() && indices.is_contiguous(),
                "inputs must be contiguous");
    TORCH_CHECK(out.is_contiguous() && mlog.is_contiguous() && lse.is_contiguous(),
                "outputs must be contiguous");
    TORCH_CHECK(q.numel() == (int64_t)sa::TOKENS * sa::HEADS * sa::QKDIM, "q shape");
    TORCH_CHECK(kv.numel() == (int64_t)sa::TOKENS * sa::QKDIM, "kv shape");
    TORCH_CHECK(indices.numel() == (int64_t)sa::TOKENS * sa::TOPK, "idx shape");
    TORCH_CHECK(out.numel() == (int64_t)sa::TOKENS * sa::HEADS * sa::VW, "out shape");
    TORCH_CHECK(mlog.numel() == (int64_t)sa::TOKENS * sa::HEADS, "max_logits shape");
    TORCH_CHECK(lse.numel() == (int64_t)sa::TOKENS * sa::HEADS, "lse shape");

    c10::DeviceGuard guard(q.device());
    aclrtStream stream =
        (aclrtStream)c10_npu::getCurrentNPUStream(q.get_device()).stream(true);

    auto opts = torch::TensorOptions().dtype(torch::kUInt8).device(q.device());
    torch::Tensor wsT = torch::empty({(int64_t)sa::WS_TOTAL}, opts);

    sa::sa_kernel<<<sa::GRID, nullptr, stream>>>(
        (GM_ADDR)q.data_ptr(), (GM_ADDR)kv.data_ptr(), (GM_ADDR)indices.data_ptr(),
        (GM_ADDR)out.data_ptr(), (GM_ADDR)mlog.data_ptr(), (GM_ADDR)lse.data_ptr(),
        (GM_ADDR)wsT.data_ptr());
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &sa_forward);
}
