// Supplied-index sparse MLA prefill for Ascend 910B3.
// Staged Cube implementation: AIV gather -> AIC QK^T -> AIV FP32 softmax -> AIC PV.
// Q[8192,128,576] bf16, KV[8192,1,576] bf16 (first 512 = V), indices[8192,1,2048] int32.
// Validity is value based: a slot is valid iff 0 <= idx < 8192 (the reference masks the rest).
// Outputs: O[8192,128,512] bf16, max_logits[8192,128] f32, lse[8192,128] f32.
#define ASCENDC_CUBE_ONLY
#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include <acl/acl.h>
#include <cstdint>
#include "kernel_operator.h"
#include "adv_api/matmul_intf.h"

using namespace AscendC;

namespace sa {

constexpr int32_t TOKENS = 8192;
constexpr int32_t HEADS  = 128;
constexpr int32_t QKDIM  = 576;
constexpr int32_t VW     = 512;
constexpr int32_t TOPK   = 2048;
constexpr float   SCALE  = 0.1352337788608801f;
constexpr float   MASKNEG = -1.0e6f;

constexpr int32_t CHUNK  = 512;              // tokens per staged chunk
constexpr int32_t NCHUNK = TOKENS / CHUNK;
constexpr int32_t BASE_M = 128;
constexpr int32_t BASE_N = 128;
constexpr int32_t BASE_K = 64;

constexpr int64_t WSK_ELEMS = (int64_t)CHUNK * TOPK * QKDIM;   // bf16
constexpr int64_t WSS_ELEMS = (int64_t)CHUNK * HEADS * TOPK;   // f32
constexpr int64_t WSP_ELEMS = (int64_t)CHUNK * HEADS * TOPK;   // bf16
constexpr int64_t WSM_ELEMS = (int64_t)CHUNK * TOPK;           // f32 additive mask
constexpr int64_t WSK_BYTES = WSK_ELEMS * 2;
constexpr int64_t WSS_BYTES = WSS_ELEMS * 4;
constexpr int64_t WSP_BYTES = WSP_ELEMS * 2;
constexpr int64_t WSM_BYTES = WSM_ELEMS * 4;
// Every stage is double buffered so chunk c+2 is prepared while chunk c is
// still being consumed.
constexpr int64_t WS_BYTES  = 2 * (WSK_BYTES + WSS_BYTES + WSP_BYTES + WSM_BYTES);
constexpr int64_t WS_SS     = 2 * WSK_BYTES;
constexpr int64_t WS_PP     = WS_SS + 2 * WSS_BYTES;
constexpr int64_t WS_MM     = WS_PP + 2 * WSP_BYTES;

// ---------------------------------------------------------------------------
// Stage 1: gather selected KV rows + validity mask for one token per block (AIV)
// ---------------------------------------------------------------------------
constexpr int32_t GR = 128;  // KV rows staged per UB batch

extern "C" __global__ __aicore__ void sa_gather(GM_ADDR kv, GM_ADDR indices,
                                                GM_ADDR wsK, GM_ADDR wsM, int32_t tokenBase)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> bIdx, bK, bM;
    pipe.InitBuffer(bIdx, TOPK * 4);
    pipe.InitBuffer(bK, GR * QKDIM * 2);
    pipe.InitBuffer(bM, TOPK * 4);
    LocalTensor<int32_t>    idxL = bIdx.Get<int32_t>();
    LocalTensor<bfloat16_t> kL   = bK.Get<bfloat16_t>();
    LocalTensor<float>      mL   = bM.Get<float>();

    int32_t slot = (int32_t)GetBlockIdx();
    int32_t t = tokenBase + slot;

    GlobalTensor<int32_t> idxG;
    idxG.SetGlobalBuffer((__gm__ int32_t *)indices + (int64_t)t * TOPK, TOPK);
    DataCopy(idxL, idxG, TOPK);
    PipeBarrier<PIPE_ALL>();

    GlobalTensor<bfloat16_t> kvG;
    kvG.SetGlobalBuffer((__gm__ bfloat16_t *)kv, (int64_t)TOKENS * QKDIM);
    GlobalTensor<bfloat16_t> dstK;
    dstK.SetGlobalBuffer((__gm__ bfloat16_t *)wsK + (int64_t)slot * TOPK * QKDIM,
                         (int64_t)TOPK * QKDIM);
    GlobalTensor<float> dstM;
    dstM.SetGlobalBuffer((__gm__ float *)wsM + (int64_t)slot * TOPK, TOPK);

    for (int32_t j0 = 0; j0 < TOPK; j0 += GR) {
        for (int32_t r = 0; r < GR; ++r) {
            int32_t id = idxL.GetValue(j0 + r);
            bool ok = (id >= 0 && id < TOKENS);
            mL.SetValue(j0 + r, ok ? 0.0f : MASKNEG);
            int32_t row = ok ? id : 0;
            DataCopy(kL[r * QKDIM], kvG[(int64_t)row * QKDIM], QKDIM);
        }
        PipeBarrier<PIPE_ALL>();
        for (int32_t r = 0; r < GR; ++r) {
            DataCopy(dstK[(int64_t)(j0 + r) * QKDIM], kL[r * QKDIM], QKDIM);
        }
        PipeBarrier<PIPE_ALL>();
    }
    PipeBarrier<PIPE_ALL>();
    DataCopy(dstM, mL, TOPK);
}

// ---------------------------------------------------------------------------
// Stage 2: scores S = Q_t * K_t^T  (AIC), one token per block
// ---------------------------------------------------------------------------
extern "C" __global__ __aicore__ void sa_qk(GM_ADDR q, GM_ADDR wsK, GM_ADDR wsS,
                                            int32_t tokenBase)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    AscendC::tiling::TCubeTiling t{};
    t.usedCoreNum = 1;
    t.M = HEADS; t.N = TOPK; t.Ka = QKDIM; t.Kb = QKDIM;
    t.singleCoreM = HEADS; t.singleCoreN = TOPK; t.singleCoreK = QKDIM;
    t.baseM = BASE_M; t.baseN = BASE_N; t.baseK = BASE_K;
    t.depthA1 = 2; t.depthB1 = 2; t.stepM = 1; t.stepN = 1;
    t.stepKa = 1; t.stepKb = 1;
    t.dbL0A = 2; t.dbL0B = 2; t.dbL0C = 2;
    t.isBias = 0; t.transLength = 0;

    using A = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, true>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, float>;
    Matmul<A, B, C, C> mm;
    mm.Init(&t, &pipe);

    int32_t slot = (int32_t)GetBlockIdx();
    int32_t tok  = tokenBase + slot;

    GlobalTensor<bfloat16_t> qG, kG;
    qG.SetGlobalBuffer((__gm__ bfloat16_t *)q + (int64_t)tok * HEADS * QKDIM,
                       (int64_t)HEADS * QKDIM);
    kG.SetGlobalBuffer((__gm__ bfloat16_t *)wsK + (int64_t)slot * TOPK * QKDIM,
                       (int64_t)TOPK * QKDIM);
    GlobalTensor<float> sG;
    sG.SetGlobalBuffer((__gm__ float *)wsS + (int64_t)slot * HEADS * TOPK,
                       (int64_t)HEADS * TOPK);

    mm.SetOrgShape(HEADS, TOPK, QKDIM, QKDIM);
    mm.SetTensorA(qG);
    mm.SetTensorB(kG, true);
    mm.IterateAll(sG);
    mm.End();
}

// ---------------------------------------------------------------------------
// Stage 3: FP32 row softmax -> bf16 probabilities, max_logits, lse (AIV)
// ---------------------------------------------------------------------------
constexpr int32_t ROWW = TOPK;

extern "C" __global__ __aicore__ void sa_softmax(GM_ADDR wsS, GM_ADDR wsP, GM_ADDR wsM,
                                                 GM_ADDR mlog, GM_ADDR lse, int32_t tokenBase)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TQue<TPosition::VECIN, 2> qIn;
    TBuf<TPosition::VECCALC> bP, bWork, bRed, bM, bL, bMask;
    pipe.InitBuffer(qIn, 2, ROWW * 4);
    pipe.InitBuffer(bP, ROWW * 2);
    pipe.InitBuffer(bWork, ROWW * 8);
    pipe.InitBuffer(bRed, 64 * 4);
    pipe.InitBuffer(bM, HEADS * 4);
    pipe.InitBuffer(bL, HEADS * 4);
    pipe.InitBuffer(bMask, ROWW * 4);
    LocalTensor<bfloat16_t> pL    = bP.Get<bfloat16_t>();
    LocalTensor<float>      workL = bWork.Get<float>();
    LocalTensor<float>      redL  = bRed.Get<float>();
    LocalTensor<float>      mL    = bM.Get<float>();
    LocalTensor<float>      lL    = bL.Get<float>();
    LocalTensor<float>      maskL = bMask.Get<float>();

    int32_t slot = (int32_t)GetBlockIdx();
    int32_t t = tokenBase + slot;

    GlobalTensor<float> sG, mskG;
    sG.SetGlobalBuffer((__gm__ float *)wsS + (int64_t)slot * HEADS * TOPK,
                       (int64_t)HEADS * TOPK);
    mskG.SetGlobalBuffer((__gm__ float *)wsM + (int64_t)slot * TOPK, TOPK);
    GlobalTensor<bfloat16_t> pG;
    pG.SetGlobalBuffer((__gm__ bfloat16_t *)wsP + (int64_t)slot * HEADS * TOPK,
                       (int64_t)HEADS * TOPK);

    DataCopy(maskL, mskG, TOPK);
    PipeBarrier<PIPE_ALL>();

    {
        LocalTensor<float> pre = qIn.AllocTensor<float>();
        DataCopy(pre, sG[0], ROWW);
        qIn.EnQue(pre);
    }
    for (int32_t h = 0; h < HEADS; ++h) {
        LocalTensor<float> r = qIn.DeQue<float>();
        if (h + 1 < HEADS) {
            LocalTensor<float> nxt = qIn.AllocTensor<float>();
            DataCopy(nxt, sG[(int64_t)(h + 1) * ROWW], ROWW);
            qIn.EnQue(nxt);
        }

        Add(r, r, maskL, ROWW);
        PipeBarrier<PIPE_V>();
        ReduceMax(redL, r, workL, ROWW, false);
        PipeBarrier<PIPE_ALL>();
        float m = redL.GetValue(0) * SCALE;

        Muls(r, r, SCALE, ROWW);
        PipeBarrier<PIPE_V>();
        Adds(r, r, -m, ROWW);
        PipeBarrier<PIPE_V>();
        Exp(r, r, ROWW);
        PipeBarrier<PIPE_V>();
        ReduceSum(redL, r, workL, ROWW);
        PipeBarrier<PIPE_ALL>();
        float l = redL.GetValue(0);
        float inv = (l > 0.0f) ? (1.0f / l) : 0.0f;
        Muls(r, r, inv, ROWW);
        PipeBarrier<PIPE_V>();
        Cast(pL, r, RoundMode::CAST_RINT, ROWW);
        PipeBarrier<PIPE_ALL>();
        DataCopy(pG[(int64_t)h * ROWW], pL, ROWW);
        qIn.FreeTensor(r);
        mL.SetValue(h, m);
        lL.SetValue(h, l);
    }
    PipeBarrier<PIPE_ALL>();
    Ln(lL, lL, HEADS);
    PipeBarrier<PIPE_V>();
    Add(lL, lL, mL, HEADS);
    PipeBarrier<PIPE_ALL>();
    GlobalTensor<float> mG, lG;
    mG.SetGlobalBuffer((__gm__ float *)mlog + (int64_t)t * HEADS, HEADS);
    lG.SetGlobalBuffer((__gm__ float *)lse + (int64_t)t * HEADS, HEADS);
    DataCopy(mG, mL, HEADS);
    DataCopy(lG, lL, HEADS);
}

// ---------------------------------------------------------------------------
// Stage 4: O = P * V  (AIC), one token per block
// ---------------------------------------------------------------------------
extern "C" __global__ __aicore__ void sa_pv(GM_ADDR wsP, GM_ADDR wsK, GM_ADDR out,
                                            int32_t tokenBase)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    AscendC::tiling::TCubeTiling t{};
    t.usedCoreNum = 1;
    t.M = HEADS; t.N = VW; t.Ka = TOPK; t.Kb = TOPK;
    t.singleCoreM = HEADS; t.singleCoreN = VW; t.singleCoreK = TOPK;
    t.baseM = BASE_M; t.baseN = BASE_N; t.baseK = BASE_K;
    t.depthA1 = 2; t.depthB1 = 2; t.stepM = 1; t.stepN = 1;
    t.stepKa = 1; t.stepKb = 1;
    t.dbL0A = 2; t.dbL0B = 2; t.dbL0C = 2;
    t.isBias = 0; t.transLength = 0;

    using A = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
    Matmul<A, B, C, C> mm;
    mm.Init(&t, &pipe);

    int32_t slot = (int32_t)GetBlockIdx();
    int32_t tok  = tokenBase + slot;

    GlobalTensor<bfloat16_t> pG, vG, oG;
    pG.SetGlobalBuffer((__gm__ bfloat16_t *)wsP + (int64_t)slot * HEADS * TOPK,
                       (int64_t)HEADS * TOPK);
    vG.SetGlobalBuffer((__gm__ bfloat16_t *)wsK + (int64_t)slot * TOPK * QKDIM,
                       (int64_t)TOPK * QKDIM);
    oG.SetGlobalBuffer((__gm__ bfloat16_t *)out + (int64_t)tok * HEADS * VW,
                       (int64_t)HEADS * VW);

    // B keeps the gathered 576-wide pitch; C keeps the 512-wide output pitch.
    mm.SetOrgShape(HEADS, QKDIM, TOPK, TOPK, VW);
    mm.SetTensorA(pG);
    mm.SetTensorB(vG);
    mm.IterateAll(oG);
    mm.End();
}

}  // namespace sa

namespace {

struct SideStream {
    bool ready = false;
    aclrtStream qk = nullptr;   // QK^T cube stream
    aclrtStream pv = nullptr;   // PV cube stream
    aclrtEvent evG[sa::NCHUNK];
    aclrtEvent evQ[sa::NCHUNK];
    aclrtEvent evS[sa::NCHUNK];
    aclrtEvent evP[sa::NCHUNK];
};

SideStream &side_stream() {
    static SideStream side;
    if (!side.ready) {
        aclrtCreateStream(&side.qk);
        aclrtCreateStream(&side.pv);
        for (int32_t i = 0; i < sa::NCHUNK; ++i) {
            aclrtCreateEvent(&side.evG[i]);
            aclrtCreateEvent(&side.evQ[i]);
            aclrtCreateEvent(&side.evS[i]);
            aclrtCreateEvent(&side.evP[i]);
        }
        side.ready = true;
    }
    return side;
}

inline GM_ADDR buf_at(uint8_t *wp, int64_t base, int64_t span, int32_t c) {
    return (GM_ADDR)(wp + base + (int64_t)(c & 1) * span);
}

}  // namespace

static void sa_forward(torch::Tensor q, torch::Tensor kv, torch::Tensor indices,
                       torch::Tensor out, torch::Tensor mlog, torch::Tensor lse) {
    TORCH_CHECK(q.device().type() == c10::DeviceType::PrivateUse1, "q must be an NPU tensor");
    TORCH_CHECK(q.scalar_type() == torch::kBFloat16, "q must be bf16");
    TORCH_CHECK(kv.scalar_type() == torch::kBFloat16, "kv must be bf16");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(q.is_contiguous() && kv.is_contiguous() && indices.is_contiguous(),
                "inputs must be contiguous");
    TORCH_CHECK(out.is_contiguous() && mlog.is_contiguous() && lse.is_contiguous(),
                "outputs must be contiguous");
    TORCH_CHECK(q.numel() == (int64_t)sa::TOKENS * sa::HEADS * sa::QKDIM, "q shape");
    TORCH_CHECK(kv.numel() == (int64_t)sa::TOKENS * sa::QKDIM, "kv shape");
    TORCH_CHECK(indices.numel() == (int64_t)sa::TOKENS * sa::TOPK, "idx shape");
    TORCH_CHECK(out.numel() == (int64_t)sa::TOKENS * sa::HEADS * sa::VW, "out shape");
    TORCH_CHECK(mlog.numel() == (int64_t)sa::TOKENS * sa::HEADS, "max_logits shape");
    TORCH_CHECK(lse.numel() == (int64_t)sa::TOKENS * sa::HEADS, "lse shape");

    c10::DeviceGuard guard(q.device());
    aclrtStream stream = (aclrtStream)c10_npu::getCurrentNPUStream(q.get_device()).stream(true);

    auto opts = torch::TensorOptions().dtype(torch::kUInt8).device(q.device());
    torch::Tensor ws = torch::empty({sa::WS_BYTES}, opts);
    uint8_t *wp = (uint8_t *)ws.data_ptr();
    GM_ADDR wsK = (GM_ADDR)wp;
    GM_ADDR wsS = (GM_ADDR)(wp + sa::WS_SS);
    GM_ADDR wsP = (GM_ADDR)(wp + sa::WS_PP);
    GM_ADDR wsM = (GM_ADDR)(wp + sa::WS_MM);

    GM_ADDR qp = (GM_ADDR)q.data_ptr();
    GM_ADDR kp = (GM_ADDR)kv.data_ptr();
    GM_ADDR ip = (GM_ADDR)indices.data_ptr();
    GM_ADDR op = (GM_ADDR)out.data_ptr();
    GM_ADDR mp = (GM_ADDR)mlog.data_ptr();
    GM_ADDR lp = (GM_ADDR)lse.data_ptr();

    // Cube (QK, PV) runs on a private stream so the vector stages of the next
    // chunk overlap the cube stages of the current one; every cross-stream edge
    // is an explicit event and the caller's stream waits on the last PV.
    SideStream &side = side_stream();
    for (int32_t c = 0; c < 2 && c < sa::NCHUNK; ++c) {
        sa::sa_gather<<<sa::CHUNK, nullptr, stream>>>(
            kp, ip, buf_at(wp, 0, sa::WSK_BYTES, c), buf_at(wp, sa::WS_MM, sa::WSM_BYTES, c),
            c * sa::CHUNK);
        aclrtRecordEvent(side.evG[c], stream);
    }
    for (int32_t c = 0; c < sa::NCHUNK; ++c) {
        int32_t base = c * sa::CHUNK;
        GM_ADDR wsKc = buf_at(wp, 0, sa::WSK_BYTES, c);
        GM_ADDR wsSc = buf_at(wp, sa::WS_SS, sa::WSS_BYTES, c);
        GM_ADDR wsPc = buf_at(wp, sa::WS_PP, sa::WSP_BYTES, c);
        GM_ADDR wsMc = buf_at(wp, sa::WS_MM, sa::WSM_BYTES, c);

        // QK: waits for its gather; its score staging was released by softmax(c-2).
        if (c >= 2) {
            aclrtStreamWaitEvent(side.qk, side.evS[c - 2]);
        }
        aclrtStreamWaitEvent(side.qk, side.evG[c]);
        sa::sa_qk<<<sa::CHUNK, nullptr, side.qk>>>(qp, wsKc, wsSc, base);
        aclrtRecordEvent(side.evQ[c], side.qk);

        // Softmax: probabilities staging released by PV(c-2).
        if (c >= 2) {
            aclrtStreamWaitEvent(stream, side.evP[c - 2]);
        }
        aclrtStreamWaitEvent(stream, side.evQ[c]);
        sa::sa_softmax<<<sa::CHUNK, nullptr, stream>>>(wsSc, wsPc, wsMc, mp, lp, base);
        aclrtRecordEvent(side.evS[c], stream);

        // PV on its own cube stream so it never blocks QK(c+1).
        aclrtStreamWaitEvent(side.pv, side.evS[c]);
        sa::sa_pv<<<sa::CHUNK, nullptr, side.pv>>>(wsPc, wsKc, op, base);
        aclrtRecordEvent(side.evP[c], side.pv);

        // Stage the gather for c+2: its K staging is released by QK(c) and PV(c).
        int32_t nxt = c + 2;
        if (nxt < sa::NCHUNK) {
            aclrtStreamWaitEvent(stream, side.evQ[c]);
            aclrtStreamWaitEvent(stream, side.evP[c]);
            sa::sa_gather<<<sa::CHUNK, nullptr, stream>>>(
                kp, ip, buf_at(wp, 0, sa::WSK_BYTES, nxt),
                buf_at(wp, sa::WS_MM, sa::WSM_BYTES, nxt), nxt * sa::CHUNK);
            aclrtRecordEvent(side.evG[nxt], stream);
        }
    }
    aclrtStreamWaitEvent(stream, side.evP[sa::NCHUNK - 1]);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &sa_forward);
}
