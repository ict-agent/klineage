// Fused residual-add + RMSNorm (Ascend910B3, CANN 9.1, AscendC).
//
//   summed       = hidden + residual                       (fp32 accumulate)
//   residual_out = bf16(summed)
//   output       = bf16(summed * rsqrt(mean(summed^2) + eps) * weight)
//
// Each vector core owns a contiguous run of rows. One row is fully staged in UB
// so the inputs are read from GM once and both outputs written once; the tile
// schedule issues the next row's loads before the current row is computed.

#include <torch/extension.h>

#include <acl/acl.h>
#include <c10/core/DeviceGuard.h>

#include <cstdint>

#include "kernel_operator.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"

using namespace AscendC;

namespace klineage {

using InputType = bfloat16_t;

constexpr int32_t kInDepth = 3;
constexpr int32_t kOutDepth = 2;
constexpr int32_t kAccDepth = 1;
constexpr int32_t kScanLanes = 64;
// Sum of squares is accumulated in chunks; the freed UB funds deeper
// output queues so neither store stalls the next row's vector work.
constexpr int32_t kChunkElems = 1792;
constexpr uint32_t kMaxCols = 8192;
constexpr float kEpsilon = 1e-6f;

__aicore__ inline uint32_t SplitStart(uint32_t total, uint32_t shards, uint32_t index, uint32_t* count)
{
    const uint32_t base = total / shards;
    const uint32_t rest = total % shards;
    *count = base + (index < rest ? 1u : 0u);
    return index * base + (index < rest ? index : rest);
}

class FusedAddRmsNorm {
public:
    __aicore__ inline FusedAddRmsNorm() {}

    __aicore__ inline void Init(GM_ADDR hidden, GM_ADDR residual, GM_ADDR weight, GM_ADDR output,
                                GM_ADDR residualOut, uint32_t rows, uint32_t cols, float epsilon)
    {
        this->cols = cols;
        this->invCols = 1.0f / static_cast<float>(static_cast<int32_t>(cols));
        this->epsilon = epsilon;
        this->rowCount = 0;
        this->rowStart = 0;

        const uint32_t blocks = GetBlockNum();
        if (blocks != 0 && rows != 0) {
            this->rowStart = SplitStart(rows, blocks, GetBlockIdx(), &this->rowCount);
        }

        // Streaming reads are never reused: keep them out of L2 so the dirty
        // output lines stay resident until the memory controller drains them.
        wGm.SetGlobalBuffer((__gm__ InputType*)weight, cols);
        if (this->rowCount > 0) {
            const uint64_t offset = static_cast<uint64_t>(this->rowStart) * cols;
            const uint64_t span = static_cast<uint64_t>(this->rowCount) * cols;
            xGm.SetGlobalBuffer((__gm__ InputType*)hidden + offset, span);
            rGm.SetGlobalBuffer((__gm__ InputType*)residual + offset, span);
            yGm.SetL2CacheHint<CacheRwMode::WRITE>(CacheMode::CACHE_MODE_DISABLE);
            zGm.SetL2CacheHint<CacheRwMode::WRITE>(CacheMode::CACHE_MODE_DISABLE);
            yGm.SetGlobalBuffer((__gm__ InputType*)output + offset, span);
            zGm.SetGlobalBuffer((__gm__ InputType*)residualOut + offset, span);
        }

        pipe.InitBuffer(inX, kInDepth, cols * sizeof(InputType));
        pipe.InitBuffer(inR, kInDepth, cols * sizeof(InputType));
        pipe.InitBuffer(outY, kOutDepth, cols * sizeof(InputType));
        pipe.InitBuffer(outZ, kAccDepth, cols * sizeof(InputType));
        pipe.InitBuffer(bufSum, cols * sizeof(float));
        pipe.InitBuffer(bufSq, kChunkElems * sizeof(float));
        pipe.InitBuffer(bufW, cols * sizeof(float));
        pipe.InitBuffer(bufTmp, 2 * kScanLanes * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if (this->rowCount == 0) {
            return;
        }
        LoadWeight();
        CopyIn(0);
        if (this->rowCount > 1) {
            CopyIn(1);
        }
        for (uint32_t row = 0; row < this->rowCount; ++row) {
            if (row + 2 < this->rowCount) {
                CopyIn(row + 2);
            }
            Compute(row);
            CopyOut(row);
        }
    }

private:
    __aicore__ inline void LoadWeight()
    {
        LocalTensor<InputType> staging = inX.AllocTensor<InputType>();
        DataCopy(staging, wGm, this->cols);
        inX.EnQue(staging);
        LocalTensor<InputType> weightIn = inX.DeQue<InputType>();
        LocalTensor<float> weightFp32 = bufW.Get<float>();
        Cast(weightFp32, weightIn, RoundMode::CAST_NONE, this->cols);
        inX.FreeTensor(weightIn);
    }

    __aicore__ inline void CopyIn(uint32_t row)
    {
        const uint64_t offset = static_cast<uint64_t>(row) * this->cols;
        LocalTensor<InputType> xLocal = inX.AllocTensor<InputType>();
        LocalTensor<InputType> rLocal = inR.AllocTensor<InputType>();
        DataCopy(xLocal, xGm[offset], this->cols);
        DataCopy(rLocal, rGm[offset], this->cols);
        inX.EnQue(xLocal);
        inR.EnQue(rLocal);
    }

    __aicore__ inline void Compute(uint32_t row)
    {
        LocalTensor<InputType> xLocal = inX.DeQue<InputType>();
        LocalTensor<InputType> rLocal = inR.DeQue<InputType>();
        LocalTensor<float> summed = bufSum.Get<float>();
        LocalTensor<float> chunk = bufSq.Get<float>();
        LocalTensor<float> partial = bufTmp.Get<float>();
        LocalTensor<float> scan = bufTmp.Get<float>()[kScanLanes];

        BinaryRepeatParams accumulate;
        accumulate.dstBlkStride = 1;
        accumulate.dstRepStride = 0;
        accumulate.src0BlkStride = 1;
        accumulate.src0RepStride = ONE_REPEAT_BYTE_SIZE / ONE_BLK_SIZE;
        accumulate.src1BlkStride = 1;
        accumulate.src1RepStride = 0;

        Duplicate(partial, 0.0f, kScanLanes);
        uint32_t offset = 0;
        for (; offset + kChunkElems <= this->cols; offset += kChunkElems) {
            Cast(chunk, xLocal[offset], RoundMode::CAST_NONE, kChunkElems);
            Cast(summed[offset], rLocal[offset], RoundMode::CAST_NONE, kChunkElems);
            Add(summed[offset], summed[offset], chunk, kChunkElems);
            Mul(chunk, summed[offset], summed[offset], kChunkElems);
            Add(partial, chunk, partial, kScanLanes, kChunkElems / kScanLanes, accumulate);
        }
        if (offset < this->cols) {
            const uint32_t tail = this->cols - offset;
            Cast(chunk, xLocal[offset], RoundMode::CAST_NONE, tail);
            Cast(summed[offset], rLocal[offset], RoundMode::CAST_NONE, tail);
            Add(summed[offset], summed[offset], chunk, tail);
            Mul(chunk, summed[offset], summed[offset], tail);
            Add(partial, chunk, partial, tail, 1, accumulate);
        }

        LocalTensor<InputType> residualLocal = outZ.AllocTensor<InputType>();
        Cast(residualLocal, summed, RoundMode::CAST_RINT, this->cols);
        outZ.EnQue(residualLocal);
        inX.FreeTensor(xLocal);
        inR.FreeTensor(rLocal);

        ReduceSum<float>(scan, partial, partial, kScanLanes);
        Muls(scan, scan, this->invCols, 1);
        Adds(scan, scan, this->epsilon, 1);
        Rsqrt(scan, scan, 1);

        const event_t eventVS = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(eventVS);
        WaitFlag<HardEvent::V_S>(eventVS);
        const float rstd = scan.GetValue(0);

        LocalTensor<float> weightFp32 = bufW.Get<float>();
        Muls(summed, summed, rstd, this->cols);
        Mul(summed, summed, weightFp32, this->cols);

        LocalTensor<InputType> yLocal = outY.AllocTensor<InputType>();
        Cast(yLocal, summed, RoundMode::CAST_RINT, this->cols);
        outY.EnQue(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t row)
    {
        const uint64_t offset = static_cast<uint64_t>(row) * this->cols;
        LocalTensor<InputType> residualLocal = outZ.DeQue<InputType>();
        DataCopy(zGm[offset], residualLocal, this->cols);
        outZ.FreeTensor(residualLocal);

        LocalTensor<InputType> yLocal = outY.DeQue<InputType>();
        DataCopy(yGm[offset], yLocal, this->cols);
        outY.FreeTensor(yLocal);
    }

    TPipe pipe;
    TQue<TPosition::VECIN, kInDepth> inX;
    TQue<TPosition::VECIN, kInDepth> inR;
    TQue<TPosition::VECOUT, kOutDepth> outY;
    TQue<TPosition::VECOUT, kAccDepth> outZ;
    TBuf<TPosition::VECCALC> bufSum;
    TBuf<TPosition::VECCALC> bufSq;
    TBuf<TPosition::VECCALC> bufW;
    TBuf<TPosition::VECCALC> bufTmp;
    GlobalTensor<InputType> xGm;
    GlobalTensor<InputType> rGm;
    GlobalTensor<InputType> wGm;
    GlobalTensor<InputType> yGm;
    GlobalTensor<InputType> zGm;
    uint32_t cols = 0;
    uint32_t rowStart = 0;
    uint32_t rowCount = 0;
    float invCols = 1.0f;
    float epsilon = kEpsilon;
};

__global__ __vector__ void fused_add_rmsnorm_launch(GM_ADDR hidden, GM_ADDR residual, GM_ADDR weight,
                                                    GM_ADDR output, GM_ADDR residualOut, uint32_t rows,
                                                    uint32_t cols, float epsilon)
{
    FusedAddRmsNorm op;
    op.Init(hidden, residual, weight, output, residualOut, rows, cols, epsilon);
    op.Process();
}

uint32_t VectorCoreCount()
{
    static uint32_t cached = 0;
    if (cached == 0) {
        int64_t value = 0;
        if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &value) == ACL_SUCCESS && value > 0) {
            cached = static_cast<uint32_t>(value);
        } else {
            cached = 40;
        }
    }
    return cached;
}

void CheckOperand(const torch::Tensor& tensor, const char* name)
{
    TORCH_CHECK(tensor.defined(), name, " must be defined");
    TORCH_CHECK(tensor.device().type() == c10::DeviceType::PrivateUse1, name, " must be an NPU tensor");
    TORCH_CHECK(tensor.scalar_type() == at::kBFloat16, name, " must be bfloat16");
    TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
}

void kernel(const torch::Tensor& hidden, const torch::Tensor& residual, const torch::Tensor& weight,
            const torch::Tensor& output, const torch::Tensor& residual_out)
{
    CheckOperand(hidden, "hidden_states");
    CheckOperand(residual, "residual");
    CheckOperand(weight, "weight");
    CheckOperand(output, "output");
    CheckOperand(residual_out, "residual_out");

    TORCH_CHECK(hidden.dim() == 2, "hidden_states must be 2-D");
    TORCH_CHECK(weight.dim() == 1, "weight must be 1-D");
    const int64_t rows = hidden.size(0);
    const int64_t cols = hidden.size(1);
    TORCH_CHECK(rows > 0, "tokens must be positive");
    TORCH_CHECK(cols > 0 && cols <= static_cast<int64_t>(kMaxCols) && cols % 32 == 0,
                "hidden size must be a positive multiple of 32 up to ", kMaxCols);
    TORCH_CHECK(residual.sizes() == hidden.sizes(), "residual shape mismatch");
    TORCH_CHECK(output.sizes() == hidden.sizes(), "output shape mismatch");
    TORCH_CHECK(residual_out.sizes() == hidden.sizes(), "residual_out shape mismatch");
    TORCH_CHECK(weight.size(0) == cols, "weight shape mismatch");
    TORCH_CHECK(residual.device() == hidden.device() && weight.device() == hidden.device() &&
                    output.device() == hidden.device() && residual_out.device() == hidden.device(),
                "all tensors must share one NPU device");

    const c10::DeviceGuard guard(hidden.device());
    aclrtStream stream = c10_npu::getCurrentNPUStream(hidden.get_device()).stream(true);

    uint32_t blockDim = VectorCoreCount();
    if (static_cast<uint64_t>(blockDim) > static_cast<uint64_t>(rows)) {
        blockDim = static_cast<uint32_t>(rows);
    }

    fused_add_rmsnorm_launch<<<blockDim, nullptr, stream>>>(
        reinterpret_cast<uint8_t*>(hidden.data_ptr()), reinterpret_cast<uint8_t*>(residual.data_ptr()),
        reinterpret_cast<uint8_t*>(weight.data_ptr()), reinterpret_cast<uint8_t*>(output.data_ptr()),
        reinterpret_cast<uint8_t*>(residual_out.data_ptr()), static_cast<uint32_t>(rows),
        static_cast<uint32_t>(cols), kEpsilon);
}

}  // namespace klineage

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module)
{
    module.def("kernel", &klineage::kernel);
}
