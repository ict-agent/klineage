// Fused residual-add + RMSNorm (DeepSeek-V3.2 style decoder boundary).
//
//   s   = fp32(hidden_states) + fp32(residual)
//   res = bf16(s)
//   out = bf16(s * (1/sqrt(mean(s^2) + eps)) * fp32(weight))
//
// Each block owns a contiguous range of rows.  The two bf16 inputs are staged
// through a double-buffered pair of UB slots, so the MTE2 transfer of row i+1
// runs while the vector pipe normalises row i; every buffer hand-off, including
// the write-after-read fences (V->MTE2, MTE3->V, S->V), is an explicit
// SetFlag/WaitFlag pair.  The row is kept in fp32 in UB, so the normalisation
// pass never re-reads global memory, and the sum of squares is accumulated per
// 1024 element tile and reduced with a power-of-two pairwise tree whose 32 wide
// tail is finished on the scalar unit (no sub-32B vector operation anywhere).

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <acl/acl.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr uint32_t kHidden = 7168;
constexpr uint32_t kTile = 1024;
constexpr uint32_t kNTile = kHidden / kTile;   // 7 tiles per row
constexpr uint32_t kSmall = 32;                // reduction tail read on the S unit
constexpr uint32_t kScaleVec = 8;              // one 32B fp32 vector block
constexpr uint32_t kBlocks = 40;
constexpr float kEps = 1e-6f;
constexpr float kInvHidden = 1.0f / static_cast<float>(kHidden);

constexpr event_t kEvIn0 = EVENT_ID0;      // V    -> MTE2 : staging slot 0 free
constexpr event_t kEvIn1 = EVENT_ID1;      // V    -> MTE2 : staging slot 1 free
constexpr event_t kEvLand0 = EVENT_ID0;    // MTE2 -> V    : slot 0 landed
constexpr event_t kEvLand1 = EVENT_ID1;    // MTE2 -> V    : slot 1 landed
constexpr event_t kEvWeight = EVENT_ID2;   // MTE2 -> V    : weight tiled landed
constexpr event_t kEvResReady = EVENT_ID0; // V    -> MTE3 : residual_out ready
constexpr event_t kEvOutReady = EVENT_ID1; // V    -> MTE3 : output ready
constexpr event_t kEvResFree = EVENT_ID0;  // MTE3 -> V    : residual_out copied
constexpr event_t kEvOutFree = EVENT_ID1;  // MTE3 -> V    : output copied
constexpr event_t kEvScale = EVENT_ID1;    // V    -> S    : partial sums visible
constexpr event_t kEvScalar = EVENT_ID2;   // S    -> V    : partial sums consumed
constexpr event_t kEvScalar2 = EVENT_ID3;  // S    -> V    : scale register ready

class FusedAddRmsNorm {
public:
    __aicore__ inline FusedAddRmsNorm() {}

    __aicore__ inline void Init(GM_ADDR hidden, GM_ADDR residual, GM_ADDR weight, GM_ADDR output,
                                GM_ADDR residual_out, uint32_t tokens, uint32_t blocks)
    {
        tokens_ = tokens;
        blocks_ = blocks;
        hiddenG_.SetGlobalBuffer((__gm__ bfloat16_t *)hidden, static_cast<uint64_t>(tokens) * kHidden);
        residualG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual, static_cast<uint64_t>(tokens) * kHidden);
        weightG_.SetGlobalBuffer((__gm__ bfloat16_t *)weight, kHidden);
        outputG_.SetGlobalBuffer((__gm__ bfloat16_t *)output, static_cast<uint64_t>(tokens) * kHidden);
        residualOutG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual_out,
                                      static_cast<uint64_t>(tokens) * kHidden);

        pipe_.InitBuffer(hBuf_, 2 * kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(rBuf_, 2 * kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(xBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(wBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(sqBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(accBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(yBuf_, 2 * kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(redBuf_, kScaleVec * sizeof(float));

        hT_ = hBuf_.Get<bfloat16_t>();
        rT_ = rBuf_.Get<bfloat16_t>();
        xF_ = xBuf_.Get<float>();
        wF_ = wBuf_.Get<float>();
        sq_ = sqBuf_.Get<float>();
        acc_ = accBuf_.Get<float>();
        yT_ = yBuf_.Get<bfloat16_t>();
        yOut_ = yT_[kHidden];
        red_ = redBuf_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        if (tokens_ == 0) {
            return;
        }
        const uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        const uint32_t rowsPerBlock = (tokens_ + blocks_ - 1) / blocks_;
        const uint32_t start = blockIdx * rowsPerBlock;
        if (start >= tokens_) {
            return;
        }
        uint32_t end = start + rowsPerBlock;
        if (end > tokens_) {
            end = tokens_;
        }
        LoadWeight();
        const uint32_t rows = end - start;
        SetFlag<HardEvent::V_MTE2>(kEvIn0);
        SetFlag<HardEvent::V_MTE2>(kEvIn1);
        SetFlag<HardEvent::MTE3_V>(kEvResFree);
        SetFlag<HardEvent::MTE3_V>(kEvOutFree);
        if (rows > 0) {
            LoadRow(start, 0);  // prologue: fill slot 0
            for (uint32_t i = 0; i < rows; ++i) {
                const uint32_t slot = i & 1u;
                if (i + 1 < rows) {
                    LoadRow(start + i + 1, slot ^ 1u);
                }
                ComputeRow(start + i, slot);
            }
        }
        WaitFlag<HardEvent::V_MTE2>(kEvIn0);
        WaitFlag<HardEvent::V_MTE2>(kEvIn1);
    }

private:
    __aicore__ inline void LoadWeight()
    {
        // hT_ slot 0 doubles as the bf16 staging for the weight row.
        DataCopy(hT_, weightG_[0], kHidden);
        SetFlag<HardEvent::MTE2_V>(kEvWeight);
        WaitFlag<HardEvent::MTE2_V>(kEvWeight);
        Cast(wF_, hT_, RoundMode::CAST_NONE, kHidden);
    }

    __aicore__ inline void LoadRow(uint32_t row, uint32_t slot)
    {
        const event_t ev_in = slot == 0 ? kEvIn0 : kEvIn1;
        const event_t ev_land = slot == 0 ? kEvLand0 : kEvLand1;
        const uint64_t base = static_cast<uint64_t>(row) * kHidden;
        WaitFlag<HardEvent::V_MTE2>(ev_in);
        DataCopy(hT_[slot * kHidden], hiddenG_[base], kHidden);
        DataCopy(rT_[slot * kHidden], residualG_[base], kHidden);
        SetFlag<HardEvent::MTE2_V>(ev_land);
    }

    // The store itself never stalls the vector pipe: the owning slot is only
    // reclaimed by the matching WaitFlag at the top of the next row.
    __aicore__ inline void StoreBf16(const GlobalTensor<bfloat16_t>& dst, uint64_t base,
                                     LocalTensor<bfloat16_t>& src, event_t ready, event_t free_ev)
    {
        SetFlag<HardEvent::V_MTE3>(ready);
        WaitFlag<HardEvent::V_MTE3>(ready);
        DataCopy(dst[base], src, kHidden);
        SetFlag<HardEvent::MTE3_V>(free_ev);
    }

    __aicore__ inline void ComputeRow(uint32_t row, uint32_t slot)
    {
        const event_t ev_in = slot == 0 ? kEvIn0 : kEvIn1;
        const event_t ev_land = slot == 0 ? kEvLand0 : kEvLand1;
        const uint64_t base = static_cast<uint64_t>(row) * kHidden;

        WaitFlag<HardEvent::MTE3_V>(kEvResFree);  // previous row's y slots retired
        WaitFlag<HardEvent::MTE3_V>(kEvOutFree);
        WaitFlag<HardEvent::MTE2_V>(ev_land);
        Cast(xF_, hT_[slot * kHidden], RoundMode::CAST_NONE, kHidden);
        Cast(sq_, rT_[slot * kHidden], RoundMode::CAST_NONE, kHidden);
        Add(xF_, xF_, sq_, kHidden);
        SetFlag<HardEvent::V_MTE2>(ev_in);  // staging slot consumed

        Cast(yT_, xF_, RoundMode::CAST_RINT, kHidden);
        StoreBf16(residualOutG_, base, yT_, kEvResReady, kEvResFree);

        // Sum of squares: exact pairwise tree over the 1024 element tile.
        Duplicate(acc_, 0.0f, kTile);
        for (uint32_t t = 0; t < kNTile; ++t) {
            Mul(sq_, xF_[t * kTile], xF_[t * kTile], kTile);
            Add(acc_, acc_, sq_, kTile);
        }
        for (uint32_t span = kTile >> 1; span >= kSmall; span >>= 1) {
            Add(acc_, acc_, acc_[span], span);
        }
        SetFlag<HardEvent::V_S>(kEvScale);
        WaitFlag<HardEvent::V_S>(kEvScale);
        float total = 0.0f;
        for (uint32_t i = 0; i < kSmall; ++i) {
            total += acc_.GetValue(i);
        }
        SetFlag<HardEvent::S_V>(kEvScalar);
        WaitFlag<HardEvent::S_V>(kEvScalar);

        Duplicate(red_, total * kInvHidden + kEps, kScaleVec);
        Sqrt(red_, red_, kScaleVec);
        Reciprocal(red_, red_, kScaleVec);
        SetFlag<HardEvent::V_S>(kEvScale);
        WaitFlag<HardEvent::V_S>(kEvScale);
        const float scale = red_.GetValue(0);
        SetFlag<HardEvent::S_V>(kEvScalar2);
        WaitFlag<HardEvent::S_V>(kEvScalar2);

        Muls(xF_, xF_, scale, kHidden);
        Mul(xF_, xF_, wF_, kHidden);
        Cast(yOut_, xF_, RoundMode::CAST_RINT, kHidden);
        StoreBf16(outputG_, base, yOut_, kEvOutReady, kEvOutFree);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> hBuf_;
    TBuf<TPosition::VECCALC> rBuf_;
    TBuf<TPosition::VECCALC> xBuf_;
    TBuf<TPosition::VECCALC> wBuf_;
    TBuf<TPosition::VECCALC> sqBuf_;
    TBuf<TPosition::VECCALC> accBuf_;
    TBuf<TPosition::VECCALC> yBuf_;
    TBuf<TPosition::VECCALC> redBuf_;

    GlobalTensor<bfloat16_t> hiddenG_;
    GlobalTensor<bfloat16_t> residualG_;
    GlobalTensor<bfloat16_t> weightG_;
    GlobalTensor<bfloat16_t> outputG_;
    GlobalTensor<bfloat16_t> residualOutG_;

    LocalTensor<bfloat16_t> hT_;
    LocalTensor<bfloat16_t> rT_;
    LocalTensor<float> xF_;
    LocalTensor<float> wF_;
    LocalTensor<float> sq_;
    LocalTensor<float> acc_;
    LocalTensor<bfloat16_t> yT_;
    LocalTensor<bfloat16_t> yOut_;
    LocalTensor<float> red_;

    uint32_t tokens_ = 0;
    uint32_t blocks_ = 1;
};

}  // namespace

extern "C" __global__ __aicore__ void fused_add_rmsnorm_kernel(GM_ADDR hidden, GM_ADDR residual,
                                                              GM_ADDR weight, GM_ADDR output,
                                                              GM_ADDR residual_out, uint32_t tokens,
                                                              uint32_t blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    FusedAddRmsNorm op;
    op.Init(hidden, residual, weight, output, residual_out, tokens, blocks);
    op.Process();
}

void kernel(torch::Tensor hidden, torch::Tensor residual, torch::Tensor weight, torch::Tensor output,
            torch::Tensor residual_out)
{
    TORCH_CHECK(hidden.device().type() == c10::DeviceType::PrivateUse1,
                "fused_add_rmsnorm expects NPU tensors");
    const c10::DeviceGuard guard(hidden.device());
    const uint32_t tokens = static_cast<uint32_t>(hidden.size(0));
    if (tokens == 0) {
        return;
    }
    aclrtStream stream = c10_npu::getCurrentNPUStream(hidden.get_device()).stream(true);
    uint32_t blocks = kBlocks;
    if (blocks > tokens) {
        blocks = tokens;
    }
    fused_add_rmsnorm_kernel<<<blocks, nullptr, stream>>>(
        (GM_ADDR)hidden.data_ptr(), (GM_ADDR)residual.data_ptr(), (GM_ADDR)weight.data_ptr(),
        (GM_ADDR)output.data_ptr(), (GM_ADDR)residual_out.data_ptr(), tokens, blocks);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &kernel);
}
