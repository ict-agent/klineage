// Sparse MLA prefill (supplied-index sparse attention) for Ascend 910B3.
//
//   q        : [TOKENS, HEADS, KDIM]      bf16
//   kv       : [TOKENS, 1, KDIM]          bf16  (first VDIM elements are values)
//   indices  : [TOKENS, 1, TOPK]          int32 (-1 padding)
//   output   : [TOKENS, HEADS, VDIM]      bf16
//   max_logits, lse : [TOKENS, HEADS]     fp32
//
// One device block (1 AIC + 1 AIV in MIX mode) owns a strided set of tokens.
// Per token the selected key rows are gathered into a per-block staging tile in
// global memory, S = Q * K^T is produced by the Cube, row max / exp / bf16
// probability matrix by the Vector unit, and O = P * KV by the Cube again.
// All cube work is issued from the AIV side through the KFC client that
// REGIST_MATMUL_OBJ installs; the AIC only runs the KFC server loop.

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;

namespace sa {

constexpr int32_t TOKENS = 8192;
constexpr int32_t HEADS = 128;
constexpr int32_t KDIM = 576;
constexpr int32_t VDIM = 512;
constexpr int32_t TOPK = 2048;
constexpr float SCALE = 0.1352337788608801f;
constexpr float NEG = -1.0e30f;
constexpr int32_t NCORE = 20;
constexpr int32_t NT = 64;              // keys per softmax tile
constexpr int32_t TILES = TOPK / NT;    // 32
constexpr int32_t NR5 = 8;              // output rows per vector chunk
constexpr int32_t ICH = 128;            // indices per gather chunk
constexpr int32_t NB = 32;              // key rows per gather batch (ICH/NB even)

// Event ids.  Re-used across the disjoint gather / softmax / output phases.
constexpr TEventID EV_A = (TEventID)0;
constexpr TEventID EV_B = (TEventID)1;
constexpr TEventID EV_C = (TEventID)2;
constexpr TEventID EV_D = (TEventID)3;
constexpr TEventID EV_E = (TEventID)4;
constexpr TEventID EV_F = (TEventID)5;
constexpr TEventID EV_G = (TEventID)6;

using A1T = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
using B1T = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, true>;
using C1T = MatmulType<TPosition::GM, CubeFormat::ND, float>;
using BST = MatmulType<TPosition::GM, CubeFormat::ND, float>;

constexpr MatmulShapeParams SP1{HEADS, TOPK, KDIM, 128, 128, 64};
constexpr MatmulConfig CFG1 = GetMMConfig<MatmulConfigMode::CONFIG_NORM>(SP1);
constexpr auto TIL1 = GetMatmulApiTiling<A1T, B1T, C1T, BST>(CFG1, 524288);

using A2T = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
using B2T = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
using C2T = MatmulType<TPosition::GM, CubeFormat::ND, float>;
constexpr MatmulShapeParams SP2{HEADS, KDIM, TOPK, 128, 64, 64};
constexpr MatmulConfig CFG2 = GetMMConfig<MatmulConfigMode::CONFIG_NORM>(SP2);
constexpr auto TIL2 = GetMatmulApiTiling<A2T, B2T, C2T, BST>(CFG2, 524288);

class SparseMla {
public:
    __aicore__ inline SparseMla() {}

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR kv, GM_ADDR idx, GM_ADDR out, GM_ADDR mx,
                                GM_ADDR lse, GM_ADDR wk, GM_ADDR sbuf, GM_ADDR pbuf, GM_ADDR obuf,
                                GM_ADDR pen, GM_ADDR stt, GM_ADDR sysws)
    {
        qGm.SetGlobalBuffer((__gm__ bfloat16_t *)q);
        kvGm.SetGlobalBuffer((__gm__ bfloat16_t *)kv);
        idxGm.SetGlobalBuffer((__gm__ int32_t *)idx);
        outGm.SetGlobalBuffer((__gm__ bfloat16_t *)out);
        mxGm.SetGlobalBuffer((__gm__ float *)mx);
        lseGm.SetGlobalBuffer((__gm__ float *)lse);
        SetSysWorkspace(sysws);

        coreId = (int32_t)GetBlockIdx();
        nCore = (int32_t)GetBlockNum();

        wkGm.SetGlobalBuffer((__gm__ bfloat16_t *)wk + (int64_t)coreId * TOPK * KDIM);
        sGm.SetGlobalBuffer((__gm__ float *)sbuf + (int64_t)coreId * HEADS * TOPK);
        pGm.SetGlobalBuffer((__gm__ bfloat16_t *)pbuf + (int64_t)coreId * HEADS * TOPK);
        oGm.SetGlobalBuffer((__gm__ float *)obuf + (int64_t)coreId * HEADS * KDIM);
        penGm.SetGlobalBuffer((__gm__ float *)pen + (int64_t)coreId * TOPK);
        invGm.SetGlobalBuffer((__gm__ float *)stt + (int64_t)coreId * HEADS);

        REGIST_MATMUL_OBJ(&pipe, sysws, mm1, mm2);

        pipe.InitBuffer(gathBuf, 2 * NB * KDIM * (int32_t)sizeof(bfloat16_t));
        pipe.InitBuffer(idxBuf, ICH * (int32_t)sizeof(int32_t));
        pipe.InitBuffer(penBuf, TOPK * (int32_t)sizeof(float));
        pipe.InitBuffer(sBuf, HEADS * NT * (int32_t)sizeof(float));
        pipe.InitBuffer(pBuf, HEADS * NT * (int32_t)sizeof(bfloat16_t));
        pipe.InitBuffer(rBuf, 4 * HEADS * (int32_t)sizeof(float));
        pipe.InitBuffer(oBuf, NR5 * VDIM * (int32_t)sizeof(float));
        pipe.InitBuffer(obBuf, NR5 * VDIM * (int32_t)sizeof(bfloat16_t));
        pipe.InitBuffer(ivBuf, 2 * HEADS * (int32_t)sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIV {
            for (int32_t t = coreId; t < TOKENS; t += nCore) {
                Gather(t);
                Qk(t);
                Softmax(t);
                Pv(t);
                WriteOut(t);
            }
        }
    }

private:
    // ---------------------------------------------------------------- gather
    __aicore__ inline void MakePen(LocalTensor<int32_t> &idxT, LocalTensor<float> &penT)
    {
        Cast(penT, idxT, RoundMode::CAST_NONE, ICH);
        Mins(penT, penT, 0.0f, ICH);
        Muls(penT, penT, -1.0e30f, ICH);
    }

    __aicore__ inline void Gather(int32_t t)
    {
        LocalTensor<bfloat16_t> stg = gathBuf.Get<bfloat16_t>();
        LocalTensor<int32_t> idxT = idxBuf.Get<int32_t>();
        LocalTensor<float> penT = penBuf.Get<float>();

        for (int32_t c = 0; c < TOPK; c += ICH) {
            DataCopy(idxT, idxGm[(int64_t)t * TOPK + c], ICH);
            SetFlag<HardEvent::MTE2_S>(EV_E);
            WaitFlag<HardEvent::MTE2_S>(EV_E);
            SetFlag<HardEvent::S_V>(EV_F);
            WaitFlag<HardEvent::S_V>(EV_F);
            MakePen(idxT, penT);
            SetFlag<HardEvent::V_MTE3>(EV_G);
            WaitFlag<HardEvent::V_MTE3>(EV_G);
            DataCopy(penGm[(int64_t)c], penT, ICH);
            SetFlag<HardEvent::MTE3_V>(EV_F);
            WaitFlag<HardEvent::MTE3_V>(EV_F);

            for (int32_t b = 0; b < ICH; b += NB) {
                int32_t bi = (b / NB) & 1;
                if (b >= 2 * NB) {
                    WaitFlag<HardEvent::MTE3_MTE2>(bi == 0 ? EV_C : EV_D);
                }
                for (int32_t i = 0; i < NB; ++i) {
                    int32_t r = idxT.GetValue(b + i);
                    if (r < 0 || r >= TOKENS) {
                        r = 0;
                    }
                    DataCopy(stg[bi * NB * KDIM + i * KDIM], kvGm[(int64_t)r * KDIM], KDIM);
                }
                SetFlag<HardEvent::MTE2_MTE3>(bi == 0 ? EV_A : EV_B);
                WaitFlag<HardEvent::MTE2_MTE3>(bi == 0 ? EV_A : EV_B);
                for (int32_t i = 0; i < NB; ++i) {
                    DataCopy(wkGm[(int64_t)(c + b + i) * KDIM], stg[bi * NB * KDIM + i * KDIM], KDIM);
                }
                SetFlag<HardEvent::MTE3_MTE2>(bi == 0 ? EV_C : EV_D);
            }
            WaitFlag<HardEvent::MTE3_MTE2>(EV_C);
            WaitFlag<HardEvent::MTE3_MTE2>(EV_D);
        }
    }

    // -------------------------------------------------------------------- QK
    __aicore__ inline void Qk(int32_t t)
    {
        mm1.SetTensorA(qGm[(int64_t)t * HEADS * KDIM]);
        mm1.SetTensorB(wkGm);
        mm1.IterateAll(sGm);
    }

    __aicore__ inline void Add2(LocalTensor<float> &sT, LocalTensor<float> &penT)
    {
        Add(sT, sT, penT, (int32_t)NT, (uint8_t)HEADS,
            {1, 1, 1, (uint8_t)(NT / 8), (uint8_t)(NT / 8), 0});
    }

    // --------------------------------------------------------------- softmax
    __aicore__ inline void Softmax(int32_t t)
    {
        LocalTensor<float> sT = sBuf.Get<float>();
        LocalTensor<float> penT = penBuf.Get<float>();
        LocalTensor<bfloat16_t> pT = pBuf.Get<bfloat16_t>();
        LocalTensor<float> rT = rBuf.Get<float>();
        LocalTensor<float> runMax = rT[0];
        LocalTensor<float> tileMax = rT[HEADS];
        LocalTensor<float> runSum = rT[2 * HEADS];
        LocalTensor<float> tileSum = rT[3 * HEADS];
        LocalTensor<float> mVal = ivBuf.Get<float>();

        const uint16_t rowGapF = (uint16_t)((TOPK - NT) * (int32_t)sizeof(float) / 32);
        const uint16_t rowGapB = (uint16_t)((TOPK - NT) * (int32_t)sizeof(bfloat16_t) / 32);
        DataCopyParams cpIn{HEADS, (uint16_t)(NT * (int32_t)sizeof(float) / 32), rowGapF, 0};
        DataCopyParams cpOut{HEADS, (uint16_t)(NT * (int32_t)sizeof(bfloat16_t) / 32), 0, rowGapB};

        Duplicate(runMax, NEG, HEADS);
        // ---- pass A: row max over the whole selected set
        for (int32_t tile = 0; tile < TILES; ++tile) {
            if (tile > 0) {
                WaitFlag<HardEvent::V_MTE2>(EV_B);
            }
            DataCopy(sT, sGm[(int64_t)tile * NT], cpIn);
            DataCopy(penT, penGm[(int64_t)tile * NT], NT);
            SetFlag<HardEvent::MTE2_V>(EV_A);
            WaitFlag<HardEvent::MTE2_V>(EV_A);
            Muls(sT, sT, SCALE, HEADS * NT);
            Add2(sT, penT);
            WholeReduceMax(tileMax, sT, NT, HEADS, 1, 1, NT / 8, ReduceOrder::ORDER_ONLY_VALUE);
            Max(runMax, runMax, tileMax, HEADS);
            SetFlag<HardEvent::V_MTE2>(EV_B);
        }
        WaitFlag<HardEvent::V_MTE2>(EV_B);

        SetFlag<HardEvent::V_S>(EV_C);
        WaitFlag<HardEvent::V_S>(EV_C);
        for (int32_t r = 0; r < HEADS; ++r) {
            mVal.SetValue(r, runMax.GetValue(r));
        }
        SetFlag<HardEvent::S_V>(EV_D);
        WaitFlag<HardEvent::S_V>(EV_D);

        // ---- pass B: p = exp(s - max), row sums, bf16 probabilities
        Duplicate(runSum, 0.0f, HEADS);
        for (int32_t tile = 0; tile < TILES; ++tile) {
            if (tile > 0) {
                WaitFlag<HardEvent::MTE3_V>(EV_F);
                WaitFlag<HardEvent::V_MTE2>(EV_G);
            }
            DataCopy(sT, sGm[(int64_t)tile * NT], cpIn);
            DataCopy(penT, penGm[(int64_t)tile * NT], NT);
            SetFlag<HardEvent::MTE2_V>(EV_A);
            WaitFlag<HardEvent::MTE2_V>(EV_A);
            Muls(sT, sT, SCALE, HEADS * NT);
            Add2(sT, penT);
            SetFlag<HardEvent::S_V>(EV_D);
            WaitFlag<HardEvent::S_V>(EV_D);
            for (int32_t r = 0; r < HEADS; ++r) {
                Adds(sT[r * NT], sT[r * NT], -mVal.GetValue(r), NT);
            }
            Exp(sT, sT, HEADS * NT);
            WholeReduceSum(tileSum, sT, NT, HEADS, 1, 1, NT / 8);
            Add(runSum, runSum, tileSum, HEADS);
            Cast(pT, sT, RoundMode::CAST_RINT, HEADS * NT);
            SetFlag<HardEvent::V_MTE3>(EV_E);
            WaitFlag<HardEvent::V_MTE3>(EV_E);
            DataCopy(pGm[(int64_t)tile * NT], pT, cpOut);
            SetFlag<HardEvent::MTE3_V>(EV_F);
            SetFlag<HardEvent::V_MTE2>(EV_G);
        }
        WaitFlag<HardEvent::MTE3_V>(EV_F);
        WaitFlag<HardEvent::V_MTE2>(EV_G);

        // ---- statistics
        Ln(tileSum, runSum, HEADS);
        Add(tileSum, tileSum, runMax, HEADS);
        SetFlag<HardEvent::V_MTE3>(EV_E);
        WaitFlag<HardEvent::V_MTE3>(EV_E);
        DataCopy(mxGm[(int64_t)t * HEADS], runMax, HEADS);
        DataCopy(lseGm[(int64_t)t * HEADS], tileSum, HEADS);
        Reciprocal(runSum, runSum, HEADS);
        SetFlag<HardEvent::V_MTE3>(EV_E);
        WaitFlag<HardEvent::V_MTE3>(EV_E);
        DataCopy(invGm, runSum, HEADS);
    }

    // -------------------------------------------------------------------- PV
    __aicore__ inline void Pv(int32_t t)
    {
        mm2.SetTensorA(pGm);
        mm2.SetTensorB(wkGm);
        mm2.IterateAll(oGm);
    }

    // -------------------------------------------------------------- finalise
    __aicore__ inline void WriteOut(int32_t t)
    {
        LocalTensor<float> oT = oBuf.Get<float>();
        LocalTensor<bfloat16_t> obT = obBuf.Get<bfloat16_t>();
        LocalTensor<float> ivT = ivBuf.Get<float>();
        const uint16_t srcGap = (uint16_t)((KDIM - VDIM) * (int32_t)sizeof(float) / 32);
        for (int32_t c = 0; c < HEADS; c += NR5) {
            DataCopy(oT, oGm[(int64_t)c * KDIM], NR5 * VDIM);
            DataCopy(ivT, invGm[(int64_t)c], NR5);
            SetFlag<HardEvent::MTE2_S>(EV_A);
            WaitFlag<HardEvent::MTE2_S>(EV_A);
            for (int32_t r = 0; r < NR5; ++r) {
                Muls(oT[r * VDIM], oT[r * VDIM], ivT.GetValue(r), VDIM);
            }
            Cast(obT, oT, RoundMode::CAST_RINT, NR5 * VDIM);
            SetFlag<HardEvent::V_MTE3>(EV_B);
            WaitFlag<HardEvent::V_MTE3>(EV_B);
            DataCopy(outGm[((int64_t)t * HEADS + c) * VDIM], obT, NR5 * VDIM);
            SetFlag<HardEvent::MTE3_MTE2>(EV_C);
            WaitFlag<HardEvent::MTE3_MTE2>(EV_C);
        }
    }

    TPipe pipe;
    TBuf<TPosition::VECCALC> gathBuf, idxBuf, penBuf, sBuf, pBuf, rBuf, oBuf, obBuf, ivBuf;
    Matmul<A1T, B1T, C1T, BST, TIL1> mm1;
    Matmul<A2T, B2T, C2T, BST, TIL2> mm2;
    GlobalTensor<bfloat16_t> qGm, kvGm, outGm, wkGm, pGm;
    GlobalTensor<int32_t> idxGm;
    GlobalTensor<float> mxGm, lseGm, sGm, oGm, penGm, invGm;
    int32_t coreId = 0;
    int32_t nCore = 1;
};

}  // namespace sa

__global__ __aicore__ void sparse_mla_kernel(GM_ADDR q, GM_ADDR kv, GM_ADDR idx, GM_ADDR out,
                                             GM_ADDR mx, GM_ADDR lse, GM_ADDR wk, GM_ADDR sbuf,
                                             GM_ADDR pbuf, GM_ADDR obuf, GM_ADDR pen, GM_ADDR stt,
                                             GM_ADDR sysws)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    sa::SparseMla op;
    op.Init(q, kv, idx, out, mx, lse, wk, sbuf, pbuf, obuf, pen, stt, sysws);
    op.Process();
}

void kernel(at::Tensor q, at::Tensor kv, at::Tensor indices, at::Tensor output, at::Tensor max_logits,
            at::Tensor lse)
{
    TORCH_CHECK(q.scalar_type() == at::kBFloat16, "q must be bfloat16");
    TORCH_CHECK(kv.scalar_type() == at::kBFloat16, "kv must be bfloat16");
    TORCH_CHECK(indices.scalar_type() == at::kInt, "indices must be int32");
    TORCH_CHECK(output.scalar_type() == at::kBFloat16, "output must be bfloat16");
    TORCH_CHECK(max_logits.scalar_type() == at::kFloat, "max_logits must be float32");
    TORCH_CHECK(lse.scalar_type() == at::kFloat, "lse must be float32");
    TORCH_CHECK(q.is_contiguous() && kv.is_contiguous() && indices.is_contiguous() &&
                    output.is_contiguous() && max_logits.is_contiguous() && lse.is_contiguous(),
                "tensors must be contiguous");

    const c10::DeviceGuard guard(q.device());
    aclrtStream stream = c10_npu::getCurrentNPUStream().stream(true);

    auto f32 = q.options().dtype(at::kFloat);
    auto bf16 = q.options().dtype(at::kBFloat16);

    auto wk = at::empty({(int64_t)sa::NCORE * sa::TOPK * sa::KDIM}, bf16);
    auto sW = at::empty({(int64_t)sa::NCORE * sa::HEADS * sa::TOPK}, f32);
    auto pW = at::empty({(int64_t)sa::NCORE * sa::HEADS * sa::TOPK}, bf16);
    auto oW = at::empty({(int64_t)sa::NCORE * sa::HEADS * sa::KDIM}, f32);
    auto penW = at::empty({(int64_t)sa::NCORE * sa::TOPK}, f32);
    auto stW = at::empty({(int64_t)sa::NCORE * sa::HEADS}, f32);
    auto sysW = at::empty({(int64_t)32 * 1024 * 1024}, f32);

    sparse_mla_kernel<<<sa::NCORE, nullptr, stream>>>(
        (uint8_t *)q.data_ptr(), (uint8_t *)kv.data_ptr(), (uint8_t *)indices.data_ptr(),
        (uint8_t *)output.data_ptr(), (uint8_t *)max_logits.data_ptr(), (uint8_t *)lse.data_ptr(),
        (uint8_t *)wk.data_ptr(), (uint8_t *)sW.data_ptr(), (uint8_t *)pW.data_ptr(),
        (uint8_t *)oW.data_ptr(), (uint8_t *)penW.data_ptr(), (uint8_t *)stW.data_ptr(),
        (uint8_t *)sysW.data_ptr());
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module)
{
    module.def("kernel", &kernel);
}
