// Sparse MLA prefill (supplied-index sparse attention) for Ascend 910B3.
//
//   q        : [TOKENS, HEADS, KDIM]      bf16
//   kv       : [TOKENS, 1, KDIM]          bf16  (first VDIM elements are values)
//   indices  : [TOKENS, 1, TOPK]          int32 (-1 padding)
//   output   : [TOKENS, HEADS, VDIM]      bf16
//   max_logits, lse : [TOKENS, HEADS]     fp32
//
// One AI core (1 AIC + 2 AIV) owns a strided set of tokens.  Per token the
// selected key rows are gathered into a per-core global staging tile, S = Q*K^T
// is produced by the Cube, the softmax statistics and the bf16 probability
// matrix by the Vector unit, and O = P*KV by the Cube again.

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;

namespace sa {

constexpr int32_t TOKENS = 8192;
constexpr int32_t HEADS = 128;
constexpr int32_t KDIM = 576;
constexpr int32_t VDIM = 512;
constexpr int32_t TOPK = 2048;
constexpr float SCALE = 0.1352337788608801f;
constexpr float NEG = -1.0e30f;

constexpr int32_t NCORE = 20;
constexpr int32_t NT = 64;                 // keys per softmax tile
constexpr int32_t TILES = TOPK / NT;       // 32
constexpr int32_t NROWS5 = 8;              // output rows per vector chunk
constexpr int32_t KCHUNK = 128;            // rows gathered per index chunk

using a1Type = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
using b1Type = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, true>;
using c1Type = MatmulType<TPosition::GM, CubeFormat::ND, float>;
using biasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;

constexpr MatmulShapeParams SP1{HEADS, TOPK, KDIM, 128, 128, 64};
constexpr MatmulConfig CFG1 = GetMMConfig<MatmulConfigMode::CONFIG_NORM>(SP1);
constexpr auto TIL1 = GetMatmulApiTiling<a1Type, b1Type, c1Type, biasT>(CFG1, 524288);

using a2Type = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
using b2Type = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;
using c2Type = MatmulType<TPosition::GM, CubeFormat::ND, float>;
constexpr MatmulShapeParams SP2{HEADS, KDIM, TOPK, 128, 64, 64};
constexpr MatmulConfig CFG2 = GetMMConfig<MatmulConfigMode::CONFIG_NORM>(SP2);
constexpr auto TIL2 = GetMatmulApiTiling<a2Type, b2Type, c2Type, biasT>(CFG2, 524288);

class SparseMla {
public:
    __aicore__ inline SparseMla() {}

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR kv, GM_ADDR idx, GM_ADDR out, GM_ADDR mx,
                                GM_ADDR lse, GM_ADDR wk, GM_ADDR sbuf, GM_ADDR pbuf,
                                GM_ADDR obuf, GM_ADDR pen, GM_ADDR stt, GM_ADDR sysws)
    {
        qGm.SetGlobalBuffer((__gm__ bfloat16_t *)q);
        kvGm.SetGlobalBuffer((__gm__ bfloat16_t *)kv);
        idxGm.SetGlobalBuffer((__gm__ int32_t *)idx);
        outGm.SetGlobalBuffer((__gm__ bfloat16_t *)out);
        mxGm.SetGlobalBuffer((__gm__ float *)mx);
        lseGm.SetGlobalBuffer((__gm__ float *)lse);
        SetSysWorkspace(sysws);

        int64_t bn = (int64_t)GetBlockNum();
        int64_t bi = (int64_t)GetBlockIdx();
        if (bn > NCORE) {
            coreId = bi >> 1;
            subId = bi & 1;
        } else {
            coreId = bi;
            subId = (int64_t)GetSubBlockIdx();
        }

        wkGm.SetGlobalBuffer((__gm__ bfloat16_t *)wk + coreId * (int64_t)TOPK * KDIM);
        sGm.SetGlobalBuffer((__gm__ float *)sbuf + coreId * (int64_t)HEADS * TOPK);
        pGm.SetGlobalBuffer((__gm__ bfloat16_t *)pbuf + coreId * (int64_t)HEADS * TOPK);
        oGm.SetGlobalBuffer((__gm__ float *)obuf + coreId * (int64_t)HEADS * KDIM);
        penGm.SetGlobalBuffer((__gm__ float *)pen + coreId * (int64_t)TOPK);
        stGm.SetGlobalBuffer((__gm__ float *)stt + coreId * (int64_t)HEADS * 2);

        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm1, nullptr);
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm2, nullptr);

        pipe.InitBuffer(stageBuf, 2 * KDIM * (int32_t)sizeof(bfloat16_t));
        pipe.InitBuffer(idxBuf, KCHUNK * (int32_t)sizeof(int32_t));
        pipe.InitBuffer(penBuf, KCHUNK * (int32_t)sizeof(float));
        pipe.InitBuffer(sBuf, HEADS * NT * (int32_t)sizeof(float));
        pipe.InitBuffer(pBuf, HEADS * NT * (int32_t)sizeof(bfloat16_t));
        pipe.InitBuffer(vBuf, 1024 * (int32_t)sizeof(float));
        pipe.InitBuffer(oBuf, NROWS5 * KDIM * (int32_t)sizeof(float));
        pipe.InitBuffer(obBuf, NROWS5 * VDIM * (int32_t)sizeof(bfloat16_t));

        ev23[0] = (TEventID)pipe.FetchEventID(HardEvent::MTE2_MTE3);
        ev23[1] = (TEventID)pipe.FetchEventID(HardEvent::MTE2_MTE3);
        ev32[0] = (TEventID)pipe.FetchEventID(HardEvent::MTE3_MTE2);
        ev32[1] = (TEventID)pipe.FetchEventID(HardEvent::MTE3_MTE2);
        evM2V = (TEventID)pipe.FetchEventID(HardEvent::MTE2_V);
        evM2S = (TEventID)pipe.FetchEventID(HardEvent::MTE2_S);
        evVS = (TEventID)pipe.FetchEventID(HardEvent::V_S);
        evSV = (TEventID)pipe.FetchEventID(HardEvent::S_V);
        evV3 = (TEventID)pipe.FetchEventID(HardEvent::V_MTE3);
    }

    __aicore__ inline void Process()
    {
        for (int32_t t = (int32_t)coreId; t < TOKENS; t += NCORE) {
            if ASCEND_IS_AIV {
                GatherKeys(t);
            }
            SyncAll();
            if ASCEND_IS_AIC {
                mm1.SetTensorA(qGm[(int64_t)t * HEADS * KDIM]);
                mm1.SetTensorB(wkGm);
                mm1.IterateAll(sGm);
            }
            SyncAll();
            if ASCEND_IS_AIV {
                if (subId == 0) {
                    Softmax(t);
                }
            }
            SyncAll();
            if ASCEND_IS_AIC {
                mm2.SetTensorA(pGm);
                mm2.SetTensorB(wkGm);
                mm2.IterateAll(oGm);
            }
            SyncAll();
            if ASCEND_IS_AIV {
                if (subId == 1) {
                    WriteOut(t);
                }
            }
        }
        if ASCEND_IS_AIC {
            mm1.End();
            mm2.End();
        }
    }

private:
    __aicore__ inline void GatherKeys(int32_t t)
    {
        LocalTensor<bfloat16_t> stage = stageBuf.Get<bfloat16_t>();
        LocalTensor<int32_t> idxT = idxBuf.Get<int32_t>();
        LocalTensor<float> penT = penBuf.Get<float>();

        const int32_t half = TOPK / 2;
        const int32_t j0 = (int32_t)subId * half;

        for (int32_t c = 0; c < half; c += KCHUNK) {
            DataCopy(idxT, idxGm[(int64_t)t * TOPK + j0 + c], KCHUNK);
            SetFlag<HardEvent::MTE2_S>(evM2S);
            WaitFlag<HardEvent::MTE2_S>(evM2S);
            // mask values for this chunk
            Cast(penT, idxT, RoundMode::CAST_NONE, KCHUNK);
            Mins(penT, penT, 0.0f, KCHUNK);
            Muls(penT, penT, 1.0e30f, KCHUNK);
            SetFlag<HardEvent::V_MTE3>(evV3);
            WaitFlag<HardEvent::V_MTE3>(evV3);
            DataCopy(penGm[(int64_t)j0 + c], penT, KCHUNK);

            // gather KCHUNK rows with double buffering
            for (int32_t i = 0; i < KCHUNK; ++i) {
                int32_t r = idxT.GetValue(i);
                if (r < 0) {
                    r = 0;
                }
                int32_t b = i & 1;
                if (i >= 2) {
                    WaitFlag<HardEvent::MTE3_MTE2>(ev32[b]);
                }
                DataCopy(stage[b * KDIM], kvGm[(int64_t)r * KDIM], KDIM);
                SetFlag<HardEvent::MTE2_MTE3>(ev23[b]);
                if (i >= 1) {
                    int32_t pb = (i - 1) & 1;
                    WaitFlag<HardEvent::MTE2_MTE3>(ev23[pb]);
                    DataCopy(wkGm[((int64_t)j0 + c + i - 1) * KDIM], stage[pb * KDIM], KDIM);
                    SetFlag<HardEvent::MTE3_MTE2>(ev32[pb]);
                }
            }
            int32_t lb = (KCHUNK - 1) & 1;
            WaitFlag<HardEvent::MTE2_MTE3>(ev23[lb]);
            DataCopy(wkGm[((int64_t)j0 + c + KCHUNK - 1) * KDIM], stage[lb * KDIM], KDIM);
            SetFlag<HardEvent::MTE3_MTE2>(ev32[lb]);
            WaitFlag<HardEvent::MTE3_MTE2>(ev32[lb]);
            WaitFlag<HardEvent::MTE3_MTE2>(ev32[lb ^ 1]);
        }
    }

    __aicore__ inline void Softmax(int32_t t)
    {
        LocalTensor<float> sT = sBuf.Get<float>();
        LocalTensor<float> penT = penBuf.Get<float>();
        LocalTensor<bfloat16_t> pT = pBuf.Get<bfloat16_t>();
        LocalTensor<float> mCur = vBuf.Get<float>();
        LocalTensor<float> sumCur = mCur[HEADS];
        LocalTensor<float> tmp = mCur[2 * HEADS];
        LocalTensor<float> newMax = mCur[3 * HEADS];
        LocalTensor<float> tileSum = mCur[4 * HEADS];

        Duplicate(mCur, NEG, HEADS);
        Duplicate(sumCur, 0.0f, HEADS);

        const uint16_t rowGapF = (uint16_t)((TOPK - NT) * (int32_t)sizeof(float) / 32);
        const uint16_t rowGapB = (uint16_t)((TOPK - NT) * (int32_t)sizeof(bfloat16_t) / 32);

        for (int32_t tile = 0; tile < TILES; ++tile) {
            DataCopyParams cpIn{HEADS, (uint16_t)(NT * (int32_t)sizeof(float) / 32), rowGapF, 0};
            DataCopy(sT, sGm[(int64_t)tile * NT], cpIn);
            DataCopy(penT, penGm[(int64_t)tile * NT], NT);
            SetFlag<HardEvent::MTE2_V>(evM2V);
            WaitFlag<HardEvent::MTE2_V>(evM2V);

            for (int32_t r = 0; r < HEADS; ++r) {
                LocalTensor<float> row = sT[r * NT];
                Muls(row, row, SCALE, NT);
                Add(row, row, penT, NT);
            }
            WholeReduceMax(tileSum, sT, NT, HEADS, 1, 1, NT / 8);
            Max(newMax, tileSum, mCur, HEADS);
            Sub(tmp, mCur, newMax, HEADS);
            Exp(tmp, tmp, HEADS);
            Mul(sumCur, sumCur, tmp, HEADS);
            SetFlag<HardEvent::V_S>(evVS);
            WaitFlag<HardEvent::V_S>(evVS);
            for (int32_t r = 0; r < HEADS; ++r) {
                Adds(sT[r * NT], sT[r * NT], -newMax.GetValue(r), NT);
            }
            Exp(sT, sT, HEADS * NT);
            WholeReduceSum(tileSum, sT, NT, HEADS, 1, 1, NT / 8);
            Add(sumCur, sumCur, tileSum, HEADS);
            Adds(mCur, newMax, 0.0f, HEADS);

            Cast(pT, sT, RoundMode::CAST_RINT, HEADS * NT);
            DataCopyParams cpOut{HEADS, (uint16_t)(NT * (int32_t)sizeof(bfloat16_t) / 32), 0, rowGapB};
            DataCopy(pGm[(int64_t)tile * NT], pT, cpOut);
        }

        Ln(tmp, sumCur, HEADS);
        Add(tmp, tmp, mCur, HEADS);
        SetFlag<HardEvent::V_MTE3>(evV3);
        WaitFlag<HardEvent::V_MTE3>(evV3);
        DataCopy(mxGm[(int64_t)t * HEADS], mCur, HEADS);
        DataCopy(lseGm[(int64_t)t * HEADS], tmp, HEADS);
        Reciprocal(tmp, sumCur, HEADS);
        SetFlag<HardEvent::V_MTE3>(evV3);
        WaitFlag<HardEvent::V_MTE3>(evV3);
        DataCopy(stGm[HEADS], tmp, HEADS);
    }

    __aicore__ inline void WriteOut(int32_t t)
    {
        LocalTensor<float> oT = oBuf.Get<float>();
        LocalTensor<bfloat16_t> obT = obBuf.Get<bfloat16_t>();
        for (int32_t c = 0; c < HEADS; c += NROWS5) {
            DataCopy(oT, oGm[(int64_t)c * KDIM], NROWS5 * KDIM);
            SetFlag<HardEvent::MTE2_S>(evM2S);
            WaitFlag<HardEvent::MTE2_S>(evM2S);
            for (int32_t r = 0; r < NROWS5; ++r) {
                Muls(oT[r * KDIM], oT[r * KDIM], stGm.GetValue(HEADS + c + r), VDIM);
                Cast(obT[r * VDIM], oT[r * KDIM], RoundMode::CAST_RINT, VDIM);
            }
            SetFlag<HardEvent::V_MTE3>(evV3);
            WaitFlag<HardEvent::V_MTE3>(evV3);
            DataCopy(outGm[((int64_t)t * HEADS + c) * VDIM], obT, NROWS5 * VDIM);
        }
    }

    TPipe pipe;
    TBuf<TPosition::VECCALC> stageBuf, idxBuf, penBuf, sBuf, pBuf, vBuf, oBuf, obBuf;
    Matmul<a1Type, b1Type, c1Type, biasT, TIL1> mm1;
    Matmul<a2Type, b2Type, c2Type, biasT, TIL2> mm2;
    GlobalTensor<bfloat16_t> qGm, kvGm, outGm, wkGm, pGm;
    GlobalTensor<int32_t> idxGm;
    GlobalTensor<float> mxGm, lseGm, sGm, oGm, penGm, stGm;
    int64_t coreId = 0;
    int64_t subId = 0;
    TEventID ev23[2] = {0, 0};
    TEventID ev32[2] = {0, 0};
    TEventID evM2V = 0;
    TEventID evM2S = 0;
    TEventID evVS = 0;
    TEventID evSV = 0;
    TEventID evV3 = 0;
};

}  // namespace sa

__global__ __aicore__ void sparse_mla_kernel(GM_ADDR q, GM_ADDR kv, GM_ADDR idx, GM_ADDR out,
                                             GM_ADDR mx, GM_ADDR lse, GM_ADDR wk, GM_ADDR sbuf,
                                             GM_ADDR pbuf, GM_ADDR obuf, GM_ADDR pen, GM_ADDR stt,
                                             GM_ADDR sysws)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    sa::SparseMla op;
    op.Init(q, kv, idx, out, mx, lse, wk, sbuf, pbuf, obuf, pen, stt, sysws);
    op.Process();
}

void kernel(at::Tensor q, at::Tensor kv, at::Tensor indices, at::Tensor output,
            at::Tensor max_logits, at::Tensor lse)
{
    TORCH_CHECK(q.scalar_type() == at::kBFloat16, "q must be bfloat16");
    TORCH_CHECK(kv.scalar_type() == at::kBFloat16, "kv must be bfloat16");
    TORCH_CHECK(indices.scalar_type() == at::kInt, "indices must be int32");
    TORCH_CHECK(output.scalar_type() == at::kBFloat16, "output must be bfloat16");
    TORCH_CHECK(max_logits.scalar_type() == at::kFloat, "max_logits must be float32");
    TORCH_CHECK(lse.scalar_type() == at::kFloat, "lse must be float32");
    TORCH_CHECK(q.is_contiguous() && kv.is_contiguous() && indices.is_contiguous() &&
                    output.is_contiguous() && max_logits.is_contiguous() && lse.is_contiguous(),
                "tensors must be contiguous");

    const c10::DeviceGuard guard(q.device());
    aclrtStream stream = c10_npu::getCurrentNPUStream().stream(true);

    auto f32 = q.options().dtype(at::kFloat);
    auto bf16 = q.options().dtype(at::kBFloat16);

    auto wk = at::empty({(int64_t)sa::NCORE * sa::TOPK * sa::KDIM}, bf16);
    auto sW = at::empty({(int64_t)sa::NCORE * sa::HEADS * sa::TOPK}, f32);
    auto pW = at::empty({(int64_t)sa::NCORE * sa::HEADS * sa::TOPK}, bf16);
    auto oW = at::empty({(int64_t)sa::NCORE * sa::HEADS * sa::KDIM}, f32);
    auto penW = at::empty({(int64_t)sa::NCORE * sa::TOPK}, f32);
    auto stW = at::empty({(int64_t)sa::NCORE * sa::HEADS * 2}, f32);
    auto sysW = at::empty({(int64_t)1024 * 1024}, f32);

    sparse_mla_kernel<<<sa::NCORE, nullptr, stream>>>(
        (uint8_t *)q.data_ptr(), (uint8_t *)kv.data_ptr(), (uint8_t *)indices.data_ptr(),
        (uint8_t *)output.data_ptr(), (uint8_t *)max_logits.data_ptr(), (uint8_t *)lse.data_ptr(),
        (uint8_t *)wk.data_ptr(), (uint8_t *)sW.data_ptr(), (uint8_t *)pW.data_ptr(),
        (uint8_t *)oW.data_ptr(), (uint8_t *)penW.data_ptr(), (uint8_t *)stW.data_ptr(),
        (uint8_t *)sysW.data_ptr());
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module)
{
    module.def("kernel", &kernel);
}
