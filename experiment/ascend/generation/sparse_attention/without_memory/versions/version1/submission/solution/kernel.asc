// Sparse MLA prefill (supplied-index sparse attention) for Ascend 910B (dav-c220).
//
//   q        : [TOKENS, HEADS, KDIM]      bf16
//   kv       : [TOKENS, 1, KDIM]          bf16   (first VALUE_DIM elements are values)
//   indices  : [TOKENS, 1, TOPK]          int32  (-1 padding)
//   output   : [TOKENS, HEADS, VALUE_DIM] bf16
//   max_logits, lse : [TOKENS, HEADS]     fp32
//
// Vector-only (AIV) implementation: one block owns a contiguous range of
// (token, head-group) jobs, streams the selected key rows in tiles of KT keys,
// keeps an online-softmax fp32 accumulator per head and writes every output.

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace sa {

constexpr int32_t TOKENS = 8192;
constexpr int32_t HEADS = 128;
constexpr int32_t KDIM = 576;
constexpr int32_t VDIM = 512;
constexpr int32_t TOPK = 2048;
constexpr float SCALE = 0.1352337788608801f;

constexpr int32_t HPJ = 8;               // heads handled by one job
constexpr int32_t GROUPS = HEADS / HPJ;  // jobs per token
constexpr int32_t KT = 32;               // keys per tile
constexpr int32_t TILES = TOPK / KT;
constexpr int32_t NCHUNK = KDIM / 64;    // fp32 repeats per key row
constexpr int32_t NBLOCK = 40;           // vector (AIV) instances

class SparseAttn {
public:
    __aicore__ inline SparseAttn() {}

    __aicore__ inline void Init(GM_ADDR qAddr, GM_ADDR kvAddr, GM_ADDR idxAddr,
                                GM_ADDR outAddr, GM_ADDR mxAddr, GM_ADDR lseAddr,
                                uint32_t jobCount)
    {
        qGm.SetGlobalBuffer((__gm__ bfloat16_t *)qAddr);
        kvGm.SetGlobalBuffer((__gm__ bfloat16_t *)kvAddr);
        idxGm.SetGlobalBuffer((__gm__ int32_t *)idxAddr);
        outGm.SetGlobalBuffer((__gm__ bfloat16_t *)outAddr);
        mxGm.SetGlobalBuffer((__gm__ float *)mxAddr);
        lseGm.SetGlobalBuffer((__gm__ float *)lseAddr);

        uint32_t blocks = GetBlockNum();
        uint32_t bid = GetBlockIdx();
        uint32_t per = (jobCount + blocks - 1) / blocks;
        int64_t begin = (int64_t)bid * (int64_t)per;
        int64_t end = begin + (int64_t)per;
        if (begin > (int64_t)jobCount) {
            begin = jobCount;
        }
        if (end > (int64_t)jobCount) {
            end = jobCount;
        }
        jobBegin = begin;
        jobEnd = end;

        pipe.InitBuffer(stageQ, 1, KT * KDIM * sizeof(bfloat16_t));
        pipe.InitBuffer(idxQ, 1, KT * sizeof(int32_t));
        pipe.InitBuffer(k32Buf, KT * KDIM * sizeof(float));
        pipe.InitBuffer(q32Buf, HPJ * KDIM * sizeof(float));
        pipe.InitBuffer(accBuf, HPJ * VDIM * sizeof(float));
        pipe.InitBuffer(sBuf, HPJ * KT * sizeof(float));
        pipe.InitBuffer(dotBuf, 64 * sizeof(float));
        pipe.InitBuffer(workBuf, 256 * sizeof(float));
        pipe.InitBuffer(penBuf, KT * sizeof(float));
        pipe.InitBuffer(vecBuf, 64 * sizeof(float));
        pipe.InitBuffer(outQ, 1, VDIM * sizeof(bfloat16_t));

        eventVS = static_cast<TEventID>(pipe.FetchEventID(HardEvent::V_S));
        eventSV = static_cast<TEventID>(pipe.FetchEventID(HardEvent::S_V));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<float> acc = accBuf.Get<float>();
        LocalTensor<float> q32 = q32Buf.Get<float>();
        LocalTensor<float> k32 = k32Buf.Get<float>();
        LocalTensor<float> s = sBuf.Get<float>();
        LocalTensor<float> dot = dotBuf.Get<float>();
        LocalTensor<float> work = workBuf.Get<float>();
        LocalTensor<float> pen = penBuf.Get<float>();
        LocalTensor<float> vec = vecBuf.Get<float>();

        for (int64_t job = jobBegin; job < jobEnd; ++job) {
            int32_t token = (int32_t)(job / GROUPS);
            int32_t group = (int32_t)(job % GROUPS);
            const int32_t h0 = group * HPJ;

            // ------------- query rows for this head group (fp32) -------------
            {
                LocalTensor<bfloat16_t> st = stageQ.AllocTensor<bfloat16_t>();
                DataCopy(st, qGm[(int64_t)token * HEADS * KDIM + (int64_t)h0 * KDIM],
                         HPJ * KDIM);
                stageQ.EnQue(st);
                st = stageQ.DeQue<bfloat16_t>();
                Cast(q32, st, RoundMode::CAST_NONE, HPJ * KDIM);
                stageQ.FreeTensor(st);
            }
            Duplicate(acc, 0.0f, HPJ * VDIM);

            float mOld[HPJ];
            float runSum[HPJ];
            for (int32_t h = 0; h < HPJ; ++h) {
                mOld[h] = 0.0f;
                runSum[h] = 0.0f;
            }

            for (int32_t tile = 0; tile < TILES; ++tile) {
                const int32_t base = tile * KT;
                const int64_t rowIdx = (int64_t)token * TOPK + base;

                // ------------- gather selected key rows ----------------------
                {
                    LocalTensor<bfloat16_t> st = stageQ.AllocTensor<bfloat16_t>();
                    for (int32_t j = 0; j < KT; ++j) {
                        int32_t row = idxGm.GetValue(rowIdx + j);
                        if (row < 0) {
                            row = 0;
                        }
                        DataCopy(st[j * KDIM], kvGm[(int64_t)row * KDIM], KDIM);
                    }
                    stageQ.EnQue(st);
                    st = stageQ.DeQue<bfloat16_t>();
                    Cast(k32, st, RoundMode::CAST_NONE, KT * KDIM);
                    stageQ.FreeTensor(st);
                }
                // ------------- mask vector: 0 for valid keys, -1e30 for padding
                {
                    LocalTensor<int32_t> it = idxQ.AllocTensor<int32_t>();
                    DataCopy(it, idxGm[rowIdx], KT);
                    idxQ.EnQue(it);
                    it = idxQ.DeQue<int32_t>();
                    Cast(pen, it, RoundMode::CAST_NONE, KT);
                    Mins(pen, pen, 0.0f, KT);
                    Muls(pen, pen, 1.0e30f, KT);
                    idxQ.FreeTensor(it);
                }
                // ------------- scores: s[h][j] = q_h . k_j * SCALE + pen -----
                for (int32_t h = 0; h < HPJ; ++h) {
                    LocalTensor<float> qh = q32[h * KDIM];
                    LocalTensor<float> sh = s[h * KT];
                    for (int32_t j = 0; j < KT; ++j) {
                        LocalTensor<float> kj = k32[j * KDIM];
                        Mul(dot, qh, kj, 64);
                        for (int32_t c = 1; c < NCHUNK; ++c) {
                            MulAddDst(dot, qh[c * 64], kj[c * 64], 64);
                        }
                        WholeReduceSum(sh[j], dot, 64, 1, 1, 1, 8);
                    }
                    Muls(sh, sh, SCALE, KT);
                    Add(sh, sh, pen, KT);
                    WholeReduceMax(vec[h], sh, KT, 1, 1, 1, 8);
                }
                if (tile == 0) {
                    SetFlag<HardEvent::V_S>(eventVS);
                    WaitFlag<HardEvent::V_S>(eventVS);
                    for (int32_t h = 0; h < HPJ; ++h) {
                        mOld[h] = vec.GetValue(h);  // first tile owns >= 1 valid key
                    }
                }
                // ------------- probabilities q = exp(s - mOld) ---------------
                for (int32_t h = 0; h < HPJ; ++h) {
                    LocalTensor<float> sh = s[h * KT];
                    Adds(sh, sh, -mOld[h], KT);
                    Exp(sh, sh, KT);
                    Maxs(vec[HPJ + h], vec[h], mOld[h], 1);
                    Adds(vec[2 * HPJ + h], vec[HPJ + h], -mOld[h], 1);
                    Muls(vec[2 * HPJ + h], vec[2 * HPJ + h], -1.0f, 1);
                    Exp(vec[3 * HPJ + h], vec[2 * HPJ + h], 1);
                }
                // ------------- value rows and fused accumulate --------------
                {
                    LocalTensor<bfloat16_t> st = stageQ.AllocTensor<bfloat16_t>();
                    for (int32_t j = 0; j < KT; ++j) {
                        int32_t row = idxGm.GetValue(rowIdx + j);
                        if (row < 0) {
                            row = 0;
                        }
                        DataCopy(st[j * VDIM], kvGm[(int64_t)row * KDIM], VDIM);
                    }
                    stageQ.EnQue(st);
                    st = stageQ.DeQue<bfloat16_t>();
                    Cast(k32, st, RoundMode::CAST_NONE, KT * VDIM);
                    stageQ.FreeTensor(st);
                }
                SetFlag<HardEvent::V_S>(eventVS);
                WaitFlag<HardEvent::V_S>(eventVS);
                for (int32_t h = 0; h < HPJ; ++h) {
                    float aInv = vec.GetValue(3 * HPJ + h);
                    float mNew = vec.GetValue(HPJ + h);
                    LocalTensor<float> accH = acc[h * VDIM];
                    if (aInv != 1.0f) {
                        Muls(accH, accH, aInv, VDIM);
                    }
                    float rowSum = 0.0f;
                    LocalTensor<float> sh = s[h * KT];
                    for (int32_t j = 0; j < KT; ++j) {
                        float p = sh.GetValue(j);
                        rowSum += p;
                        Axpy(accH, k32[j * VDIM], p, VDIM);
                    }
                    runSum[h] = (runSum[h] + rowSum) * aInv;
                    mOld[h] = mNew;
                }
            }

            // ------------- final normalisation and outputs ------------------
            for (int32_t h = 0; h < HPJ; ++h) {
                vec.SetValue(h, runSum[h]);
                vec.SetValue(HPJ + h, mOld[h]);
            }
            SetFlag<HardEvent::S_V>(eventSV);
            WaitFlag<HardEvent::S_V>(eventSV);
            Ln(vec[2 * HPJ], vec[0], HPJ);
            Add(vec[2 * HPJ], vec[2 * HPJ], vec[HPJ], HPJ);
            Reciprocal(vec[3 * HPJ], vec[0], HPJ);
            SetFlag<HardEvent::V_S>(eventVS);
            WaitFlag<HardEvent::V_S>(eventVS);
            {
                LocalTensor<float> mxL = outQ.AllocTensor<float>();
                Adds(mxL, vec[HPJ], 0.0f, HPJ);
                outQ.EnQue(mxL);
                mxL = outQ.DeQue<float>();
                DataCopy(mxGm[(int64_t)token * HEADS + h0], mxL, HPJ);
                outQ.FreeTensor(mxL);
            }
            {
                LocalTensor<float> lseL = outQ.AllocTensor<float>();
                Adds(lseL, vec[2 * HPJ], 0.0f, HPJ);
                outQ.EnQue(lseL);
                lseL = outQ.DeQue<float>();
                DataCopy(lseGm[(int64_t)token * HEADS + h0], lseL, HPJ);
                outQ.FreeTensor(lseL);
            }
            for (int32_t h = 0; h < HPJ; ++h) {
                float inv = vec.GetValue(3 * HPJ + h);
                LocalTensor<float> accH = acc[h * VDIM];
                Muls(accH, accH, inv, VDIM);
                LocalTensor<bfloat16_t> ob = outQ.AllocTensor<bfloat16_t>();
                Cast(ob, accH, RoundMode::CAST_RINT, VDIM);
                outQ.EnQue(ob);
                ob = outQ.DeQue<bfloat16_t>();
                DataCopy(outGm[((int64_t)token * HEADS + h0 + h) * VDIM], ob, VDIM);
                outQ.FreeTensor(ob);
            }
        }
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, 1> stageQ;
    TQue<TPosition::VECIN, 1> idxQ;
    TQue<TPosition::VECOUT, 1> outQ;
    TBuf<TPosition::VECCALC> k32Buf;
    TBuf<TPosition::VECCALC> q32Buf;
    TBuf<TPosition::VECCALC> accBuf;
    TBuf<TPosition::VECCALC> sBuf;
    TBuf<TPosition::VECCALC> dotBuf;
    TBuf<TPosition::VECCALC> workBuf;
    TBuf<TPosition::VECCALC> penBuf;
    TBuf<TPosition::VECCALC> vecBuf;
    GlobalTensor<bfloat16_t> qGm;
    GlobalTensor<bfloat16_t> kvGm;
    GlobalTensor<int32_t> idxGm;
    GlobalTensor<bfloat16_t> outGm;
    GlobalTensor<float> mxGm;
    GlobalTensor<float> lseGm;
    int64_t jobBegin = 0;
    int64_t jobEnd = 0;
    TEventID eventVS = 0;
    TEventID eventSV = 0;
};

}  // namespace sa

__global__ __vector__ void sparse_attn_kernel(GM_ADDR q, GM_ADDR kv, GM_ADDR idx,
                                              GM_ADDR out, GM_ADDR mx, GM_ADDR lse,
                                              uint32_t jobCount)
{
    sa::SparseAttn op;
    op.Init(q, kv, idx, out, mx, lse, jobCount);
    op.Process();
}

void kernel(at::Tensor q, at::Tensor kv, at::Tensor indices, at::Tensor output,
            at::Tensor max_logits, at::Tensor lse)
{
    TORCH_CHECK(q.scalar_type() == at::kBFloat16, "q must be bfloat16");
    TORCH_CHECK(kv.scalar_type() == at::kBFloat16, "kv must be bfloat16");
    TORCH_CHECK(indices.scalar_type() == at::kInt, "indices must be int32");
    TORCH_CHECK(output.scalar_type() == at::kBFloat16, "output must be bfloat16");
    TORCH_CHECK(max_logits.scalar_type() == at::kFloat, "max_logits must be float32");
    TORCH_CHECK(lse.scalar_type() == at::kFloat, "lse must be float32");
    TORCH_CHECK(q.is_contiguous() && kv.is_contiguous() && indices.is_contiguous() &&
                    output.is_contiguous() && max_logits.is_contiguous() &&
                    lse.is_contiguous(),
                "tensors must be contiguous");
    TORCH_CHECK(q.dim() == 3 && q.size(0) == sa::TOKENS && q.size(1) == sa::HEADS &&
                    q.size(2) == sa::KDIM,
                "unexpected q shape");
    TORCH_CHECK(kv.dim() == 3 && kv.size(0) == sa::TOKENS && kv.size(1) == 1 &&
                    kv.size(2) == sa::KDIM,
                "unexpected kv shape");
    TORCH_CHECK(indices.dim() == 3 && indices.size(0) == sa::TOKENS &&
                    indices.size(1) == 1 && indices.size(2) == sa::TOPK,
                "unexpected indices shape");
    TORCH_CHECK(output.dim() == 3 && output.size(0) == sa::TOKENS &&
                    output.size(1) == sa::HEADS && output.size(2) == sa::VDIM,
                "unexpected output shape");
    TORCH_CHECK(max_logits.dim() == 2 && max_logits.size(0) == sa::TOKENS &&
                    max_logits.size(1) == sa::HEADS,
                "unexpected max_logits shape");
    TORCH_CHECK(lse.sizes() == max_logits.sizes(), "unexpected lse shape");

    const c10::DeviceGuard guard(q.device());
    aclrtStream stream = c10_npu::getCurrentNPUStream().stream(true);
    uint32_t jobs = (uint32_t)(sa::TOKENS * sa::GROUPS);
    sparse_attn_kernel<<<sa::NBLOCK, nullptr, stream>>>(
        (uint8_t *)q.data_ptr(), (uint8_t *)kv.data_ptr(),
        (uint8_t *)indices.data_ptr(), (uint8_t *)output.data_ptr(),
        (uint8_t *)max_logits.data_ptr(), (uint8_t *)lse.data_ptr(), jobs);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module)
{
    module.def("kernel", &kernel);
}
