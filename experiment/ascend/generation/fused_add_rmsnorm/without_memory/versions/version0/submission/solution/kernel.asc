// Fused residual-add + RMSNorm for DeepSeek-V3.2 style decoders.
//
//   s    = fp32(hidden_states) + fp32(residual)      (exact)
//   res  = bf16(s)
//   rms  = sqrt(mean(s^2) + eps)
//   out  = bf16(s * (1/rms) * fp32(weight))
//
// One AIV block owns a contiguous range of rows; each row is streamed through
// the unified buffer in four tiles that are double/triple buffered so the MTE2
// engine stays busy while the vector unit works on the previous tile.  The full
// row is kept in fp32 (28 KB) so the second pass over the row needs no extra
// global traffic.

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <acl/acl.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr uint32_t kHidden = 7168;
constexpr uint32_t kTile = 1792;
constexpr uint32_t kNTile = kHidden / kTile;
constexpr uint32_t kSlots = 3;
constexpr uint32_t kBlocks = 40;
constexpr uint32_t kSmall = 8;
constexpr float kEps = 1e-6f;
constexpr float kInvHidden = 1.0f / static_cast<float>(kHidden);

// event ids (per pipe-pair hardware event registers)
// Only four hardware event ids exist per pipe pair on this target, and the ids
// of different pipe pairs are independent, so each kind of handshake gets its
// own id.  V_S keeps away from id 0 because the level-2 ReduceSum fetches that
// one from the pipe's event pool internally.
constexpr event_t kEvMte2V0 = EVENT_ID0;  // slots: 0,1,2
constexpr event_t kEvVMte2 = EVENT_ID0;
constexpr event_t kEvVMte3 = EVENT_ID0;
constexpr event_t kEvMte3V = EVENT_ID0;
constexpr event_t kEvVS = EVENT_ID1;

class FusedAddRmsNorm {
public:
    __aicore__ inline FusedAddRmsNorm() {}

    __aicore__ inline void Init(GM_ADDR hidden, GM_ADDR residual, GM_ADDR weight,
                                GM_ADDR output, GM_ADDR residual_out, uint32_t tokens,
                                uint32_t blocks)
    {
        tokens_ = tokens;
        blocks_ = blocks;
        hiddenG_.SetGlobalBuffer((__gm__ bfloat16_t *)hidden,
                                 static_cast<uint64_t>(tokens) * kHidden);
        residualG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual,
                                   static_cast<uint64_t>(tokens) * kHidden);
        weightG_.SetGlobalBuffer((__gm__ bfloat16_t *)weight, kHidden);
        outputG_.SetGlobalBuffer((__gm__ bfloat16_t *)output,
                                 static_cast<uint64_t>(tokens) * kHidden);
        residualOutG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual_out,
                                      static_cast<uint64_t>(tokens) * kHidden);

        pipe_.InitBuffer(wBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(xBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(accBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(tmpBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(hBuf_, kSlots * kTile * sizeof(bfloat16_t));
        pipe_.InitBuffer(rBuf_, kSlots * kTile * sizeof(bfloat16_t));
        pipe_.InitBuffer(resBuf_, kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(yBuf_, kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(redBuf_, 32);

        wF32_ = wBuf_.Get<float>();
        xF32_ = xBuf_.Get<float>();
        acc_ = accBuf_.Get<float>();
        tmp_ = tmpBuf_.Get<float>();
        hAll_ = hBuf_.Get<bfloat16_t>();
        rAll_ = rBuf_.Get<bfloat16_t>();
        resRow_ = resBuf_.Get<bfloat16_t>();
        yRow_ = yBuf_.Get<bfloat16_t>();
        red_ = redBuf_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        if (tokens_ == 0) {
            return;
        }
        const uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        const uint32_t rowsPerBlock = (tokens_ + blocks_ - 1) / blocks_;
        const uint32_t start = blockIdx * rowsPerBlock;
        if (start >= tokens_) {
            return;
        }
        uint32_t end = start + rowsPerBlock;
        if (end > tokens_) {
            end = tokens_;
        }

        LoadWeight();

        const uint32_t total = (end - start) * kNTile;
        const uint32_t prologue = total < kSlots ? total : kSlots;
        for (uint32_t c = 0; c < prologue; ++c) {
            IssueLoad(start, c, c % kSlots);
        }
        SetFlag<HardEvent::MTE3_V>(kEvMte3V);

        for (uint32_t c = 0; c < total; ++c) {
            const uint32_t slot = c % kSlots;
            if (c > 0 && (c + kSlots - 1) < total) {
                WaitFlag<HardEvent::V_MTE2>(kEvVMte2);
                IssueLoad(start, c + kSlots - 1, (c - 1) % kSlots);
            }
            WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(kEvMte2V0 + slot));

            const uint32_t tile = c % kNTile;
            const uint32_t row = start + c / kNTile;
            Phase1(slot, tile);
            SetFlag<HardEvent::V_MTE2>(kEvVMte2);

            if (tile == kNTile - 1) {
                const float scale = ReduceRow();
                Phase2(row, scale);
            }
        }
        for (uint32_t i = 0; i + 1 < kSlots && i + 1 < total; ++i) {
            WaitFlag<HardEvent::V_MTE2>(kEvVMte2);
        }
        WaitFlag<HardEvent::MTE3_V>(kEvMte3V);
    }

private:
    __aicore__ inline void LoadWeight()
    {
        LocalTensor<bfloat16_t> stage = hAll_[0];
        for (uint32_t t = 0; t < kNTile; ++t) {
            DataCopy(stage, weightG_[t * kTile], kTile);
            SetFlag<HardEvent::MTE2_V>(kEvMte2V0);
            WaitFlag<HardEvent::MTE2_V>(kEvMte2V0);
            Cast(wF32_[t * kTile], stage, RoundMode::CAST_NONE, kTile);
            SetFlag<HardEvent::V_MTE2>(kEvVMte2);
            WaitFlag<HardEvent::V_MTE2>(kEvVMte2);
        }
    }

    __aicore__ inline void IssueLoad(uint32_t startRow, uint32_t chunk, uint32_t slot)
    {
        const uint32_t row = startRow + chunk / kNTile;
        const uint32_t tile = chunk % kNTile;
        const uint64_t offset = static_cast<uint64_t>(row) * kHidden + tile * kTile;
        DataCopy(hAll_[slot * kTile], hiddenG_[offset], kTile);
        DataCopy(rAll_[slot * kTile], residualG_[offset], kTile);
        SetFlag<HardEvent::MTE2_V>(static_cast<event_t>(kEvMte2V0 + slot));
    }

    __aicore__ inline void Phase1(uint32_t slot, uint32_t tile)
    {
        if (tile == 0) {
            WaitFlag<HardEvent::MTE3_V>(kEvMte3V);
            Duplicate(acc_, 0.0f, kTile);
        }
        LocalTensor<float> xt = xF32_[tile * kTile];
        Cast(xt, hAll_[slot * kTile], RoundMode::CAST_NONE, kTile);
        Cast(tmp_, rAll_[slot * kTile], RoundMode::CAST_NONE, kTile);
        Add(xt, xt, tmp_, kTile);
        Cast(resRow_[tile * kTile], xt, RoundMode::CAST_RINT, kTile);
        Mul(tmp_, xt, xt, kTile);
        Add(acc_, acc_, tmp_, kTile);
    }

    __aicore__ inline float ReduceRow()
    {
        ReduceSum<float>(red_, acc_, red_, kTile);
        Muls(red_, red_, kInvHidden, kSmall);
        Adds(red_, red_, kEps, kSmall);
        Sqrt(red_, red_, kSmall);
        Reciprocal(red_, red_, kSmall);
        SetFlag<HardEvent::V_S>(kEvVS);
        WaitFlag<HardEvent::V_S>(kEvVS);
        return red_.GetValue(0);
    }

    __aicore__ inline void Phase2(uint32_t row, float scale)
    {
        for (uint32_t t = 0; t < kNTile; ++t) {
            Muls(tmp_, xF32_[t * kTile], scale, kTile);
            Mul(tmp_, tmp_, wF32_[t * kTile], kTile);
            Cast(yRow_[t * kTile], tmp_, RoundMode::CAST_RINT, kTile);
        }
        SetFlag<HardEvent::V_MTE3>(kEvVMte3);
        WaitFlag<HardEvent::V_MTE3>(kEvVMte3);
        const uint64_t base = static_cast<uint64_t>(row) * kHidden;
        for (uint32_t t = 0; t < kNTile; ++t) {
            DataCopy(residualOutG_[base + t * kTile], resRow_[t * kTile], kTile);
            DataCopy(outputG_[base + t * kTile], yRow_[t * kTile], kTile);
        }
        SetFlag<HardEvent::MTE3_V>(kEvMte3V);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> wBuf_;
    TBuf<TPosition::VECCALC> xBuf_;
    TBuf<TPosition::VECCALC> accBuf_;
    TBuf<TPosition::VECCALC> tmpBuf_;
    TBuf<TPosition::VECCALC> hBuf_;
    TBuf<TPosition::VECCALC> rBuf_;
    TBuf<TPosition::VECCALC> resBuf_;
    TBuf<TPosition::VECCALC> yBuf_;
    TBuf<TPosition::VECCALC> redBuf_;

    GlobalTensor<bfloat16_t> hiddenG_;
    GlobalTensor<bfloat16_t> residualG_;
    GlobalTensor<bfloat16_t> weightG_;
    GlobalTensor<bfloat16_t> outputG_;
    GlobalTensor<bfloat16_t> residualOutG_;

    LocalTensor<float> wF32_;
    LocalTensor<float> xF32_;
    LocalTensor<float> acc_;
    LocalTensor<float> tmp_;
    LocalTensor<bfloat16_t> hAll_;
    LocalTensor<bfloat16_t> rAll_;
    LocalTensor<bfloat16_t> resRow_;
    LocalTensor<bfloat16_t> yRow_;
    LocalTensor<float> red_;

    uint32_t tokens_ = 0;
    uint32_t blocks_ = 1;
};

}  // namespace

extern "C" __global__ __aicore__ void fused_add_rmsnorm_kernel(GM_ADDR hidden, GM_ADDR residual,
                                                               GM_ADDR weight, GM_ADDR output,
                                                               GM_ADDR residual_out, uint32_t tokens,
                                                               uint32_t blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    FusedAddRmsNorm op;
    op.Init(hidden, residual, weight, output, residual_out, tokens, blocks);
    op.Process();
}

void kernel(torch::Tensor hidden, torch::Tensor residual, torch::Tensor weight, torch::Tensor output,
            torch::Tensor residual_out)
{
    TORCH_CHECK(hidden.device().type() == c10::DeviceType::PrivateUse1,
                "fused_add_rmsnorm expects NPU tensors");
    const c10::DeviceGuard guard(hidden.device());
    const uint32_t tokens = static_cast<uint32_t>(hidden.size(0));
    if (tokens == 0) {
        return;
    }
    aclrtStream stream = c10_npu::getCurrentNPUStream(hidden.get_device()).stream(true);
    uint32_t blocks = kBlocks;
    if (blocks > tokens) {
        blocks = tokens;
    }
    fused_add_rmsnorm_kernel<<<blocks, nullptr, stream>>>(
        (GM_ADDR)hidden.data_ptr(), (GM_ADDR)residual.data_ptr(), (GM_ADDR)weight.data_ptr(),
        (GM_ADDR)output.data_ptr(), (GM_ADDR)residual_out.data_ptr(), tokens, blocks);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &kernel);
}
