// Fused residual-add + RMSNorm for DeepSeek-V3.2 style decoders.
//
//   s   = fp32(hidden_states) + fp32(residual)
//   res = bf16(s)
//   out = bf16(s * (1/sqrt(mean(s^2) + eps)) * fp32(weight))
//
// Each block owns a contiguous range of rows and walks them one at a time.  A
// row is streamed through the unified buffer in tiles; every transfer and every
// vector batch is fenced by a matched SetFlag/WaitFlag pair, which keeps the
// data path simple and deterministic.  The row itself is held in fp32 so the
// normalisation pass needs no second read of global memory, and the row sum of
// squares is produced by a pairwise vector reduction (no shared scratch).

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <acl/acl.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr uint32_t kHidden = 7168;
constexpr uint32_t kTile = 1024;
constexpr uint32_t kNTile = kHidden / kTile;  // 7
constexpr uint32_t kBlocks = 40;
constexpr uint32_t kSmall = 8;
constexpr float kEps = 1e-6f;
constexpr float kInvHidden = 1.0f / static_cast<float>(kHidden);

constexpr event_t kEvData = EVENT_ID0;   // MTE2 -> V : tile landed in UB
constexpr event_t kEvFree = EVENT_ID0;   // V -> MTE3 : reader finished with the buffer
constexpr event_t kEvOut = EVENT_ID0;    // MTE3 -> V : copy out finished
constexpr event_t kEvScale = EVENT_ID1;  // V -> S : scale value readable

class FusedAddRmsNorm {
public:
    __aicore__ inline FusedAddRmsNorm() {}

    __aicore__ inline void Init(GM_ADDR hidden, GM_ADDR residual, GM_ADDR weight, GM_ADDR output,
                                GM_ADDR residual_out, uint32_t tokens, uint32_t blocks)
    {
        tokens_ = tokens;
        blocks_ = blocks;
        hiddenG_.SetGlobalBuffer((__gm__ bfloat16_t *)hidden, static_cast<uint64_t>(tokens) * kHidden);
        residualG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual, static_cast<uint64_t>(tokens) * kHidden);
        weightG_.SetGlobalBuffer((__gm__ bfloat16_t *)weight, kHidden);
        outputG_.SetGlobalBuffer((__gm__ bfloat16_t *)output, static_cast<uint64_t>(tokens) * kHidden);
        residualOutG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual_out,
                                      static_cast<uint64_t>(tokens) * kHidden);

        pipe_.InitBuffer(wBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(xBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(accBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(tmpBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(hBuf_, kTile * sizeof(bfloat16_t));
        pipe_.InitBuffer(rBuf_, kTile * sizeof(bfloat16_t));
        pipe_.InitBuffer(resBuf_, kTile * sizeof(bfloat16_t));
        pipe_.InitBuffer(yBuf_, kTile * sizeof(bfloat16_t));
        pipe_.InitBuffer(redBuf_, 32);

        wF32_ = wBuf_.Get<float>();
        xF32_ = xBuf_.Get<float>();
        acc_ = accBuf_.Get<float>();
        tmp_ = tmpBuf_.Get<float>();
        hT_ = hBuf_.Get<bfloat16_t>();
        rT_ = rBuf_.Get<bfloat16_t>();
        resT_ = resBuf_.Get<bfloat16_t>();
        yT_ = yBuf_.Get<bfloat16_t>();
        red_ = redBuf_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        if (tokens_ == 0) {
            return;
        }
        const uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        const uint32_t rowsPerBlock = (tokens_ + blocks_ - 1) / blocks_;
        const uint32_t start = blockIdx * rowsPerBlock;
        if (start >= tokens_) {
            return;
        }
        uint32_t end = start + rowsPerBlock;
        if (end > tokens_) {
            end = tokens_;
        }
        LoadWeight();
        for (uint32_t row = start; row < end; ++row) {
            Duplicate(acc_, 0.0f, kTile);
            NormalizeRow(row);
        }
    }

private:
    // Weight is read once per block and kept in fp32 for the second pass.
    __aicore__ inline void LoadWeight()
    {
        for (uint32_t t = 0; t < kNTile; ++t) {
            DataCopy(hT_, weightG_[t * kTile], kTile);
            SetFlag<HardEvent::MTE2_V>(kEvData);
            WaitFlag<HardEvent::MTE2_V>(kEvData);
            Cast(wF32_[t * kTile], hT_, RoundMode::CAST_NONE, kTile);
            SetFlag<HardEvent::V_MTE3>(kEvFree);
            WaitFlag<HardEvent::V_MTE3>(kEvFree);
        }
    }

    __aicore__ inline void NormalizeRow(uint32_t row)
    {
        const uint64_t base = static_cast<uint64_t>(row) * kHidden;
        for (uint32_t t = 0; t < kNTile; ++t) {
            const uint64_t offset = base + t * kTile;
            DataCopy(hT_, hiddenG_[offset], kTile);
            DataCopy(rT_, residualG_[offset], kTile);
            SetFlag<HardEvent::MTE2_V>(kEvData);
            WaitFlag<HardEvent::MTE2_V>(kEvData);

            LocalTensor<float> x = xF32_[t * kTile];
            Cast(x, hT_, RoundMode::CAST_NONE, kTile);
            Cast(tmp_, rT_, RoundMode::CAST_NONE, kTile);
            Add(x, x, tmp_, kTile);
            Cast(resT_, x, RoundMode::CAST_RINT, kTile);

            SetFlag<HardEvent::V_MTE3>(kEvFree);
            WaitFlag<HardEvent::V_MTE3>(kEvFree);
            DataCopy(residualOutG_[offset], resT_, kTile);
            SetFlag<HardEvent::MTE3_V>(kEvOut);
            WaitFlag<HardEvent::MTE3_V>(kEvOut);

            Mul(tmp_, x, x, kTile);
            Add(acc_, acc_, tmp_, kTile);
        }
        const float scale = RowScale();
        for (uint32_t t = 0; t < kNTile; ++t) {
            const uint64_t offset = base + t * kTile;
            Muls(tmp_, xF32_[t * kTile], scale, kTile);
            Mul(tmp_, tmp_, wF32_[t * kTile], kTile);
            Cast(yT_, tmp_, RoundMode::CAST_RINT, kTile);

            SetFlag<HardEvent::V_MTE3>(kEvFree);
            WaitFlag<HardEvent::V_MTE3>(kEvFree);
            DataCopy(outputG_[offset], yT_, kTile);
            SetFlag<HardEvent::MTE3_V>(kEvOut);
            WaitFlag<HardEvent::MTE3_V>(kEvOut);
        }
    }

    // Pairwise reduction of the tile accumulator, then 1 / sqrt(mean + eps).
    __aicore__ inline float RowScale()
    {
        uint32_t span = kTile >> 1;
        while (span >= kSmall) {
            Add(acc_, acc_, acc_[span], span);
            span >>= 1;
        }
        while (span > 0) {
            Add(acc_, acc_, acc_[span], span);
            span >>= 1;
        }
        Muls(acc_, acc_, kInvHidden, kSmall);
        Adds(acc_, acc_, kEps, kSmall);
        Sqrt(acc_, acc_, kSmall);
        Reciprocal(acc_, acc_, kSmall);
        SetFlag<HardEvent::V_S>(kEvScale);
        WaitFlag<HardEvent::V_S>(kEvScale);
        return acc_.GetValue(0);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> wBuf_;
    TBuf<TPosition::VECCALC> xBuf_;
    TBuf<TPosition::VECCALC> accBuf_;
    TBuf<TPosition::VECCALC> tmpBuf_;
    TBuf<TPosition::VECCALC> hBuf_;
    TBuf<TPosition::VECCALC> rBuf_;
    TBuf<TPosition::VECCALC> resBuf_;
    TBuf<TPosition::VECCALC> yBuf_;
    TBuf<TPosition::VECCALC> redBuf_;

    GlobalTensor<bfloat16_t> hiddenG_;
    GlobalTensor<bfloat16_t> residualG_;
    GlobalTensor<bfloat16_t> weightG_;
    GlobalTensor<bfloat16_t> outputG_;
    GlobalTensor<bfloat16_t> residualOutG_;

    LocalTensor<float> wF32_;
    LocalTensor<float> xF32_;
    LocalTensor<float> acc_;
    LocalTensor<float> tmp_;
    LocalTensor<bfloat16_t> hT_;
    LocalTensor<bfloat16_t> rT_;
    LocalTensor<bfloat16_t> resT_;
    LocalTensor<bfloat16_t> yT_;
    LocalTensor<float> red_;

    uint32_t tokens_ = 0;
    uint32_t blocks_ = 1;
};

}  // namespace

extern "C" __global__ __aicore__ void fused_add_rmsnorm_kernel(GM_ADDR hidden, GM_ADDR residual,
                                                              GM_ADDR weight, GM_ADDR output,
                                                              GM_ADDR residual_out, uint32_t tokens,
                                                              uint32_t blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    FusedAddRmsNorm op;
    op.Init(hidden, residual, weight, output, residual_out, tokens, blocks);
    op.Process();
}

void kernel(torch::Tensor hidden, torch::Tensor residual, torch::Tensor weight, torch::Tensor output,
            torch::Tensor residual_out)
{
    TORCH_CHECK(hidden.device().type() == c10::DeviceType::PrivateUse1,
                "fused_add_rmsnorm expects NPU tensors");
    const c10::DeviceGuard guard(hidden.device());
    const uint32_t tokens = static_cast<uint32_t>(hidden.size(0));
    if (tokens == 0) {
        return;
    }
    aclrtStream stream = c10_npu::getCurrentNPUStream(hidden.get_device()).stream(true);
    uint32_t blocks = kBlocks;
    if (blocks > tokens) {
        blocks = tokens;
    }
    fused_add_rmsnorm_kernel<<<blocks, nullptr, stream>>>(
        (GM_ADDR)hidden.data_ptr(), (GM_ADDR)residual.data_ptr(), (GM_ADDR)weight.data_ptr(),
        (GM_ADDR)output.data_ptr(), (GM_ADDR)residual_out.data_ptr(), tokens, blocks);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &kernel);
}
