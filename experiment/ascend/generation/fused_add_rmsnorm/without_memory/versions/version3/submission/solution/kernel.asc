// Fused residual-add + RMSNorm (DeepSeek-V3.2 style decoder boundary).
//
//   s   = fp32(hidden_states) + fp32(residual)
//   res = bf16(s)
//   out = bf16(s * (1/sqrt(mean(s^2) + eps)) * fp32(weight))
//
// One row is held in fp32 in the unified buffer, so the normalisation pass needs
// no second read of global memory.  Every buffer is single-buffered and fenced
// with matched SetFlag/WaitFlag pairs, including the write-after-read fences
// (V->MTE2, MTE3->V, S->V) that keep the asynchronous pipes off each other's
// buffers.  The row sum of squares is a pairwise vector reduction over a
// power-of-two padded span, finished on the scalar unit.

#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <acl/acl.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr uint32_t kHidden = 7168;
constexpr uint32_t kRedLen = 8192;              // kHidden padded to a power of two
constexpr uint32_t kRedStop = 32;               // tree tail read on the scalar unit
constexpr uint32_t kScaleVec = 8;               // one 32B fp32 vector block
constexpr uint32_t kBlocks = 40;
constexpr float kEps = 1e-6f;
constexpr float kInvHidden = 1.0f / static_cast<float>(kHidden);

constexpr event_t kEvIn = EVENT_ID0;       // V   -> MTE2 : h/r staging free
constexpr event_t kEvLanded = EVENT_ID2;   // MTE2-> V    : tiles landed in UB
constexpr event_t kEvResReady = EVENT_ID0; // V   -> MTE3 : residual_out ready
constexpr event_t kEvResFree = EVENT_ID0;  // MTE3-> V    : residual_out copied
constexpr event_t kEvOutReady = EVENT_ID1; // V   -> MTE3 : output ready
constexpr event_t kEvOutFree = EVENT_ID1;  // MTE3-> V    : output copied
constexpr event_t kEvScale = EVENT_ID1;    // V   -> S    : sums visible
constexpr event_t kEvScalar = EVENT_ID2;   // S   -> V    : scalar reads done
constexpr event_t kEvScalar2 = EVENT_ID3;  // S   -> V    : scale register ready

class FusedAddRmsNorm {
public:
    __aicore__ inline FusedAddRmsNorm() {}

    __aicore__ inline void Init(GM_ADDR hidden, GM_ADDR residual, GM_ADDR weight, GM_ADDR output,
                                GM_ADDR residual_out, uint32_t tokens, uint32_t blocks)
    {
        tokens_ = tokens;
        blocks_ = blocks;
        hiddenG_.SetGlobalBuffer((__gm__ bfloat16_t *)hidden, static_cast<uint64_t>(tokens) * kHidden);
        residualG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual, static_cast<uint64_t>(tokens) * kHidden);
        weightG_.SetGlobalBuffer((__gm__ bfloat16_t *)weight, kHidden);
        outputG_.SetGlobalBuffer((__gm__ bfloat16_t *)output, static_cast<uint64_t>(tokens) * kHidden);
        residualOutG_.SetGlobalBuffer((__gm__ bfloat16_t *)residual_out,
                                      static_cast<uint64_t>(tokens) * kHidden);

        pipe_.InitBuffer(hBuf_, kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(rBuf_, kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(xBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(wBuf_, kHidden * sizeof(float));
        pipe_.InitBuffer(tBuf_, kRedLen * sizeof(float));
        pipe_.InitBuffer(yBuf_, kHidden * sizeof(bfloat16_t));
        pipe_.InitBuffer(redBuf_, kScaleVec * sizeof(float));

        hT_ = hBuf_.Get<bfloat16_t>();
        rT_ = rBuf_.Get<bfloat16_t>();
        xF_ = xBuf_.Get<float>();
        wF_ = wBuf_.Get<float>();
        tF_ = tBuf_.Get<float>();
        yT_ = yBuf_.Get<bfloat16_t>();
        red_ = redBuf_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        if (tokens_ == 0) {
            return;
        }
        const uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        const uint32_t rowsPerBlock = (tokens_ + blocks_ - 1) / blocks_;
        const uint32_t start = blockIdx * rowsPerBlock;
        if (start >= tokens_) {
            return;
        }
        uint32_t end = start + rowsPerBlock;
        if (end > tokens_) {
            end = tokens_;
        }
        LoadWeight();
        // hT_ holds the weight tile until now; release it for the row pipeline.
        SetFlag<HardEvent::V_MTE2>(kEvIn);
        for (uint32_t row = start; row < end; ++row) {
            ProcessRow(row);
        }
        WaitFlag<HardEvent::V_MTE2>(kEvIn);
    }

private:
    __aicore__ inline void LoadWeight()
    {
        DataCopy(hT_, weightG_[0], kHidden);
        SetFlag<HardEvent::MTE2_V>(kEvLanded);
        WaitFlag<HardEvent::MTE2_V>(kEvLanded);
        Cast(wF_, hT_, RoundMode::CAST_NONE, kHidden);
    }

    __aicore__ inline void StoreBf16(const GlobalTensor<bfloat16_t>& dst, uint64_t base,
                                     event_t ready, event_t free_ev)
    {
        SetFlag<HardEvent::V_MTE3>(ready);
        WaitFlag<HardEvent::V_MTE3>(ready);
        DataCopy(dst[base], yT_, kHidden);
        SetFlag<HardEvent::MTE3_V>(free_ev);
        WaitFlag<HardEvent::MTE3_V>(free_ev);
    }

    __aicore__ inline void ProcessRow(uint32_t row)
    {
        const uint64_t base = static_cast<uint64_t>(row) * kHidden;

        WaitFlag<HardEvent::V_MTE2>(kEvIn);
        DataCopy(hT_, hiddenG_[base], kHidden);
        DataCopy(rT_, residualG_[base], kHidden);
        SetFlag<HardEvent::MTE2_V>(kEvLanded);
        WaitFlag<HardEvent::MTE2_V>(kEvLanded);

        Cast(xF_, hT_, RoundMode::CAST_NONE, kHidden);
        Cast(tF_, rT_, RoundMode::CAST_NONE, kHidden);
        Add(xF_, xF_, tF_, kHidden);
        SetFlag<HardEvent::V_MTE2>(kEvIn);  // hT_/rT_ consumed by the vector pipe

        Cast(yT_, xF_, RoundMode::CAST_RINT, kHidden);
        StoreBf16(residualOutG_, base, kEvResReady, kEvResFree);

        // Row sum of squares, reduced on a power-of-two span so every vector
        // operation is a full, 32B aligned block.
        Mul(tF_, xF_, xF_, kHidden);
        Duplicate(tF_[kHidden], 0.0f, kRedLen - kHidden);
        for (uint32_t span = kRedLen >> 1; span >= kRedStop; span >>= 1) {
            Add(tF_, tF_, tF_[span], span);
        }
        SetFlag<HardEvent::V_S>(kEvScale);
        WaitFlag<HardEvent::V_S>(kEvScale);
        float total = 0.0f;
        for (uint32_t i = 0; i < kRedStop; ++i) {
            total += tF_.GetValue(i);
        }
        SetFlag<HardEvent::S_V>(kEvScalar);
        WaitFlag<HardEvent::S_V>(kEvScalar);

        Duplicate(red_, total * kInvHidden + kEps, kScaleVec);
        Sqrt(red_, red_, kScaleVec);
        Reciprocal(red_, red_, kScaleVec);
        SetFlag<HardEvent::V_S>(kEvScale);
        WaitFlag<HardEvent::V_S>(kEvScale);
        const float scale = red_.GetValue(0);
        SetFlag<HardEvent::S_V>(kEvScalar2);
        WaitFlag<HardEvent::S_V>(kEvScalar2);

        Muls(tF_, xF_, scale, kHidden);
        Mul(tF_, tF_, wF_, kHidden);
        Cast(yT_, tF_, RoundMode::CAST_RINT, kHidden);
        StoreBf16(outputG_, base, kEvOutReady, kEvOutFree);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> hBuf_;
    TBuf<TPosition::VECCALC> rBuf_;
    TBuf<TPosition::VECCALC> xBuf_;
    TBuf<TPosition::VECCALC> wBuf_;
    TBuf<TPosition::VECCALC> tBuf_;
    TBuf<TPosition::VECCALC> yBuf_;
    TBuf<TPosition::VECCALC> redBuf_;

    GlobalTensor<bfloat16_t> hiddenG_;
    GlobalTensor<bfloat16_t> residualG_;
    GlobalTensor<bfloat16_t> weightG_;
    GlobalTensor<bfloat16_t> outputG_;
    GlobalTensor<bfloat16_t> residualOutG_;

    LocalTensor<bfloat16_t> hT_;
    LocalTensor<bfloat16_t> rT_;
    LocalTensor<float> xF_;
    LocalTensor<float> wF_;
    LocalTensor<float> tF_;
    LocalTensor<bfloat16_t> yT_;
    LocalTensor<float> red_;

    uint32_t tokens_ = 0;
    uint32_t blocks_ = 1;
};

}  // namespace

extern "C" __global__ __aicore__ void fused_add_rmsnorm_kernel(GM_ADDR hidden, GM_ADDR residual,
                                                              GM_ADDR weight, GM_ADDR output,
                                                              GM_ADDR residual_out, uint32_t tokens,
                                                              uint32_t blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    FusedAddRmsNorm op;
    op.Init(hidden, residual, weight, output, residual_out, tokens, blocks);
    op.Process();
}

void kernel(torch::Tensor hidden, torch::Tensor residual, torch::Tensor weight, torch::Tensor output,
            torch::Tensor residual_out)
{
    TORCH_CHECK(hidden.device().type() == c10::DeviceType::PrivateUse1,
                "fused_add_rmsnorm expects NPU tensors");
    const c10::DeviceGuard guard(hidden.device());
    const uint32_t tokens = static_cast<uint32_t>(hidden.size(0));
    if (tokens == 0) {
        return;
    }
    aclrtStream stream = c10_npu::getCurrentNPUStream(hidden.get_device()).stream(true);
    uint32_t blocks = kBlocks;
    if (blocks > tokens) {
        blocks = tokens;
    }
    fused_add_rmsnorm_kernel<<<blocks, nullptr, stream>>>(
        (GM_ADDR)hidden.data_ptr(), (GM_ADDR)residual.data_ptr(), (GM_ADDR)weight.data_ptr(),
        (GM_ADDR)output.data_ptr(), (GM_ADDR)residual_out.data_ptr(), tokens, blocks);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &kernel);
}
