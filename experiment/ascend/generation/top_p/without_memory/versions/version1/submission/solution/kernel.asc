// top_p (top_p_renorm_probs) for Ascend 910B1, AscendC.
//
// Per row: find the exact cutoff value with a monotone bisection over the
// float32 bit pattern (monotone for non-negative floats), then write
// (p >= cutoff) ? p / sum : 0.  Sums use Kahan compensation because the
// retained set is decided by comparing a sum against top_p and the margin
// between neighbouring candidate cutoffs can be far below fp32 epsilon.
#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <vector>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "acl/acl.h"
#include "ascendc/basic_api/kernel_operator.h"

using namespace AscendC;

constexpr int32_t kTile = 4096;
constexpr int32_t kLanes = 4096;

__aicore__ inline void WaitVectorToScalar()
{
    event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
    SetFlag<HardEvent::V_S>(eventId);
    WaitFlag<HardEvent::V_S>(eventId);
}

__aicore__ inline uint32_t FloatToKey(float v)
{
    return *reinterpret_cast<uint32_t *>(&v);
}

__aicore__ inline float KeyToFloat(uint32_t k)
{
    return *reinterpret_cast<float *>(&k);
}

class TopPOp {
public:
    __aicore__ inline TopPOp() {}

    __aicore__ inline void Init(GM_ADDR probs, GM_ADDR topP, GM_ADDR out, uint32_t cols)
    {
        this->row = GetBlockIdx();
        this->cols = cols;
        this->nTiles = (int32_t)((cols + kTile - 1) / kTile);
        xGm.SetGlobalBuffer((__gm__ float *)probs + (uint64_t)this->row * cols, cols);
        oGm.SetGlobalBuffer((__gm__ float *)out + (uint64_t)this->row * cols, cols);
        tpGm.SetGlobalBuffer((__gm__ float *)topP + this->row, 1);
        pipe.InitBuffer(inQ, 2, kTile * sizeof(float));
        pipe.InitBuffer(outQ, 2, kTile * sizeof(float));
        pipe.InitBuffer(accBuf, kLanes * sizeof(float));
        pipe.InitBuffer(cmpBuf, kLanes * sizeof(float));
        pipe.InitBuffer(t1Buf, kLanes * sizeof(float));
        pipe.InitBuffer(t2Buf, kLanes * sizeof(float));
        pipe.InitBuffer(zeroBuf, kLanes * sizeof(float));
        pipe.InitBuffer(maskBuf, kTile / 8 + 64);
    }

    __aicore__ inline void Process()
    {
        float threshold = tpGm.GetValue(0);
        Duplicate(zeroBuf.Get<float>(), (float)0, kLanes);
        PipeBarrier<PIPE_ALL>();

        uint32_t loKey = 0u;             // cutoff candidate, sum >= threshold
        uint32_t hiKey = 0x3F800000u;    // 1.0f: no element qualifies
        float loSum = 0.0f;
        for (int32_t it = 0; it < 32; ++it) {
            if (hiKey - loKey <= 1u) {
                break;
            }
            uint32_t midKey = loKey + ((hiKey - loKey) >> 1);
            float s = SumAbove(KeyToFloat(midKey));
            if (s >= threshold) {
                loKey = midKey;
                loSum = s;
            } else {
                hiKey = midKey;
            }
        }
        if (loSum <= 0.0f) {
            loSum = SumAbove(KeyToFloat(loKey));
        }
        WriteOut(KeyToFloat(loKey), 1.0f / loSum);
    }

private:
    __aicore__ inline float SumAbove(float t)
    {
        LocalTensor<float> acc = accBuf.Get<float>();
        LocalTensor<float> cmp = cmpBuf.Get<float>();
        LocalTensor<float> t1 = t1Buf.Get<float>();
        LocalTensor<float> t2 = t2Buf.Get<float>();
        LocalTensor<float> zero = zeroBuf.Get<float>();
        LocalTensor<uint8_t> mask = maskBuf.Get<uint8_t>();
        Duplicate(acc, (float)0, kLanes);
        Duplicate(cmp, (float)0, kLanes);
        for (int32_t tile = 0; tile < nTiles; ++tile) {
            int32_t off = tile * kTile;
            int32_t cnt = cols - off;
            if (cnt > kTile) {
                cnt = kTile;
            }
            LocalTensor<float> x = inQ.AllocTensor<float>();
            DataCopy(x, xGm[off], cnt);
            inQ.EnQue(x);
            x = inQ.DeQue<float>();
            Compares(mask, x, t, CMPMODE::GE, (uint32_t)cnt);
            Select(t1, mask, x, zero, SELMODE::VSEL_TENSOR_TENSOR_MODE, (uint32_t)cnt);
            // Kahan: y = t1, s = acc + (y - cmp), cmp = (s - acc) - (y - cmp)
            Sub(t2, t1, cmp, (uint32_t)cnt);
            Add(t1, acc, t2, (uint32_t)cnt);
            Sub(cmp, t1, acc, (uint32_t)cnt);
            Sub(cmp, cmp, t2, (uint32_t)cnt);
            DataCopy(acc, t1, (uint32_t)cnt);
            inQ.FreeTensor(x);
        }
        return TreeSum(acc, cmp, t1, t2);
    }

    // Compensated pairwise reduction of the lane accumulators.  Vector ops
    // need 32-byte aligned UB addresses, so the last 8 lanes go scalar.
    __aicore__ inline float TreeSum(LocalTensor<float> &acc, LocalTensor<float> &cmp,
                                    LocalTensor<float> &t1, LocalTensor<float> &t2)
    {
        int32_t len = kLanes;
        while (len > 8) {
            int32_t half = len >> 1;
            Max(t1, acc, acc[half], half);
            Min(t2, acc, acc[half], half);
            Add(acc, t1, t2, half);          // acc = s
            Sub(t1, t1, acc, half);          // t1 = hi - s
            Add(t1, t1, t2, half);           // t1 = exact rounding error
            Add(cmp, cmp, cmp[half], half);
            Add(cmp, cmp, t1, half);
            len = half;
        }
        WaitVectorToScalar();
        float s = 0.0f;
        float e = 0.0f;
        for (int32_t i = 0; i < 8; ++i) {
            float v = acc.GetValue(i) + cmp.GetValue(i);
            float y = v - e;
            float t = s + y;
            e = (t - s) - y;
            s = t;
        }
        return s;
    }

    __aicore__ inline void WriteOut(float cutoff, float scale)
    {
        LocalTensor<float> t1 = t1Buf.Get<float>();
        LocalTensor<float> zero = zeroBuf.Get<float>();
        LocalTensor<uint8_t> mask = maskBuf.Get<uint8_t>();
        for (int32_t tile = 0; tile < nTiles; ++tile) {
            int32_t off = tile * kTile;
            int32_t cnt = cols - off;
            if (cnt > kTile) {
                cnt = kTile;
            }
            LocalTensor<float> x = inQ.AllocTensor<float>();
            DataCopy(x, xGm[off], cnt);
            inQ.EnQue(x);
            x = inQ.DeQue<float>();
            Compares(mask, x, cutoff, CMPMODE::GE, (uint32_t)cnt);
            Select(t1, mask, x, zero, SELMODE::VSEL_TENSOR_TENSOR_MODE, (uint32_t)cnt);
            Muls(t1, t1, scale, (uint32_t)cnt);
            LocalTensor<float> y = outQ.AllocTensor<float>();
            DataCopy(y, t1, (uint32_t)cnt);
            outQ.EnQue(y);
            y = outQ.DeQue<float>();
            DataCopy(oGm[off], y, (uint32_t)cnt);
            outQ.FreeTensor(y);
            inQ.FreeTensor(x);
        }
    }

    TPipe pipe;
    TQue<TPosition::VECIN, 2> inQ;
    TQue<TPosition::VECOUT, 2> outQ;
    TBuf<TPosition::VECCALC> accBuf, cmpBuf, t1Buf, t2Buf, zeroBuf, maskBuf;
    GlobalTensor<float> xGm, oGm, tpGm;
    int32_t row;
    int32_t cols;
    int32_t nTiles;
};

__global__ __aicore__ void top_p_kernel(GM_ADDR probs, GM_ADDR topP, GM_ADDR out, uint32_t rows, uint32_t cols)
{
    TopPOp op;
    op.Init(probs, topP, out, cols);
    op.Process();
}

void kernel(const torch::Tensor &probs, const torch::Tensor &topP, torch::Tensor out)
{
    const c10::DeviceGuard guard(probs.device());
    aclrtStream stream = c10_npu::getCurrentNPUStream(probs.get_device()).stream(true);
    uint32_t rows = (uint32_t)probs.size(0);
    uint32_t cols = (uint32_t)probs.size(1);
    top_p_kernel<<<rows, nullptr, stream>>>(
        (uint8_t *)probs.data_ptr<float>(), (uint8_t *)topP.data_ptr<float>(),
        (uint8_t *)out.data_ptr<float>(), rows, cols);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module)
{
    module.def("kernel", &kernel);
}
