// top_p (top_p_renorm_probs) for Ascend 910B1, AscendC.
//
// probs : float32 [B, V] row-major (B = 32, V = 128256)
// top_p : float32 [B]
// out   : float32 [B, V]
//
// Reference semantics (torch):
//   ordered = sort(probs, desc); cumulative sum in fp64; idx = first i with
//   cumsum[i] >= top_p; cutoff = ordered[idx];
//   out = where(probs >= cutoff, probs, 0) / sum.
//
// The cutoff is exactly the largest row value v with S(v) = sum(x >= v) >= top_p,
// since S(ordered[i]) == cumsum[i].  For non-negative floats the IEEE bit
// pattern is monotone in the value, so bisecting on the *bits* of a threshold
// yields the exact fp32 cutoff: the accepted key is the bit pattern of a value
// present in the row, and {bits(x) >= bits(cutoff)} == {x >= cutoff}.
//
// One AI core per row; every round re-reads the row and evaluates S at a few
// probe keys.  Lane accumulation is fp32 (the vector unit has no fp64), but the
// lane partials are combined in fp64 on the scalar unit, which the numerical
// margin (~1e-7 around the 0.9 budget) requires.
#include <torch/extension.h>
#include <c10/core/DeviceGuard.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include <acl/acl.h>
#include "kernel_operator.h"

using namespace AscendC;

namespace {
constexpr uint32_t kRows = 32;
constexpr uint32_t kCols = 128256;
constexpr uint32_t kTile = 2048;
constexpr uint32_t kFullTiles = kCols / kTile;          // 62
constexpr uint32_t kTail = kCols - kFullTiles * kTile;  // 1280
constexpr uint32_t kProbes = 2;                         // probe keys per round
constexpr uint32_t kLanes = 64;                         // fp32 lanes -> fp64 finish
constexpr uint32_t kKeyHi = 0x7F800000u;                // +inf
constexpr uint32_t kMaskStride = kTile / 8 + 32;

__aicore__ inline float KeyToFloat(uint32_t key) {
    union { uint32_t u; float f; } cvt;
    cvt.u = key;
    return cvt.f;
}
}  // namespace

extern "C" __global__ __aicore__ void top_p_kernel(GM_ADDR probs, GM_ADDR topP, GM_ADDR out) {
    TPipe pipe;
    TQue<TPosition::VECIN, 2> inQue;
    TQue<TPosition::VECIN, 1> tailQue;
    TQue<TPosition::VECOUT, 2> outQue;
    TQue<TPosition::VECOUT, 1> tailOutQue;
    TBuf<TPosition::VECCALC> maskBuf;
    TBuf<TPosition::VECCALC> selBuf;
    TBuf<TPosition::VECCALC> zeroBuf;
    TBuf<TPosition::VECCALC> accBuf;
    pipe.InitBuffer(inQue, 2, kTile * sizeof(float));
    pipe.InitBuffer(tailQue, 1, kTail * sizeof(float));
    pipe.InitBuffer(outQue, 2, kTile * sizeof(float));
    pipe.InitBuffer(tailOutQue, 1, kTail * sizeof(float));
    pipe.InitBuffer(maskBuf, kMaskStride * kProbes);
    pipe.InitBuffer(selBuf, kTile * sizeof(float));
    pipe.InitBuffer(zeroBuf, kTile * sizeof(float));
    pipe.InitBuffer(accBuf, kTile * sizeof(float) * kProbes);

    LocalTensor<uint8_t> masks = maskBuf.Get<uint8_t>();
    LocalTensor<float> sel = selBuf.Get<float>();
    LocalTensor<float> zero = zeroBuf.Get<float>();
    LocalTensor<float> acc = accBuf.Get<float>();
    Duplicate(zero, 0.0f, kTile);
    PipeBarrier<PIPE_V>();

    GlobalTensor<float> xG;
    GlobalTensor<float> pG;
    GlobalTensor<float> oG;
    xG.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(probs), (uint64_t)kRows * kCols);
    pG.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(topP), kRows);
    oG.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(out), (uint64_t)kRows * kCols);

    const uint32_t blockNum = GetBlockNum();
    for (uint32_t row = GetBlockIdx(); row < kRows; row += blockNum) {
        const uint64_t base = (uint64_t)row * kCols;
        const float top = pG.GetValue(row);

        uint32_t lo = 0;       // key with S(lo) >= top
        uint32_t hi = kKeyHi;  // key with S(hi) < top
        float best = 0.0f;     // S(lo)

        while (hi - lo > 1u) {
            const uint32_t span = hi - lo;
            const bool binary = span <= kProbes;
            const uint32_t probeCount = binary ? 1u : kProbes;
            uint32_t keys[kProbes];
            for (uint32_t j = 0; j < probeCount; ++j) {
                keys[j] = binary ? (lo + span / 2u)
                                 : (lo + (uint32_t)(((uint64_t)span * (j + 1u)) / (kProbes + 1u)));
            }

            for (uint32_t j = 0; j < probeCount; ++j) {
                Duplicate(acc[j * kTile], 0.0f, kTile);
            }
            PipeBarrier<PIPE_V>();

            for (uint32_t t = 0; t < kFullTiles; ++t) {
                LocalTensor<float> x = inQue.AllocTensor<float>();
                DataCopy(x, xG[base + t * kTile], kTile);
                inQue.EnQue(x);
                LocalTensor<float> xv = inQue.DeQue<float>();
                for (uint32_t j = 0; j < probeCount; ++j) {
                    LocalTensor<uint8_t> mk = masks[j * kMaskStride];
                    Compares(mk, xv, KeyToFloat(keys[j]), CMPMODE::GE, kTile);
                    Select(sel, mk, xv, zero, SELMODE::VSEL_TENSOR_TENSOR_MODE, kTile);
                    Add(acc[j * kTile], acc[j * kTile], sel, kTile);
                }
                inQue.FreeTensor(xv);
            }
            {
                LocalTensor<float> x = tailQue.AllocTensor<float>();
                DataCopy(x, xG[base + kFullTiles * kTile], kTail);
                tailQue.EnQue(x);
                LocalTensor<float> xv = tailQue.DeQue<float>();
                for (uint32_t j = 0; j < probeCount; ++j) {
                    LocalTensor<uint8_t> mk = masks[j * kMaskStride];
                    Compares(mk, xv, KeyToFloat(keys[j]), CMPMODE::GE, kTail);
                    Select(sel, mk, xv, zero, SELMODE::VSEL_TENSOR_TENSOR_MODE, kTail);
                    Add(acc[j * kTile], acc[j * kTile], sel, kTail);
                }
                tailQue.FreeTensor(xv);
            }

            // The lane partials are combined with Neumaier compensation: the
            // vector unit has no fp64 and the decision margin around the 0.9
            // budget is ~1e-7, so a plain fp32 combine picks the wrong key.
            float sumBest[kProbes];
            bool sumOk[kProbes];
            for (uint32_t j = 0; j < probeCount; ++j) {
                LocalTensor<float> a = acc[j * kTile];
                uint32_t n = kTile;
                while (n > kLanes) {
                    n >>= 1;
                    Add(a, a, a[n], n);
                    PipeBarrier<PIPE_V>();
                }
                event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
                SetFlag<HardEvent::V_S>(ev);
                WaitFlag<HardEvent::V_S>(ev);
                float hiS = 0.0f;
                float loS = 0.0f;
                for (uint32_t i = 0; i < kLanes; ++i) {
                    const float v = a.GetValue(i);
                    const float s = hiS + v;
                    loS += (hiS >= v) ? ((hiS - s) + v) : ((v - s) + hiS);
                    hiS = s;
                }
                // (hiS + loS) >= top tested exactly: top - hiS is exact here.
                sumOk[j] = (loS >= (top - hiS));
                sumBest[j] = hiS + loS;
            }

            int32_t lastGood = -1;
            for (uint32_t j = 0; j < probeCount; ++j) {
                if (sumOk[j]) {
                    lastGood = (int32_t)j;
                }
            }
            if (lastGood == (int32_t)probeCount - 1) {
                lo = keys[probeCount - 1];
                best = sumBest[probeCount - 1];
            } else if (lastGood >= 0) {
                lo = keys[lastGood];
                best = sumBest[lastGood];
                hi = keys[lastGood + 1];
            } else {
                hi = keys[0];
            }
        }

        const float cutoff = KeyToFloat(lo);
        const float scale = (best > 0.0f) ? (1.0f / best) : 0.0f;
        for (uint32_t t = 0; t < kFullTiles; ++t) {
            LocalTensor<float> x = inQue.AllocTensor<float>();
            DataCopy(x, xG[base + t * kTile], kTile);
            inQue.EnQue(x);
            LocalTensor<float> xv = inQue.DeQue<float>();
            LocalTensor<float> o = outQue.AllocTensor<float>();
            Compares(masks, xv, cutoff, CMPMODE::GE, kTile);
            Select(o, masks, xv, zero, SELMODE::VSEL_TENSOR_TENSOR_MODE, kTile);
            Muls(o, o, scale, kTile);
            outQue.EnQue(o);
            LocalTensor<float> ov = outQue.DeQue<float>();
            DataCopy(oG[base + t * kTile], ov, kTile);
            outQue.FreeTensor(ov);
            inQue.FreeTensor(xv);
        }
        {
            LocalTensor<float> x = tailQue.AllocTensor<float>();
            DataCopy(x, xG[base + kFullTiles * kTile], kTail);
            tailQue.EnQue(x);
            LocalTensor<float> xv = tailQue.DeQue<float>();
            LocalTensor<float> o = tailOutQue.AllocTensor<float>();
            Compares(masks, xv, cutoff, CMPMODE::GE, kTail);
            Select(o, masks, xv, zero, SELMODE::VSEL_TENSOR_TENSOR_MODE, kTail);
            Muls(o, o, scale, kTail);
            tailOutQue.EnQue(o);
            LocalTensor<float> ov = tailOutQue.DeQue<float>();
            DataCopy(oG[base + kFullTiles * kTile], ov, kTail);
            tailOutQue.FreeTensor(ov);
            tailQue.FreeTensor(xv);
        }
    }
}

static void launch_top_p(torch::Tensor probs, torch::Tensor topP, torch::Tensor out) {
    TORCH_CHECK(probs.scalar_type() == at::kFloat && topP.scalar_type() == at::kFloat &&
                    out.scalar_type() == at::kFloat,
                "top_p: float32 tensors required");
    TORCH_CHECK(probs.dim() == 2 && probs.size(0) == (int64_t)kRows && probs.size(1) == (int64_t)kCols,
                "top_p: probs must be [32, 128256]");
    TORCH_CHECK(topP.dim() == 1 && topP.numel() == (int64_t)kRows, "top_p: top_p must be [32]");
    TORCH_CHECK(out.sizes() == probs.sizes(), "top_p: out shape mismatch");
    TORCH_CHECK(probs.is_contiguous() && topP.is_contiguous() && out.is_contiguous(),
                "top_p: contiguous tensors required");
    TORCH_CHECK(probs.device() == topP.device() && probs.device() == out.device(),
                "top_p: tensors on different devices");
    c10::DeviceGuard guard(probs.device());
    aclrtStream stream = c10_npu::getCurrentNPUStream(probs.get_device()).stream(true);
    top_p_kernel<<<kRows, nullptr, stream>>>((GM_ADDR)probs.data_ptr<float>(),
                                             (GM_ADDR)topP.data_ptr<float>(),
                                             (GM_ADDR)out.data_ptr<float>());
}

// __TEST_HOOKS__
PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("kernel", &launch_top_p);
}
