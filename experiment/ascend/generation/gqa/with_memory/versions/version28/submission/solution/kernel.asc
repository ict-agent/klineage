#include <torch/extension.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

using namespace AscendC;
namespace {
constexpr int S = 16384;
constexpr int HQ = 32;
constexpr int HK = 8;
constexpr int D = 128;
constexpr int M = 128;
constexpr int AIC_CORES = 24;
constexpr int AIV_CORES = 48;
constexpr float SCALE = 0.08838834764831845f;
using BF = bfloat16_t;
using A = MatmulType<TPosition::GM, CubeFormat::ND, BF>;
using BTrans = MatmulType<TPosition::GM, CubeFormat::ND, BF, true>;
using B = MatmulType<TPosition::GM, CubeFormat::ND, BF>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, float>;
using CS = MatmulType<TPosition::GM, CubeFormat::ND, half>;
using CB = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t>;

__aicore__ inline TCubeTiling Tiling(int n, int k) {
    TCubeTiling t{};
    t.usedCoreNum = 1;
    t.M = t.singleCoreM = M;
    t.N = t.singleCoreN = n;
    t.Ka = t.Kb = t.singleCoreK = k;
    t.baseM = M;
    t.baseN = t.baseK = D;
    t.stepM = t.stepN = t.stepKa = t.stepKb = 1;
    t.depthA1 = t.depthB1 = 2;
    t.batchM = t.batchN = t.singleBatchM = t.singleBatchN = 1;
    return t;
}

constexpr int64_t SC_PLANE = (int64_t)HQ * M * S * (int64_t)sizeof(half);
constexpr int64_t PB_PLANE = (int64_t)HQ * M * S * (int64_t)sizeof(bfloat16_t);
constexpr int64_t RS_PLANE = (int64_t)HQ * M * D * (int64_t)sizeof(bfloat16_t);

aclrtStream gSide[2] = {nullptr, nullptr};
aclrtEvent gEvPack = nullptr;
aclrtEvent gEvSide[2] = {nullptr, nullptr};
bool gEventsOk = false;

// Side streams let one row-block range do Cube work while the other does Vector work.
// If the runtime refuses to create them everything falls back to the caller's stream.
void EnsureSideStreams(aclrtStream main) {
    if (gSide[0] != nullptr) return;
    if (aclrtCreateStream(&gSide[0]) != 0 || gSide[0] == nullptr) gSide[0] = main;
    if (aclrtCreateStream(&gSide[1]) != 0 || gSide[1] == nullptr) gSide[1] = main;
    bool ok = aclrtCreateEvent(&gEvPack) == 0 && gEvPack != nullptr;
    ok = aclrtCreateEvent(&gEvSide[0]) == 0 && gEvSide[0] != nullptr && ok;
    ok = aclrtCreateEvent(&gEvSide[1]) == 0 && gEvSide[1] != nullptr && ok;
    gEventsOk = ok;
}
}

// Convert BSHD inputs to contiguous per-head matrices.
__global__ __aicore__ void pack(GM_ADDR src, GM_ADDR dst, int heads) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    pipe.InitBuffer(buf, M * D * sizeof(BF));
    auto local = buf.Get<BF>();
    GlobalTensor<BF> input, output;
    input.SetGlobalBuffer((__gm__ BF*)src);
    output.SetGlobalBuffer((__gm__ BF*)dst);
    DataCopyParams cp{M, D / 16, static_cast<uint16_t>((heads - 1) * D / 16), 0};
    for (int task = GetBlockIdx(); task < heads * S / M; task += GetBlockNum()) {
        int h = task / (S / M), row = task % (S / M) * M;
        DataCopy(local, input[(row * heads + h) * D], cp);
        PipeBarrier<PIPE_ALL>();
        DataCopy(output[(h * S + row) * D], local, M * D);
        PipeBarrier<PIPE_ALL>();
    }
}

// Separate Cube launches make the data dependencies explicit on the stream.
__global__ __aicore__ void qk(GM_ADDR q, GM_ADDR k, GM_ADDR scores, int row, int n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    auto tiling = Tiling(n, D);
    Matmul<A, BTrans, CS, C> mm;
    mm.Init(&tiling, &pipe);
    GlobalTensor<BF> qg, kg;
    GlobalTensor<half> sg;
    qg.SetGlobalBuffer((__gm__ BF*)q);
    kg.SetGlobalBuffer((__gm__ BF*)k);
    sg.SetGlobalBuffer((__gm__ half*)scores);
    for (int h = GetBlockIdx(); h < HQ; h += GetBlockNum()) {
        mm.SetTensorA(qg[(h * S + row) * D]);
        mm.SetTensorB(kg[(h / (HQ / HK)) * S * D], true);
        mm.IterateAll(sg[h * M * n]);
        mm.End();
    }
}

// Stable row softmax: FP32 max, exp and sum, BF16 probabilities for Cube.
__global__ __aicore__ void softmax(GM_ADDR scores, GM_ADDR probs, int row, int n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> dataBuf, workBuf, resultBuf, sharedBuf;
    pipe.InitBuffer(dataBuf, S * sizeof(float));
    pipe.InitBuffer(workBuf, S * sizeof(float));
    pipe.InitBuffer(resultBuf, 32);
    // half score rows and bf16 probabilities never overlap in time; share one buffer.
    pipe.InitBuffer(sharedBuf, S * sizeof(half));
    auto data = dataBuf.Get<float>();
    auto work = workBuf.Get<float>();
    auto scalar = resultBuf.Get<float>();
    auto hs = sharedBuf.Get<half>();
    auto prob = sharedBuf.Get<BF>();
    GlobalTensor<half> sg;
    GlobalTensor<BF> pg;
    sg.SetGlobalBuffer((__gm__ half*)scores);
    pg.SetGlobalBuffer((__gm__ BF*)probs);
    for (int task = GetBlockIdx(); task < HQ * M; task += GetBlockNum()) {
        int count = row + task % M + 1;
        int padded = (count + 15) / 16 * 16;
        // Only the masked tail needs the -inf sentinel; start on a 64B boundary so the
        // vector fill stays aligned while the copy below still rewrites [0, padded).
        int align = count & ~15;
        if (align < n) Duplicate(data[align], -3.402823466e38f, n - align);
        PipeBarrier<PIPE_ALL>();
        DataCopy(hs, sg[task * n], padded);
        PipeBarrier<PIPE_ALL>();
        Cast(data, hs, RoundMode::CAST_NONE, padded);
        PipeBarrier<PIPE_ALL>();
        for (int j = count; j < padded; ++j) data.SetValue(j, -3.402823466e38f);
        PipeBarrier<PIPE_ALL>();
        Muls(data, data, SCALE, n);
        PipeBarrier<PIPE_V>();
        ReduceMax(scalar, data, work, n);
        PipeBarrier<PIPE_ALL>();
        float max = scalar.GetValue(0);
        Adds(data, data, -max, n);
        PipeBarrier<PIPE_V>();
        Exp(data, data, n);
        PipeBarrier<PIPE_V>();
        ReduceSum(scalar, data, work, n);
        PipeBarrier<PIPE_ALL>();
        float inv = 1.0f / scalar.GetValue(0);
        Muls(data, data, inv, n);
        PipeBarrier<PIPE_V>();
        Cast(prob, data, RoundMode::CAST_RINT, n);
        PipeBarrier<PIPE_ALL>();
        DataCopy(pg[task * n], prob, n);
        PipeBarrier<PIPE_ALL>();
    }
}

__global__ __aicore__ void pv(GM_ADDR probs, GM_ADDR v, GM_ADDR result, int n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    auto tiling = Tiling(D, n);
    Matmul<A, B, CB, C> mm;
    mm.Init(&tiling, &pipe);
    GlobalTensor<BF> pg, vg;
    GlobalTensor<BF> og;
    pg.SetGlobalBuffer((__gm__ BF*)probs);
    vg.SetGlobalBuffer((__gm__ BF*)v);
    og.SetGlobalBuffer((__gm__ BF*)result);
    for (int h = GetBlockIdx(); h < HQ; h += GetBlockNum()) {
        mm.SetTensorA(pg[h * M * n]);
        mm.SetTensorB(vg[(h / (HQ / HK)) * S * D]);
        mm.IterateAll(og[h * M * D]);
        mm.End();
    }
}

__global__ __aicore__ void scatter(GM_ADDR result, GM_ADDR output, int row) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    pipe.InitBuffer(buf, M * D * sizeof(BF));
    auto local = buf.Get<BF>();
    GlobalTensor<BF> ig;
    GlobalTensor<BF> og;
    ig.SetGlobalBuffer((__gm__ BF*)result);
    og.SetGlobalBuffer((__gm__ BF*)output);
    DataCopyParams cp{M, D / 16, 0, (HQ - 1) * D / 16};
    for (int h = GetBlockIdx(); h < HQ; h += GetBlockNum()) {
        DataCopy(local, ig[h * M * D], M * D);
        PipeBarrier<PIPE_ALL>();
        DataCopy(og[(row * HQ + h) * D], local, cp);
        PipeBarrier<PIPE_ALL>();
    }
}

void kernel(const torch::Tensor& q, const torch::Tensor& k,
            const torch::Tensor& v, torch::Tensor& output) {
    const std::vector<int64_t> qs{1, S, HQ, D}, ks{1, S, HK, D};
    TORCH_CHECK(q.sizes().vec() == qs && output.sizes().vec() == qs &&
                k.sizes().vec() == ks && v.sizes().vec() == ks, "Unsupported GQA shape");
    TORCH_CHECK(q.device().type() == c10::DeviceType::PrivateUse1, "NPU input required");
    for (const auto* t : std::initializer_list<const torch::Tensor*>{&q, &k, &v, &output}) {
        TORCH_CHECK(t->device() == q.device() && t->scalar_type() == at::kBFloat16 &&
                    t->is_contiguous(), "Expected contiguous BF16 tensors on the same NPU");
    }
    auto qt = torch::empty({HQ, S, D}, q.options());
    auto kt = torch::empty({HK, S, D}, q.options());
    auto vt = torch::empty({HK, S, D}, q.options());
    // Two independent row-block ranges run on their own streams so Cube and Vector work overlap.
    constexpr int HALVES = 2;
    // FP16 scores and BF16 probabilities are both 2 bytes, so softmax rewrites the score tile
    // in place; one intermediate buffer per stream instead of two.
    auto scores = torch::empty({HALVES, HQ, M, S}, q.options().dtype(at::kHalf));
    auto result = torch::empty({HALVES, HQ, M, D}, q.options());
    auto stream = c10_npu::getCurrentNPUStream(q.get_device()).stream(true);
    pack<<<AIV_CORES, nullptr, stream>>>((uint8_t*)q.data_ptr(), (uint8_t*)qt.data_ptr(), HQ);
    pack<<<AIV_CORES, nullptr, stream>>>((uint8_t*)k.data_ptr(), (uint8_t*)kt.data_ptr(), HK);
    pack<<<AIV_CORES, nullptr, stream>>>((uint8_t*)v.data_ptr(), (uint8_t*)vt.data_ptr(), HK);
    EnsureSideStreams(stream);
    if (gEventsOk) aclrtRecordEvent(gEvPack, stream);
    constexpr int NB = S / M;
    // Row-block cost grows with j, so split at a cumulative-work boundary rather than the midpoint.
    constexpr int STOP[HALVES] = {90, 128};
    for (int side = 0; side < HALVES; ++side) {
        aclrtStream sd = gSide[side];
        if (gEventsOk) aclrtStreamWaitEvent(sd, gEvPack);
        uint8_t* sc = (uint8_t*)scores.data_ptr() + (int64_t)side * SC_PLANE;
        uint8_t* pb = sc;
        uint8_t* rs = (uint8_t*)result.data_ptr() + (int64_t)side * RS_PLANE;
        for (int j = (side == 0 ? 0 : STOP[side - 1]); j < STOP[side]; ++j) {
            int row = j * M;
            int n = row + M;
            qk<<<AIC_CORES, nullptr, sd>>>((uint8_t*)qt.data_ptr(), (uint8_t*)kt.data_ptr(), sc,
                                           row, n);
            softmax<<<AIV_CORES, nullptr, sd>>>(sc, pb, row, n);
            pv<<<AIC_CORES, nullptr, sd>>>(pb, (uint8_t*)vt.data_ptr(), rs, n);
            scatter<<<AIV_CORES, nullptr, sd>>>(rs, (uint8_t*)output.data_ptr(), row);
        }
        if (gEventsOk) aclrtRecordEvent(gEvSide[side], sd);
    }
    if (gEventsOk) {
        for (int side = 0; side < HALVES; ++side) aclrtStreamWaitEvent(stream, gEvSide[side]);
    }
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("kernel", &kernel); }
