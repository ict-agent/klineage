#include <torch/extension.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

using namespace AscendC;
namespace {
constexpr int S = 16384;
constexpr int HQ = 32;
constexpr int HK = 8;
constexpr int D = 128;
constexpr int M = 128;
constexpr int CMAX = 4096;      // max KV columns per chunk
constexpr int NCH = 4;          // max chunks per row block
constexpr int VN = D + 16;      // value columns plus 16 ones for the row sums
constexpr int CORES = 24;
constexpr int VCORES = 48;
constexpr float SCALE = 0.08838834764831845f;
using BF = bfloat16_t;
using A = MatmulType<TPosition::GM, CubeFormat::ND, BF>;
using BTrans = MatmulType<TPosition::GM, CubeFormat::ND, BF, true>;
using B = MatmulType<TPosition::GM, CubeFormat::ND, BF>;
using CS = MatmulType<TPosition::GM, CubeFormat::ND, BF>;
using CO = MatmulType<TPosition::GM, CubeFormat::ND, float>;

// QK chunk tiling: M x len x D.
__aicore__ inline TCubeTiling TilingQK(int n) {
    TCubeTiling t{};
    t.usedCoreNum = 1;
    t.M = t.singleCoreM = M;
    t.N = t.singleCoreN = n;
    t.Ka = t.Kb = t.singleCoreK = D;
    t.baseM = M;
    t.baseN = D;
    t.baseK = D;
    t.stepM = t.stepN = t.stepKa = t.stepKb = 1;
    t.depthA1 = t.depthB1 = 2;
    t.batchM = t.batchN = t.singleBatchM = t.singleBatchN = 1;
    return t;
}

// PV chunk tiling: M x VN x k.
__aicore__ inline TCubeTiling TilingPV(int k) {
    TCubeTiling t{};
    t.usedCoreNum = 1;
    t.M = t.singleCoreM = M;
    t.N = t.singleCoreN = VN;
    t.Ka = t.Kb = t.singleCoreK = k;
    t.baseM = M;
    t.baseN = 48;
    t.baseK = D;
    t.stepM = t.stepN = t.stepKa = t.stepKb = 1;
    t.depthA1 = t.depthB1 = 2;
    t.batchM = t.batchN = t.singleBatchM = t.singleBatchN = 1;
    return t;
}
}

// Convert BSHD inputs to contiguous per-head matrices.
__global__ __aicore__ void pack(GM_ADDR src, GM_ADDR dst, int heads) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    pipe.InitBuffer(buf, M * D * sizeof(BF));
    auto local = buf.Get<BF>();
    GlobalTensor<BF> input, output;
    input.SetGlobalBuffer((__gm__ BF*)src);
    output.SetGlobalBuffer((__gm__ BF*)dst);
    DataCopyParams cp{M, D / 16, static_cast<uint16_t>((heads - 1) * D / 16), 0};
    for (int task = GetBlockIdx(); task < heads * S / M; task += GetBlockNum()) {
        int h = task / (S / M), row = task % (S / M) * M;
        DataCopy(local, input[(row * heads + h) * D], cp);
        PipeBarrier<PIPE_ALL>();
        DataCopy(output[(h * S + row) * D], local, M * D);
        PipeBarrier<PIPE_ALL>();
    }
}

// Value pack: rows of D values followed by 16 ones for the softmax denominator.
__global__ __aicore__ void packv(GM_ADDR src, GM_ADDR dst) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf, oneBuf, bfOneBuf;
    pipe.InitBuffer(buf, M * D * sizeof(BF));
    pipe.InitBuffer(oneBuf, 16 * sizeof(float));
    pipe.InitBuffer(bfOneBuf, 16 * sizeof(BF));
    auto local = buf.Get<BF>();
    auto oneF = oneBuf.Get<float>();
    auto ones = bfOneBuf.Get<BF>();
    Duplicate(oneF, 1.0f, 16);
    PipeBarrier<PIPE_V>();
    Cast(ones, oneF, RoundMode::CAST_RINT, 16);
    PipeBarrier<PIPE_ALL>();
    GlobalTensor<BF> input, output;
    input.SetGlobalBuffer((__gm__ BF*)src);
    output.SetGlobalBuffer((__gm__ BF*)dst);
    DataCopyParams cin{M, D / 16, static_cast<uint16_t>((HK - 1) * D / 16), 0};
    DataCopyParams cdst{M, D / 16, 0, 1};
    DataCopyParams cones{M, 1, 0, 8};
    for (int task = GetBlockIdx(); task < HK * S / M; task += GetBlockNum()) {
        int h = task / (S / M), row = task % (S / M) * M;
        DataCopy(local, input[(row * HK + h) * D], cin);
        PipeBarrier<PIPE_ALL>();
        DataCopy(output[(h * S + row) * VN], local, cdst);
        PipeBarrier<PIPE_ALL>();
        DataCopy(output[(h * S + row) * VN + D], ones, cones);
        PipeBarrier<PIPE_ALL>();
    }
}

// QK for one chunk of KV columns.
__global__ __aicore__ void qkc(GM_ADDR q, GM_ADDR k, GM_ADDR scores, int row, int cstart, int len) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    auto tiling = TilingQK(len);
    Matmul<A, BTrans, CS, CS> mm;
    mm.Init(&tiling, &pipe);
    GlobalTensor<BF> qg, kg, sg;
    qg.SetGlobalBuffer((__gm__ BF*)q);
    kg.SetGlobalBuffer((__gm__ BF*)k);
    sg.SetGlobalBuffer((__gm__ BF*)scores);
    for (int h = GetBlockIdx(); h < HQ; h += GetBlockNum()) {
        mm.SetTensorA(qg[(h * S + row) * D]);
        mm.SetTensorB(kg[(h / (HQ / HK)) * S * D + cstart * D], true);
        mm.IterateAll(sg[h * M * len]);
        mm.End();
    }
}

// Exponentiate one chunk in place of the scores (unnormalised probabilities).
__global__ __aicore__ void smc(GM_ADDR scores, GM_ADDR probs, int row, int cstart, int len) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> dataBuf, bfBuf;
    pipe.InitBuffer(dataBuf, CMAX * sizeof(float));
    pipe.InitBuffer(bfBuf, CMAX * sizeof(BF));
    auto data = dataBuf.Get<float>();
    auto vec = bfBuf.Get<BF>();
    GlobalTensor<BF> sg, pg;
    sg.SetGlobalBuffer((__gm__ BF*)scores);
    pg.SetGlobalBuffer((__gm__ BF*)probs);
    for (int task = GetBlockIdx(); task < HQ * M; task += GetBlockNum()) {
        int valid = row + task % M + 1 - cstart;
        DataCopy(vec, sg[task * len], len);
        PipeBarrier<PIPE_ALL>();
        Cast(data, vec, RoundMode::CAST_NONE, len);
        Muls(data, data, SCALE, len);
        Exp(data, data, len);
        PipeBarrier<PIPE_ALL>();
        if (valid < len) {
            int off = valid > 0 ? valid : 0;
            if (off < len) Duplicate(data[off], 0.0f, len - off);
            PipeBarrier<PIPE_V>();
        }
        Cast(vec, data, RoundMode::CAST_RINT, len);
        PipeBarrier<PIPE_ALL>();
        DataCopy(pg[task * len], vec, len);
        PipeBarrier<PIPE_ALL>();
    }
}

// PV for one chunk; the extra 16 columns accumulate the softmax denominator.
__global__ __aicore__ void pvc(GM_ADDR probs, GM_ADDR v, GM_ADDR out, int cstart, int len) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    auto tiling = TilingPV(len);
    Matmul<A, B, CO, CO> mm;
    mm.Init(&tiling, &pipe);
    GlobalTensor<BF> pg, vg;
    GlobalTensor<float> og;
    pg.SetGlobalBuffer((__gm__ BF*)probs);
    vg.SetGlobalBuffer((__gm__ BF*)v);
    og.SetGlobalBuffer((__gm__ float*)out);
    for (int h = GetBlockIdx(); h < HQ; h += GetBlockNum()) {
        mm.SetTensorA(pg[h * M * len]);
        mm.SetTensorB(vg[(h / (HQ / HK)) * S * VN + cstart * VN]);
        mm.IterateAll(og[h * M * VN]);
        mm.End();
    }
}

// Accumulate the per-chunk partials, normalise and scatter into BSHD output.
__global__ __aicore__ void fin(GM_ADDR obuf, GM_ADDR output, int row, int nch) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> accBuf, tmpBuf, outBuf;
    pipe.InitBuffer(accBuf, VN * sizeof(float));
    pipe.InitBuffer(tmpBuf, VN * sizeof(float));
    pipe.InitBuffer(outBuf, D * sizeof(BF));
    auto acc = accBuf.Get<float>();
    auto tmp = tmpBuf.Get<float>();
    auto ob = outBuf.Get<BF>();
    GlobalTensor<float> ig;
    GlobalTensor<BF> og;
    ig.SetGlobalBuffer((__gm__ float*)obuf);
    og.SetGlobalBuffer((__gm__ BF*)output);
    for (int task = GetBlockIdx(); task < HQ * M; task += GetBlockNum()) {
        int h = task / M, r = task % M;
        DataCopy(acc, ig[task * VN], VN);
        PipeBarrier<PIPE_ALL>();
        for (int c = 1; c < nch; ++c) {
            DataCopy(tmp, ig[(c * HQ * M + task) * VN], VN);
            PipeBarrier<PIPE_ALL>();
            Add(acc, acc, tmp, VN);
            PipeBarrier<PIPE_V>();
        }
        PipeBarrier<PIPE_ALL>();
        float inv = 1.0f / acc.GetValue(D);
        PipeBarrier<PIPE_ALL>();
        Muls(acc, acc, inv, D);
        PipeBarrier<PIPE_V>();
        Cast(ob, acc, RoundMode::CAST_RINT, D);
        PipeBarrier<PIPE_ALL>();
        DataCopy(og[((row + r) * HQ + h) * D], ob, D);
        PipeBarrier<PIPE_ALL>();
    }
}

void kernel(const torch::Tensor& q, const torch::Tensor& k,
            const torch::Tensor& v, torch::Tensor& output) {
    const std::vector<int64_t> qs{1, S, HQ, D}, ks{1, S, HK, D};
    TORCH_CHECK(q.sizes().vec() == qs && output.sizes().vec() == qs &&
                k.sizes().vec() == ks && v.sizes().vec() == ks, "Unsupported GQA shape");
    TORCH_CHECK(q.device().type() == c10::DeviceType::PrivateUse1, "NPU input required");
    for (const auto* t : std::initializer_list<const torch::Tensor*>{&q, &k, &v, &output}) {
        TORCH_CHECK(t->device() == q.device() && t->scalar_type() == at::kBFloat16 &&
                    t->is_contiguous(), "Expected contiguous BF16 tensors on the same NPU");
    }
    auto qt = torch::empty({HQ, S, D}, q.options());
    auto kt = torch::empty({HK, S, D}, q.options());
    auto vt = torch::empty({HK, S, VN}, q.options());
    auto scores = torch::empty({HQ, M, CMAX}, q.options());
    auto probs = torch::empty({HQ, M, CMAX}, q.options());
    auto partial = torch::empty({NCH, HQ, M, VN}, q.options().dtype(at::kFloat));
    auto stream = c10_npu::getCurrentNPUStream(q.get_device()).stream(true);
    pack<<<VCORES, nullptr, stream>>>((uint8_t*)q.data_ptr(), (uint8_t*)qt.data_ptr(), HQ);
    pack<<<VCORES, nullptr, stream>>>((uint8_t*)k.data_ptr(), (uint8_t*)kt.data_ptr(), HK);
    packv<<<VCORES, nullptr, stream>>>((uint8_t*)v.data_ptr(), (uint8_t*)vt.data_ptr());
    for (int row = 0; row < S; row += M) {
        int n = row + M;
        int nch = (n + CMAX - 1) / CMAX;
        for (int c = 0; c < nch; ++c) {
            int cstart = c * CMAX;
            int len = n - cstart < CMAX ? n - cstart : CMAX;
            qkc<<<CORES, nullptr, stream>>>((uint8_t*)qt.data_ptr(), (uint8_t*)kt.data_ptr(),
                                           (uint8_t*)scores.data_ptr(), row, cstart, len);
            smc<<<VCORES, nullptr, stream>>>((uint8_t*)scores.data_ptr(),
                                            (uint8_t*)probs.data_ptr(), row, cstart, len);
            pvc<<<CORES, nullptr, stream>>>((uint8_t*)probs.data_ptr(), (uint8_t*)vt.data_ptr(),
                                           (uint8_t*)partial.data_ptr() + (size_t)c * HQ * M * VN * sizeof(float),
                                           cstart, len);
        }
        fin<<<VCORES, nullptr, stream>>>((uint8_t*)partial.data_ptr(),
                                        (uint8_t*)output.data_ptr(), row, nch);
    }
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("kernel", &kernel); }
